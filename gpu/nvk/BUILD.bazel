# NVK, the Vulkan driver //gpu:bundle ships (libvulkan_nouveau.dylib), and its macOS host twin (the seed and the raw
# pack compile shaders with it): Mesa vendored with ios-on-switch-lmao's commits on top (third_party/mesa, README.ios-on-switch-lmao.md),
# built by Bazel action by action the way meson builds it (third_party/mesa/bazel).
#
#   bazel build //gpu/nvk:ios //gpu/nvk:host     bazel-bin/gpu/nvk/{ios,host}/libvulkan_nouveau.dylib (+ .source)
#
# An edit to one Mesa source recompiles that file and relinks the two dylibs; a generator's input reruns that
# generator only. Toolchains: Xcode's clang (bazel/toolchains/apple) and Rust 1.96.1 (@nvk_rust); the profile
# (//bazel:profile) picks meson's options: debug is the NVK main has always shipped (buildtype=release, b_ndebug,
# no LTO), release adds full LTO.
load("//bazel/lint:defs.bzl", "lint_files")
load(":defs.bzl", "nvk_dylib")

package(default_visibility = ["//visibility:public"])

lint_files()

# The .source files' mesa-tree line: the git tree of Mesa 77452b90 with the series third_party/mesa's commits carry, as
# the meson build named its checkout. Both dylibs come from the one Bazel graph, so they always agree; the line
# only has to be equal in the two (tools/gpu/nvk_twin.py, tools/gpu/seed.py check that).
MESA_TREE = "615cfd2ddf8c8970ee518f7930bad06c16dd1db8"

[nvk_dylib(
    name = name,
    build_id = "//third_party/mesa/src/nouveau/vulkan:nvk_build_id_text",
    dylib = "//third_party/mesa/src/nouveau/vulkan:vulkan_nouveau",
    mesa_tree = MESA_TREE,
    platform = platform,
) for name, platform in (
    ("ios", "ios"),
    ("host", "macos"),
)]

[filegroup(
    name = "{}_{}".format(name, group),
    srcs = [":" + name],
    output_group = group,
) for name in ("ios", "host") for group in ("dylib", "source")]

# What //gpu:bundle takes.
[alias(
    name = name,
    actual = built,
) for name, built in (
    ("dylib", ":ios_dylib"),
    ("dylib_source", ":ios_source"),
    ("twin", ":host_dylib"),
    ("twin_source", ":host_source"),
)]
