# What the seed's actions are keyed on (inputs_test.bzl), over stand-ins: no IPSW, no tools built.
#
#   bazel test //gpu/seed/test:all
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//bazel/lint:defs.bzl", "lint_files")
load("//gpu/seed:crawl.bzl", "QUARTZCORE")
load("//gpu/seed:defs.bzl", "metal_seed", "seed_pipeline_pack", "shader_crawl")
load(":inputs_test.bzl", "seed_inputs_tests")

lint_files()

RAW = [
    "archives.py",
    "draw_context.txt",
    "make_pack.py",
    "directbucket.py",
    "directlink.py",
    "mkpack.py",
    "probelog.py",
    "layouts.py",
    "packfile.py",
    "kernels.py",
    "splits.py",
    "eqcheck.py",
    "fetchfree_link.py",
    "ca/caname.py",
    "ca/caset.py",
    "ca/caspec.py",
    "ca/caspec27.py",
    "ca/closure.py",
    "ca/deepcolour.py",
    "ca/fetchfree.py",
    "ca/qc-21H461.json",
    "rb/rbclosure.py",
    "rb/rbfree.py",
    "rb/rbspec.py",
    "rb/rb-21H461.json",
    "iterated/programs.py",
    "iterated/programs_long.py",
    "iterated/table.py",
    "iterated/ucode.py",
]

# What the generator reads beside its directory (defs.bzl _METAL_LINK's ../runtime/ headers).
METAL_RUNTIME = [
    "owned.h",
    "srgb_table.h",
    "chip_facts.h",
    "own_states.h",
]

# The shader tools' raw/ (gpu/seed/tools.bzl _PACK_TOOLS)
METAL_TOOLS = [
    "directpack",
    "native-seed",
    "libmock_iokit.dylib",
    "own.metallib",
    "context.log",
]

[write_file(
    name = path.replace("/", "_"),
    out = path,
    content = [],
    tags = ["manual"],
) for path in [
    "crawl/tree/" + QUARTZCORE,
    "crawl/tree/data/0.metallib",
    "crawl/tree/root/System/Library/PrivateFrameworks/RenderBox.framework/default.metallib",
    "device/1.metallib",
    "crawl/inventory.json",
    "base/TegraGM20BMetal.bundle/Info.plist",
    "tools/MANIFEST.json",
    "corpus/corpus.log",
    "app/SwitchHWTest.ipa",
] + ["pack/" + name for name in RAW] + [name for name in METAL_RUNTIME] + ["tools/raw/" + name for name in METAL_TOOLS]]

filegroup(
    name = "base",
    srcs = [":base/TegraGM20BMetal.bundle/Info.plist"],
    tags = ["manual"],
)

filegroup(
    name = "tools",
    srcs = [":tools/MANIFEST.json"] + [":tools/raw/" + name for name in METAL_TOOLS],
    tags = ["manual"],
)

filegroup(
    name = "tree",
    srcs = [
        ":crawl/tree/" + QUARTZCORE,
        ":crawl/tree/data/0.metallib",
        ":crawl/tree/root/System/Library/PrivateFrameworks/RenderBox.framework/default.metallib",
    ],
    tags = ["manual"],
)

shader_crawl(
    name = "crawl",
    inventory = ":crawl/inventory.json",
    qc = ":crawl/tree/" + QUARTZCORE,
    tags = ["manual"],
    tree = ":tree",
)

metal_seed(
    name = "seed",
    base = ":base",
    buckets = 4,
    corpus = ":corpus/corpus.log",
    crawl = ":crawl",
    depth = "//gpu/seed:depth",
    tags = ["manual"],
    tools = ":tools",
)

seed_pipeline_pack(
    name = "pack",
    srcs = [":pack/" + name for name in RAW] + [":" + name for name in METAL_RUNTIME],
    corpus = ":corpus/corpus.log",
    crawl = ":crawl",
    device_libraries = ":device/1.metallib",
    generator = ":pack/make_pack.py",
    tags = ["manual"],
    tools = ":tools",
)

shader_crawl(
    name = "crawl_apps",
    applications = [":app/SwitchHWTest.ipa"],
    inventory = ":crawl/inventory.json",
    qc = ":crawl/tree/" + QUARTZCORE,
    tags = ["manual"],
    tree = ":tree",
)

seed_pipeline_pack(
    name = "pack_apps",
    srcs = [":pack/" + name for name in RAW] + [":" + name for name in METAL_RUNTIME],
    corpus = ":corpus/corpus.log",
    crawl = ":crawl_apps",
    device_libraries = ":device/1.metallib",
    generator = ":pack/make_pack.py",
    tags = ["manual"],
    tools = ":tools",
)

seed_inputs_tests(
    name = "inputs_test",
    crawl = ":crawl",
    pack = ":pack",
    pack_apps = ":pack_apps",
    seed = ":seed",
)
