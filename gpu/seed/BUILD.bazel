load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load(":defs.bzl", "metal_seed", "seed_pipeline_pack", "seed_tree", "shader_crawl")
load(":tools.bzl", "seed_tools", "tools_archive")

package(default_visibility = ["//visibility:public"])

lint_files()

GM20B_METAL = "//drivers/TegraGM20BMetal"

label_flag(
    name = "tools",
    build_setting_default = ":default_tools",
)

label_flag(
    name = "base",
    build_setting_default = ":default_base",
)

alias(
    name = "default_tools",
    actual = select({
        "//install:from_release": "@switch_release//:shader_tools",
        "//conditions:default": ":local_tools",
    }),
)

alias(
    name = "default_base",
    actual = select({
        "//install:from_release": "@switch_release//:inputs",
        "//conditions:default": "//gpu:base",
    }),
)

string_flag(
    name = "depth",
    build_setting_default = "deep",
    values = [
        "corpus",
        "wide",
        "deep",
    ],
)

seed_tools(
    name = "local_tools",
    compile = "//third_party/mesa/src/nouveau/switch_compile:host",
    context_header = "//kits/SwitchGM20BEmit:context",
    gm20b_generator = GM20B_METAL + ":pack/make_pack.py",
    gm20b_srcs = [GM20B_METAL + ":stack_key_sources"],
    metal_abi = GM20B_METAL + "/abi:MetalABI.h",
    stack = "//gpu:stack_key",
    translate = "//gpu:translate_host",
)

tools_archive(
    name = "tools_archive",
    tools = ":local_tools",
)

shader_crawl(
    name = "crawl",
    applications = select({
        "//ipsw:ios17": ["//apps/hwtest:SwitchHWTest17"],
        "//ipsw:ios27": [
            "//apps/hwtest:SwitchHWTest27",
            "//apps/hwtest:SwitchHWTest27e",
        ],
    }),
    embedded = [GM20B_METAL + ":plugin/TwoPlaneStandIn.h"],
    inventory = "@ipsw//:crawl_inventory",
    qc = "@ipsw//:crawl_qc",
    tags = ["manual"],
    tree = "@ipsw//:crawl_tree",
)

metal_seed(
    name = "seed",
    base = ":base",
    corpus = GM20B_METAL + ":precompile/corpus.log",
    crawl = ":crawl",
    depth = ":depth",
    device_libraries = "@gpu_device_data//:libraries",
    replies = "@gpu_device_data//:replies",
    tags = ["manual"],
    tools = ":tools",
)

seed_pipeline_pack(
    name = "pack",
    srcs = [GM20B_METAL + ":pack_generator"],
    app_states = [GM20B_METAL + ":app_state_lists"],
    archives = [GM20B_METAL + ":archive_inventories"],
    ca_names = [GM20B_METAL + ":ca_name_lists"],
    ca_selectors = [GM20B_METAL + "/precompile/ca-selectors:tables"],
    corpus = GM20B_METAL + ":precompile/corpus.log",
    crawl = ":crawl",
    device_libraries = "@gpu_device_data//:libraries",
    generator = GM20B_METAL + ":pack/make_pack.py",
    tags = ["manual"],
    tools = ":default_tools",
)

seed_tree(
    name = "tree",
    raw = ":pack",
    seed = ":seed",
    tags = ["manual"],
)

filegroup(
    name = "tree_size",
    srcs = [":tree"],
    output_group = "size",
    tags = ["manual"],
)

# The pack's refused states for the configured IPSW kind, against a pack report built elsewhere (the pack is too
# large to build here): bazel test --config=ios27 //gpu/seed:pack_refusals_test --test_arg=<pack>/report.txt.
# Re-pin from a report: grep -E '^  (refused \(|skipped kernel )' report.txt | sed 's/^  //' | sort
alias(
    name = "pack_pin",
    actual = select({
        "//ipsw:21H461": "pack_refused_21H461.txt",
        "//ipsw:24B119": "pack_refused_24B119.txt",
    }),
)

py_test(
    name = "pack_refusals_test",
    srcs = ["pack_refusals_test.py"],
    args = ["$(rootpath :pack_pin)"],
    data = [":pack_pin"],
    tags = [
        "manual",
        "pack",
    ],
)
