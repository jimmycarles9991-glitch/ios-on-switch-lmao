# metal2vulkan: steelbrain/metal2vulkan (https://github.com/steelbrain/metal2vulkan) at 720ef1ce, GPL-2.0-or-later OR
# LGPL-3.0-or-later (LICENSE*), imported as published less the validation crate's data, then the GPU bundle's patch series
# as one commit each (git log -- third_party/m2v). Its crates build per crate with rules_rust: crates/*/BUILD.bazel.
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/rust:defs.bzl", "THIRD_PARTY_LINT_EXCLUDE")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = THIRD_PARTY_LINT_EXCLUDE)

exports_files([
    # The workspace manifest the crates inherit from: metal2vulkan's source fingerprint hashes it.
    "Cargo.toml",
])

# The profiles are upstream's at 963f0e64, only those the translation tests name. engine_stencil.rs sweeps the directory
# and needs each stencil form: export (lavapipe, moltenvk-m3), interlock only (nvidia-rtx50-linux), neither (the other
# two).
filegroup(
    name = "translation_test_inputs",
    srcs = [
        "crates/metal2vulkan-validation/fixtures/public/engine/grouped_pointer.ll",
        "crates/metal2vulkan-validation/fixtures/public/engine/linked_visible_caller.ll",
        "crates/metal2vulkan-validation/fixtures/public/engine/linked_visible_functions.ll",
        "crates/metal2vulkan-validation/fixtures/public/engine/stage_io.ll",
        "crates/metal2vulkan-validation/fixtures/public/fragment_depth_stencil.ll",
        "crates/metal2vulkan-validation/profiles/lavapipe.json",
        "crates/metal2vulkan-validation/profiles/lunarg-desktop-baseline-2023.json",
        "crates/metal2vulkan-validation/profiles/moltenvk-m3.json",
        "crates/metal2vulkan-validation/profiles/nvidia-rtx50-linux.json",
        "crates/metal2vulkan-validation/profiles/vk12-floor.json",
    ],
)

# The storage form's tests' further inputs, upstream's at 963f0e64 too: the profiles lower/fragment/fetch/tests.rs names
# beside translation_test_inputs' (apart from them, so engine_stencil.rs's sweep stays its four forms), and the engine's
# fragment_fetch fixture.
filegroup(
    name = "fetch_test_inputs",
    srcs = [
        "crates/metal2vulkan-validation/fixtures/public/engine/fragment_fetch.ll",
        "crates/metal2vulkan-validation/profiles/amd-rdna3-radv.json",
        "crates/metal2vulkan-validation/profiles/intel-arl-anv.json",
        "crates/metal2vulkan-validation/profiles/intel-irisxe-anv.json",
        "crates/metal2vulkan-validation/profiles/nvidia-rtx5080-laptop.json",
        "crates/metal2vulkan-validation/profiles/swiftshader.json",
    ],
)
