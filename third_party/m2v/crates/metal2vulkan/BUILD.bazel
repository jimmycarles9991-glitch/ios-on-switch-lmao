[rust_test(
    name = name,
    args = [test_filter],
    compile_data = glob(["tests/**"]),
    crate = ":metal2vulkan",
    data = [
        "//third_party/m2v:translation_test_inputs",
        "@gpu_llvm_as//:bin/llvm-as",
        "@spirv_tools//:spirv-dis",
        "@spirv_tools//:spirv-val",
    ],
    env = {
        "METAL2VULKAN_LLVM_AS": "$(rootpath @gpu_llvm_as//:bin/llvm-as)",
        "METAL2VULKAN_SPIRV_DIS": "$(rootpath @spirv_tools//:spirv-dis)",
        "METAL2VULKAN_SPIRV_VAL": "$(rootpath @spirv_tools//:spirv-val)",
    },
    deps = ["//third_party/m2v/crates/metal2vulkan-devtools"],
) for name, test_filter in [
    ("binary_linking_test", "tests::engine_linking::binary_functions_link_under_their_specialized_names_and_compute_exact_outputs"),
    ("group_linking_test", "tests::engine_linking::groups::"),
]]
