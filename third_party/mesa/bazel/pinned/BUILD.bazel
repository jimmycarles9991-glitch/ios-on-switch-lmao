# What Mesa's own GLSL compiler made for NVK, checked in: this build does not build glslangValidator (glslang).
# inputs.txt names every file it read, by sha256; :inputs_test fails when one of them changes, and then astc_spv.h must
# be regenerated with the real tool.
#
#   astc_spv.h           glslangValidator -V -S comp -x of src/compiler/glsl/astc_decoder.glsl
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

# Generated by Mesa's tools, byte for byte: not ios-on-switch-lmao's to format.
lint_files(exclude = ["astc_spv.h"])

exports_files(["astc_spv.h"])

# Everything inputs.txt names: astc_spv.h's inputs
py_test(
    name = "inputs_test",
    size = "small",
    srcs = ["check_inputs.py"],
    args = [
        "$(rootpath inputs.txt)",
        "third_party/mesa",
        "third_party/mesa",
    ],
    data = [
        "inputs.txt",
        "//third_party/mesa/src/compiler:glsl/astc_decoder.glsl",
    ],
    main = "check_inputs.py",
)
