fs_depth_test_binary(
    name = "turn_test_bin",
    testonly = True,
    archives = [
        ":turn_test_objects",
        "//third_party/mesa/src/compiler/nir:nir",
        "//third_party/mesa/src/compiler:compiler",
        "//third_party/mesa/src/util:mesa_util",
        "//third_party/mesa/src/util:mesa_util_simd",
        "//third_party/mesa/src/c11/impl:mesa_util_c11",
        "//third_party/mesa/src/util/blake3",
    ],
)

mesa_files(
    name = "turn_test_host",
    testonly = True,
    srcs = [":turn_test_bin"],
