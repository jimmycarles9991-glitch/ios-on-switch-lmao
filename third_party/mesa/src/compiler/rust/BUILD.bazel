package(default_visibility = ["//visibility:public"])

lint_files(
    dirs = [],
    exclude = MESA_LINT_EXCLUDE,
)

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

mesa_identity_files()

# Every header of this package, its generated ones included: //third_party/mesa:headers gathers them.
filegroup(
    name = "headers",
    srcs = glob(
