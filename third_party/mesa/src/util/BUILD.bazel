mesa_genrule(
    name = "driconf_static_h",
    srcs = [
        "00-mesa-defaults.conf",
        "//third_party/mesa/src/nouveau/vulkan:00-nvk-defaults.conf",
    ],
    outs = [
        "driconf_static.h",
    ],
    cmd = "$(execpath :driconf_static) $(execpath 00-mesa-defaults.conf) $(execpath //third_party/mesa/src/nouveau/vulkan:00-nvk-defaults.conf) $(execpath driconf_static.h)",
    tools = [
        ":driconf_static",
    ],
)

mesa_genrule(
    name = "format_srgb_c",
    outs = [
        "format_srgb.c",
    ],
    cmd = "$(execpath :format_srgb) > $(execpath format_srgb.c)",
    tools = [
        ":format_srgb",
    ],
)

mesa_genrule(
    name = "shader_stats_h",
    srcs = [
        "shader_stats.rnc",
        "shader_stats.xml",
    ],
    outs = [
        "shader_stats.h",
    ],
    cmd = "$(execpath :process_shader_stats) $(execpath shader_stats.rnc) $(execpath shader_stats.xml) > $(execpath shader_stats.h)",
    tools = [
        ":process_shader_stats",
    ],
)

py_binary(
    name = "driconf_static",
    srcs = [
        "driconf_static.py",
    ],
    imports = ["."],
    main = "driconf_static.py",
    deps = MESA_PY_DEPS,
)

py_binary(
    name = "format_srgb",
    srcs = [
        "format_srgb.py",
    ],
    imports = ["."],
    main = "format_srgb.py",
    deps = MESA_PY_DEPS,
)

py_binary(
    name = "process_shader_stats",
    srcs = [
        "process_shader_stats.py",
    ],
    imports = ["."],
    main = "process_shader_stats.py",
    deps = MESA_PY_DEPS,
)
