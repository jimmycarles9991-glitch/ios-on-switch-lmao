# The Hekate boot entry: what goes to the SD card's FAT (switchroot/ios/*, bootloader/ini/ios.ini,
# bootloader/res/icon_ios_hue.bmp) and the userland overlay the deploy copies to Data (overlay/<absolute path>).
#
#   bazel build //:boot          -> bazel-bin/boot/ios/   (the CMake flow's out/boot/ios)
#
# Boot-args (COMMAND_LINE) live in tools/package/boot_args.py; the ADT edits, USB_HOST and DISPLAY_GAMUT in
# tools/package/adt_edit.py; the steps and what each reads in boot/defs.bzl.
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "bool_setting")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:inputs.bzl", "tool_output")
load(":defs.bzl", "boot_package")
load(":overlay.bzl", "OVERLAY_BINARIES")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# Four cores: adt_edit.py --smp's four-A57 ADT.
SMP = True

bool_flag(
    name = "smp",
    build_setting_default = SMP,
)

# What the release is built with (its CI sets no --//boot:smp), and so what a package composed from it has.
bool_setting(
    name = "release_smp",
    build_setting_default = SMP,
)

# The GPU bundle's trust cache module, appended to the kernel's static trust cache so the plugin and NVK may run.
# --//boot:gpu_trustcache=//boot:no_gpu packages without it (what the CMake flow did when out/gpu was absent).
label_flag(
    name = "gpu_trustcache",
    build_setting_default = ":default_gpu_trustcache",
)

alias(
    name = "default_gpu_trustcache",
    actual = select({
        "//install:from_release": "@switch_release//:gpu_trustcache",
        "//conditions:default": "//gpu:trustcache",
    }),
)

# fetchform is a debug build's, so never in a package composed from the release (release builds).
selects.config_setting_group(
    name = "local_debug",
    match_all = [
        "//bazel:debug",
        "//install:from_local",
    ],
)

filegroup(
    name = "no_gpu",
    srcs = [],
)

# The board ADT (the CMake flow's passes/native-root-memory-v1/full-ram.adt): generated, with its random seed pinned.
tool_output(
    name = "adt",
    outs = ["full-ram.adt"],
    args = [
        "41d4ed8aee6621528a6a355e703603425eef27f7a8df3c8f3cf4460c943df40e4c8b6d7631620a39969418a79e0cb0817cd0d525a13134285ee356ac8871a940",
        "{out}",
    ],
    binary = "//tools/package:adt",
    message = "Generating the native OLED ADT",
    xcode = False,
)

# hekate passes every key to U-Boot's environment too. bootwait=0: no wait on hekate's logo when launched from Nyx.
# scan_dev_for_extlinux: the first boot timing sample (boot/loader/stamps.h). bootcmd_mmc0=true: never scan the eMMC.
write_file(
    name = "ios_ini",
    out = "ios.ini",
    content = [
        "[iOS]",
        "l4t=1",
        "boot_prefixes=/switchroot/ios/",
        "id=iOS",
        "icon=bootloader/res/icon_ios_hue.bmp",
        "logopath=switchroot/ios/bootlogo.bmp",
        "bootwait=0",
        "scan_dev_for_extlinux=setexpr.l ios_uboot *0x60005010",
        "bootcmd_mmc0=true",
        "",
    ],
    newline = "unix",
)

# --//install:prebuilt=release: the GitHub release's kernel (prelinked here), overlay Mach-Os, GPU trust cache, lz4 and
# loader, with the release's --//boot:smp.
boot_package(
    name = "package",
    adt = ":adt",
    app_trust = "//ipsw:app_cryptex_trust_cache",
    bl31 = "//bazel/pinned:firmware/bl31.bin",
    bl33 = "//bazel/pinned:firmware/bl33.bin",
    bootlogo = "//boot/logo:bootlogo.bmp",
    bt_patch = "//bazel/pinned:firmware/BCM4356A3.hcd",
    data_seed = "//bazel/pinned:data-seed/data-v10.dbr",
    dtb = "//bazel/pinned:firmware/oled-sku3.dtb",
    exporter = "//bazel/pinned:firmware/exporter.uimg",
    icon = "//boot/logo:icon_ios_hue.bmp",
    ini = ":ios_ini",
    kernel = select({
        "//install:from_release": "//install:release_kernel",
        "//conditions:default": "//kernel:prelinked",
    }),
    linker_script = ":loader/link.ld",
    loader_hdrs = [
        ":loader/boot_args.h",
        ":handoff/display.h",
        ":handoff/entry.S",
        ":handoff/record.h",
        ":loader/copy.h",
        ":loader/emc.h",
        ":loader/memory.h",
        ":loader/ram.h",
        ":loader/seed.h",
        ":loader/stage.h",
        ":loader/stamps.h",
        ":storage/sd_reference.h",
    ],
    loader_include_markers = [
        ":loader/stage.h",
        ":handoff/record.h",
        ":storage/sd_reference.h",
    ],
    # The cacheable-copy root-boot loader, in link order.
    loader_srcs = [
        ":loader/entry.S",
        ":loader/loader.c",
        ":loader/memory.c",
        ":handoff/probe.c",
        ":loader/copy.c",
        ":loader/copy.S",
        ":loader/emc.c",
        ":loader/seed.c",
        ":loader/boot_args.c",
        ":storage/sd_reference.c",
    ],
    # The sources that include the window's layout.h or runs.h: only these recompile when the kernel changes.
    loader_window_srcs = [
        ":loader/entry.S",
        ":loader/loader.c",
        ":loader/copy.c",
        ":loader/copy.S",
    ],
    lz4 = select({
        "//install:from_release": "@switch_release//:lz4",
        "//conditions:default": "//tools:lz4",
    }),
    # The overlay's Mach-Os (the trust module hashes those the manifest trusts) and its other files, each by the
    # source tree/overlay/manifest.json names it by.
    overlay_binaries = select({
        "//install:from_release": {"@switch_release//:overlay/" + source: source for source in OVERLAY_BINARIES.values()},
        "//conditions:default": OVERLAY_BINARIES,
    }) | select({
        ":local_debug": {"//drivers/TegraGM20BMetal:fetchform": "build/switch-gpu/fetchform"},
        "//conditions:default": {},
    }),
    overlay_data = {
        "//boot/logo:apple-logo~ipad.png": "build/progressui/apple-logo~ipad.png",
        "//bazel/pinned:overlay/wallpaper-1x/7570.iPadOS_17_Flat.plist": "build/wallpaper-1x/7570.iPadOS_17_Flat.plist",
        "//bazel/pinned:overlay/wallpaper-1x/7560.Lake_Flat.plist": "build/wallpaper-1x/7560.Lake_Flat.plist",
    },
    overlay_files = ["//overlay:overlay_sources"],
    overlay_manifest = "//overlay:manifest.json",
    portrait_header = "//drivers/NativeMobileDisplay:SwitchPortrait.h",
    prebuilt_loader = select({
        "//install:from_release": "@switch_release//:loader",
        "//conditions:default": None,
    }),
    prebuilt_loader_constants = select({
        "//install:from_release": "@switch_release//:loader_constants",
        "//conditions:default": None,
    }),
    script_template = ":u-boot-script.txt",
    smp = select({
        "//install:from_release": ":release_smp",
        "//conditions:default": ":smp",
    }),
    static_trust = "//ipsw:static_system_trust",
)

# The loader and the window constants it was compiled for (constants.json: layout.h's and runs.h's), which the release
# ships (//install:release_inputs) though they were made from the IPSW's kernelcache: release/ipsw_free.bzl DECLASSIFIED.
filegroup(
    name = "loader",
    srcs = [":package"],
    output_group = "loader",
)

filegroup(
    name = "loader_constants",
    srcs = [":package"],
    output_group = "constants",
)

# The staged kernel window decodes (lz4 -d, block by block from the table the loader compiles in) to exactly the image
# the layout made: the compression changes the staged bytes, never the kernel the loader copies into place.
filegroup(
    name = "kernel_window",
    srcs = [":package"],
    output_group = "kernel_window",
)

py_test(
    name = "window_decode_test",
    size = "small",
    srcs = ["window_decode_test.py"],
    args = [
        "$(rlocationpath //tools:lz4)",
        "$(rlocationpaths :kernel_window)",
    ],
    data = [
        ":kernel_window",
        "//tools:lz4",
    ],
    deps = ["@rules_python//python/runfiles"],
)

# bazel run //boot:snapshot -- <name>: this build's boot entry and Metal bundle as <state>/lkg/<name> (<state>: ~/Library/
# Application Support/switch-ios, or $SWITCH_HOME), for rollback or to deploy exactly that build later with //deploy:sd
# --boot-package=... --gpu-bundle=....
py_binary(
    name = "snapshot",
    srcs = ["//tools/package:snapshot.py"],
    args = [
        "--boot=$(rlocationpath :package)",
        "--gpu=$(rlocationpath //gpu:bundle)",
        "--gpu-base=$(rlocationpath //gpu:base)",
        "--kernel=$(rlocationpath //:kernel)",
    ],
    data = [
        ":package",
        "//:kernel",
        "//gpu:base",
        "//gpu:bundle",
    ],
    main = "//tools/package:snapshot.py",
    tags = ["manual"],
    deps = ["@rules_python//python/runfiles"],
)

# The RAM metadata exporter (exporter.uimg, pinned in bazel/pinned/firmware and staged in bl33.bin): its builder and its
# Cortex-A57 model run, against the pinned bl33.bin (its host test: //boot/storage/firmware_export/test).
#   bazel run //boot:firmware_export -- --output <dir under out/>
py_binary(
    name = "firmware_export",
    srcs = ["storage/firmware_export/build.py"],
    main = "storage/firmware_export/build.py",
)

py_binary(
    name = "firmware_export_model",
    srcs = [
        "storage/firmware_export/model.py",
        "storage/firmware_export/test_export.py",
    ],
    main = "storage/firmware_export/model.py",
)

filegroup(
    name = "all_sources",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)
