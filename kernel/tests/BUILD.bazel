# switch_ui_scale_page_<tree>.h: vm_unix.c from "static int\nswitch_ui_scale_page(" through its closing brace.
[
    genrule(
        name = "switch_ui_scale_page_" + tree,
        srcs = ["//kernel/xnu-{}/bsd:vm/vm_unix.c".format(version)],
        outs = ["switch_ui_scale_page_{}.h".format(tree)],
        cmd = """awk '
            prev == "static int" && $$0 ~ /^switch_ui_scale_page\\(/ { on = 1; print prev }
            on { print }
            on && $$0 == "}" { done = 1; exit }
            { prev = $$0 }
            END { if (!done) exit 1 }
        ' $< > $@""",
    )
    for tree, version in [
        ("10063", "10063.141.1"),
        ("12377", "12377.121.6"),
    ]
]

host_library(
    name = "ui_scale_page",
    srcs = _UI_SCALE_SITES_HDRS + [
        "switch_ui_scale_page_10063.h",
        "switch_ui_scale_page_12377.h",
        "xnu_ui_scale_page_harness.c",
    ],
    hdrs = ["xnu_ui_scale_page_harness.h"],
    includes = ["."],
)

host_test(
    name = "xnu_ui_scale_page_test",
    srcs = _UI_SCALE_SITES_HDRS + ["xnu_ui_scale_page_test.cpp"],
    includes = ["."],
    deps = [":ui_scale_page"],
)

