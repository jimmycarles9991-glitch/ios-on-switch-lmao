    ("12377_121_6", ""),
    ("10063_141_1", ""),
    ("12377_121_6", "_release"),
]

RELEASE_COPTS = [
    "-UDEVELOPMENT",
    "-DDEVELOPMENT=0",
    "-UDEBUG",
    "-DDEBUG=0",
]

[
    host_library(
        name = "icon_cache_" + xnu + suffix,
        srcs = ["//kernel/switch:boot/icon_cache.c"],
        hdrs = ["switch/icon_cache.h"],
        copts = RELEASE_COPTS if suffix else [],
        defines = ["XNU_%s=1" % xnu] + ([] if suffix else ["DEVELOPMENT=1"]),
        includes = ["."],
    )
    for xnu, suffix in ICON_CACHE_BUILDS
]

