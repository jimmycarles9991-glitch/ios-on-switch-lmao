# decmp_reprioritize_<tree>.h: vm_object.c from "void\nvm_decmp_upl_reprioritize(" through its closing brace.
[
    genrule(
        name = "decmp_reprioritize_" + tree,
        srcs = ["//kernel/xnu-{}/osfmk:vm/vm_object.c".format(version)],
        outs = ["decmp_reprioritize_{}.h".format(tree)],
        cmd = """awk '
            prev == "void" && $$0 ~ /^vm_decmp_upl_reprioritize\\(/ { on = 1; print prev }
            on { print }
            on && $$0 == "}" { done = 1; exit }
            { prev = $$0 }
            END { if (!done) exit 1 }
        ' $< > $@""",
    )
    for tree, version in [
        ("10063", "10063.141.1"),
        ("12377", "12377.121.6"),
    ]
]

