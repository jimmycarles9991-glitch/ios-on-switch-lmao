# --- xnu-12377's filt_wlupdate ------------------------------------------------------------------------------------
# wlupdate.h: kern_event.c's filt_wlupdate and the constants it reads. wl_flags.h: event_private.h's workloop flags,
# without their comments (some run on past the line).
genrule(
    name = "workloop_update",
    srcs = ["//kernel/xnu-12377.121.6/bsd:kern/kern_event.c"],
    outs = ["wlupdate.h"],
    cmd = """awk '
        /^#define (EPREEMPTDISABLED|EWLNOATTACH|EVFILT_WORKLOOP_EFAULT_RETRY_COUNT|FILT_WL(ATTACH|TOUCH|DROP)) / { print; next }
        !on && /^filt_wlupdate\\(struct kqworkloop \\*kqwl, struct knote \\*kn,$$/ { on = 1; print "static int" }
        on { print }
        on && /^}$$/ { done = 1; exit }
        END { if (!done) exit 1 }
    ' $< > $@""",
)

genrule(
    name = "workloop_flags",
    srcs = ["//kernel/xnu-12377.121.6/bsd:sys/event_private.h"],
    outs = ["wl_flags.h"],
    cmd = "grep -E '^#define (NOTE_WL_|EV_EXTIDX_WL_)' $< | sed -E 's@[[:space:]]*/\\*.*@@' > $@",
)

host_library(
    name = "workloop_owner",
    srcs = [
        "wlupdate.h",
        "xnu_workloop_owner_harness.c",
    ],
    hdrs = [
        "wl_flags.h",
        "xnu_workloop_owner_harness.h",
    ],
    includes = ["."],
)

