# Updating an installed card from the Mac (no sudo). See README.md, tools/deploy/deploy.py and pull_logs.py.
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

# The boot package deploy and install write (a directory: switchroot/ios/, bootloader/ini/, overlay/).
label_flag(
    name = "boot_package",
    build_setting_default = "//:boot",
)

# The Metal bundle deploy stages: //gpu:bundle's manifest over the bundle, the seed and the raw pack, or a stage tree
# like //gpu:base or //gpu:stage_tree.
label_flag(
    name = "gpu_bundle",
    build_setting_default = "//gpu:bundle",
    tags = ["manual"],
)

# Opt-in steps of a deploy, --//deploy:logs and --//deploy:harvest: the card's logs (live logs over USB cover the usual
# case), and merging the device's m2v journals into the corpus. --pull-logs/--harvest (and --no-...) on deploy's
# command line override them.
[bool_flag(
    name = name,
    build_setting_default = False,
) for name in ("logs", "harvest")]

[config_setting(
    name = name + "_on",
    flag_values = {":" + name: "true"},
) for name in ("logs", "harvest")]

_OPT_IN = select({
    ":logs_on": ["--pull-logs"],
    "//conditions:default": [],
}) + select({
    ":harvest_on": ["--harvest"],
    "//conditions:default": [],
})

py_binary(
    name = "sd",
    srcs = ["//tools/deploy:deploy.py"],
    args = [
        "--boot-package=$(rlocationpath :boot_package)",
        "--spec=$(rlocationpath //install:spec)",
        "--ipsw=$(rlocationpath //install:ipsw_pins)",
        "--gpu-bundle=$(rlocationpath :gpu_bundle)",
        "--stager=$(rlocationpath //drivers/TegraGM20BMetal:stage-tegra-gm20b-metal.py)",
        "--kcdata=$(rlocationpath @xnu_base//:tools/lldbmacros/kcdata.py)",
        # The checkout's harvest.py (run there, so it merges into the checkout's corpus.log).
        "--harvest-script=$(rootpath //drivers/TegraGM20BMetal:precompile/harvest.py)",
    ] + _OPT_IN + select({
        "//ipsw:ios27": [
            "--pretranslated-trust=$(rlocationpath //ipsw:pretranslated_os_trust)",
            "--pretranslated-updates=$(rlocationpath //install:pretranslated_updates)",
            "--pretranslated-pins=$(rlocationpath //install:pretranslated_pins)",
            "--system-image=$(rlocationpath //install:translated_system_cryptex)",
            "--system-trusted=$(rlocationpath :system_cryptex_trusted/system_cryptex.trustcache)",
            "--system-trusted=$(rlocationpath :system_cryptex_trusted/a64x-cache-pretranslated.bin)",
        ],
        "//conditions:default": [],
    }),
    data = [
        ":boot_package",
        ":gpu_bundle",
        "//install:ipsw_pins",
        "//install:spec",
        "//drivers/TegraGM20BMetal:stage-tegra-gm20b-metal.py",
        "//drivers/TegraGM20BMetal:precompile/harvest.py",
        "@xnu_base//:tools/lldbmacros/kcdata.py",
    ] + select({
        "//ipsw:ios27": [
            ":system_cryptex_trusted/a64x-cache-pretranslated.bin",
            ":system_cryptex_trusted/system_cryptex.trustcache",
            "//install:pretranslated_pins",
            "//install:pretranslated_updates",
            "//install:translated_system_cryptex",
            "//ipsw:pretranslated_os_trust",
        ],
        "//conditions:default": [],
    }),
    main = "//tools/deploy:deploy.py",
    tags = ["manual"],
    deps = [
        "//tools/deploy",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "pull_logs",
    srcs = ["//tools/deploy:pull_logs.py"],
    args = [
        "--spec=$(rlocationpath //install:spec)",
        "--kcdata=$(rlocationpath @xnu_base//:tools/lldbmacros/kcdata.py)",
        "--harvest-script=$(rootpath //drivers/TegraGM20BMetal:precompile/harvest.py)",
    ] + select({
        ":harvest_on": ["--harvest"],
        "//conditions:default": [],
    }),
    data = [
        "//install:spec",
        "//drivers/TegraGM20BMetal:precompile/harvest.py",
        "@xnu_base//:tools/lldbmacros/kcdata.py",
    ],
    main = "//tools/deploy:pull_logs.py",
    deps = [
        "//tools/deploy:lib",
        "@rules_python//python/runfiles",
    ],
)

# The two files of the System cryptex's delta that the boot package pins, on their own, so //deploy:system's runfiles
# carry them and not the whole delta (gigabytes of translated dyld caches).
genrule(
    name = "system_cryptex_trusted",
    srcs = ["//install:delta_system_cryptex"],
    outs = [
        "system_cryptex_trusted/system_cryptex.trustcache",
        "system_cryptex_trusted/a64x-cache-pretranslated.bin",
    ],
    cmd = "for out in $(OUTS); do cp \"$(execpath //install:delta_system_cryptex)/$$(basename $$out)\" $$out; done",
    tags = ["manual"],
)

# iOS 27: this build's translated System cryptex onto an installed card's Preboot, Data untouched
# (tools/deploy/system_update.py). It builds the IPSW's translation (//install:translated_system_cryptex).
py_binary(
    name = "system",
    srcs = ["//tools/deploy:system_update.py"],
    args = [
        "--boot-package=$(rlocationpath :boot_package)",
        "--spec=$(rlocationpath //install:spec)",
        "--ipsw=$(rlocationpath //install:ipsw_pins)",
    ] + select({
        "//ipsw:ios27": [
            "--pretranslated-pins=$(rlocationpath //install:pretranslated_pins)",
            "--image=$(rlocationpath //install:translated_system_cryptex)",
            "--trusted=$(rlocationpath :system_cryptex_trusted/system_cryptex.trustcache)",
            "--trusted=$(rlocationpath :system_cryptex_trusted/a64x-cache-pretranslated.bin)",
        ],
        "//conditions:default": [],
    }),
    data = [
        ":boot_package",
        "//install:ipsw_pins",
        "//install:spec",
    ] + select({
        "//ipsw:ios27": [
            ":system_cryptex_trusted/a64x-cache-pretranslated.bin",
            ":system_cryptex_trusted/system_cryptex.trustcache",
            "//install:pretranslated_pins",
            "//install:translated_system_cryptex",
        ],
        "//conditions:default": [],
    }),
    main = "//tools/deploy:system_update.py",
    tags = ["manual"],
    deps = [
        "//tools/deploy",
        "@rules_python//python/runfiles",
    ],
)
