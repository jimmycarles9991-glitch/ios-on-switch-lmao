# drivers/SwitchAudio's S32 link on the host: SwitchAudioFormat.h's APE and codec register words against Linux's
# formulas for that stream, and the plug-in's float32 <-> S32 conversions (hal/SwitchAudioConvert.h) with NEON, as on
# the device, against the scalar fallback (switch_audio_format_test); the driver and plug-in use them, and the I2S clock
# is 47999.878 Hz on PLLA (switch_audio_source_test).
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

HEADERS = [
    "//drivers/SwitchAudio:SwitchAudioFormat.h",
    "//drivers/SwitchAudio:hal/SwitchAudioConvert.h",
]

C_FLAGS = [
    "-O1",
    "-Wconversion",
    "-Wsign-conversion",
]

# The harness twice: NEON (as on the device), and the scalar fallback the plug-in has without it.
host_library(
    name = "neon_harness",
    srcs = ["switch_audio_format_harness.c"] + HEADERS,
    hdrs = ["switch_audio_format_harness.h"],
    copts = C_FLAGS,
    defines = ["SWITCH_AUDIO_HARNESS_PREFIX=neon_"],
)

host_library(
    name = "scalar_harness",
    srcs = ["switch_audio_format_harness.c"] + HEADERS,
    hdrs = ["switch_audio_format_harness.h"],
    copts = C_FLAGS + ["-U__ARM_NEON"],
    defines = ["SWITCH_AUDIO_HARNESS_PREFIX=scalar_"],
)

host_test(
    name = "switch_audio_format_test",
    srcs = [
        "switch_audio_format_test.cpp",
        "switch_audio_words.h",
    ],
    deps = [
        ":neon_harness",
        ":scalar_harness",
    ],
)

host_test(
    name = "switch_audio_source_test",
    srcs = [
        "switch_audio_source_test.cpp",
        "switch_audio_words.h",
        "//drivers/SwitchAudio:SwitchAudioAbi.h",
        "//drivers/SwitchAudio:SwitchAudioFormat.h",
    ],
    data = [
        "//drivers/SwitchAudio:SwitchAudio.cpp",
        "//drivers/SwitchAudio:SwitchAudioClocks.cpp",
        "//drivers/SwitchAudio:SwitchAudioCodec.cpp",
        "//drivers/SwitchAudio:SwitchAudioDriver.h",
        "//drivers/SwitchAudio:SwitchAudioRegisters.h",
        "//drivers/SwitchAudio:SwitchAudioStream.cpp",
        "//drivers/SwitchAudio:SwitchRT5639.cpp",
        "//drivers/SwitchAudio:hal/SwitchAudioPlugIn.c",
        "//drivers/TegraGPIO:TegraGPIO.cpp",
    ],
    deps = [":neon_harness"],
)

# The overlay's speaker strips per IPSW kind (J120's and J181's AID2003): every box of the kind's speaker chains
# bypassed but the volume.
py_test(
    name = "speaker_strips_test",
    size = "small",
    srcs = ["speaker_strips_test.py"],
    data = [
        "//drivers/SwitchAudio:overlay_files",
        "//overlay:manifest.json",
    ],
    deps = ["@rules_python//python/runfiles"],
)

# The plug-in as the audio server sees it, through its driver interface on the Mac (no kernel service there), once per
# iPad it plays as: the devices, streams and controls each kind's VirtualAudio needs (switch_audio_plugin_test).
PLUGIN_SRCS = [
    "//drivers/SwitchAudio:SwitchAudioAbi.h",
    "//drivers/SwitchAudio:SwitchAudioFormat.h",
    "//drivers/SwitchAudio:hal/SwitchAudioControls.h",
    "//drivers/SwitchAudio:hal/SwitchAudioConvert.h",
    "//drivers/SwitchAudio:hal/SwitchAudioObjects.h",
    "//drivers/SwitchAudio:hal/SwitchAudioPlugIn.c",
    "//kits/SwitchDMA:SwitchDcache.h",
    "//kits/SwitchRefusal:SwitchRefusal.c",
    "//kits/SwitchRefusal:SwitchRefusal.h",
]

PLUGIN_COPTS = [
    "-Idrivers/SwitchAudio",
    "-Wno-four-char-constants",
]

PLUGIN_LINKOPTS = [
    "-framework",
    "CoreFoundation",
    "-framework",
    "IOKit",
]

host_library(
    name = "plugin_j120",
    srcs = PLUGIN_SRCS,
    copts = PLUGIN_COPTS,
)

host_library(
    name = "plugin_j181",
    srcs = PLUGIN_SRCS + ["//drivers/SwitchAudio:hal/SwitchAudioControls.c"],
    copts = PLUGIN_COPTS,
    defines = ["SWITCH_AUDIO_J181=1"],
)

host_test(
    name = "switch_audio_plugin_j120_test",
    srcs = ["switch_audio_plugin_test.cpp"],
    linkopts = PLUGIN_LINKOPTS,
    deps = [":plugin_j120"],
)

host_test(
    name = "switch_audio_plugin_j181_test",
    srcs = ["switch_audio_plugin_test.cpp"],
    defines = ["SWITCH_AUDIO_J181=1"],
    linkopts = PLUGIN_LINKOPTS,
    deps = [":plugin_j181"],
)
