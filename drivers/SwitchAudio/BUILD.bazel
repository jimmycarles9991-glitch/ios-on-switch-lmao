load("//bazel/lint:defs.bzl", "lint_files")

# drivers/SwitchAudio: moved from out/native-a57/root-v1/tree/drivers/SwitchAudio by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kernel/rules:package.bzl", "ios_binary")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# SwitchAudio: kernel service + Tegra I2S1/ADMA backend, and the RT5639 codec (SwitchRT5639).
kernel_driver(
    name = "SwitchAudio",
    srcs = [
        "SwitchAudio.cpp",
        "SwitchAudioClocks.cpp",
        "SwitchAudioCodec.cpp",
        "SwitchAudioStream.cpp",
        "SwitchRT5639.cpp",
    ],
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/TegraGPIO",
        "drivers/TegraI2C",
        "kits/SwitchCAR",
        "kits/SwitchDMA",
        "kits/SwitchMMIO",
        "kits/SwitchRefusal",
    ],
)

# SwitchAudio HAL plug-in (AudioServerPlugIn; the iOS SDK lacks its headers, so the macOS CoreAudio ones, which declare
# the same interface, come first on the include path).
ios_binary(
    name = "SwitchAudioHAL",
    srcs = [
        "hal/SwitchAudioPlugIn.c",
        "//kits/SwitchRefusal:SwitchRefusal.c",
    ] + select({
        "//ipsw:24B119": ["hal/SwitchAudioControls.c"],
        "//conditions:default": [],
    }),
    out = "build/switch-audio/SwitchAudio.driver/SwitchAudio",
    hdrs = [
        "SwitchAudioAbi.h",
        "SwitchAudioFormat.h",
        "hal/SwitchAudioControls.h",
        "hal/SwitchAudioConvert.h",
        "hal/SwitchAudioObjects.h",
        "//kits/SwitchDMA:SwitchDcache.h",
        "//kits/SwitchRefusal:SwitchRefusal.h",
    ],
    copts = [
        "-I",
        "{tree}",
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-bundle",
        "-fvisibility=hidden",
        "-framework",
        "CoreFoundation",
        "-framework",
        "IOKit",
    ] + select({
        # The devices as the IPSW's iPad has them: J120's for 21H461, J181's for 24B119 (hal/SwitchAudioPlugIn.c).
        "//ipsw:24B119": ["-DSWITCH_AUDIO_J181=1"],
        "//conditions:default": [],
    }),
    coreaudio_headers = True,
    pagesize = "4096",
    sign_identifier = "com.brunostjohn.switch.audio",
)

# The overlay files of this driver that overlay/manifest.json names.
filegroup(
    name = "overlay_files",
    srcs = glob([
        "hal/*.plist",
        "tunings/**/*.austrip",
    ]),
)
