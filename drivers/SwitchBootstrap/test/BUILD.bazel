write_file(
    name = "configuration",
    out = "build_configuration.h",
    content = [
        '#define SWITCH_BOOTSTRAP_BUILD "TEST1"',
        '#define SWITCH_BOOTSTRAP_FIRMWARE "17.7.11"',
        '#define SWITCH_BOOTSTRAP_ROOT "/unused/root"',
        '#define SWITCH_BOOTSTRAP_BASE "/unused"',
        '#define SWITCH_BOOTSTRAP_HELPER "/unused/switch-bootstrap"',
    ],
)

genrule(
    name = "hash",
    srcs = ["core_manifest.json"],
    outs = ["payload_hash.h"],
    cmd = "$(execpath //drivers/SwitchBootstrap:configuration) --manifest $(execpath :core_manifest.json) --out $@",
    tools = ["//drivers/SwitchBootstrap:configuration"],
)

