load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

exports_files(
    ["core_manifest.json"],
    visibility = ["//drivers/SwitchBootstrap:__pkg__"],
)

copy_file(
    name = "daemon_jobs_source",
    src = "daemon_jobs_test.mm",
    out = "daemon_jobs_test.cpp",
)

host_test(
    name = "daemon_jobs_test",
    srcs = [
        ":daemon_jobs_source",
        "//bootstrap/launchctl:daemon_result.h",
        "//drivers/SwitchBootstrap:daemon_jobs.h",
        "//drivers/SwitchBootstrap:process.h",
        "//drivers/SwitchBootstrap:state.h",
    ],
    additional_compiler_inputs = ["//drivers/SwitchBootstrap:daemon_jobs.mm"],
    copts = [
        "-x",
        "objective-c++",
        "-fobjc-arc",
        "-UNDEBUG",
        "-I.",
        "-Wno-deprecated-declarations",
    ],
    gtest_main = False,
    linkopts = [
        "-framework",
        "Foundation",
    ],
)

host_test(
    name = "process_test",
    srcs = [
        "process_test.cpp",
        "//drivers/SwitchBootstrap:process.h",
