# Hardware video encode (drivers/SwitchVideoEncoders over drivers/TegraNVENC) on the host:
#   ave_host_test  AVE (H264H7.videoencoder) itself on this Mac's VideoToolbox over a fake TegraNVENC client whose
#                  engine is a lossless stand-in for NVENC: every submit accepted by the kernel's own checker
#                  (TegraNVENCCheck.h), the encode check (EncodeCheck.c, the one the Switch runs once per boot) decoding
#                  every frame back exactly with Apple's decoder in three input layouts, sync samples where they
#                  belong, P_Skip from the reference the setup names; the SPS/PPS/avcC parsing back with AVD's
#                  H264Syntax.c; the checker refusing each kind of bad submit; the rate control on a synthetic encoder
#   h264nvenc_host_test  H264NVENC.c's surfaces at the coded size where it is not the display size (1080p), the
#                  kernel's checker taking those submits and refusing the display size
#   hevcnvenc_host_test  HEVCNVENC.c's H.265 IDR setups byte for byte against NVIDIA's T210 driver's (three sizes),
#                  the kernel's H.265 checker taking them and refusing each kind of bad submit, the SPS/PPS stating
#                  the coding tools the setup does
#   hevcenc_host_test  HEVCEncSyntax.c's VPS, SPS, PPS and slice headers parsed back by AVD's HEVCSyntax.c and taken by
#                  CoreMedia, the level each size and rate gets
#
#   bazel test //drivers/SwitchVideoEncoders/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

FRAMEWORKS = [
    "-framework",
    "CoreFoundation",
    "-framework",
    "CoreMedia",
    "-framework",
    "CoreVideo",
    "-framework",
    "VideoToolbox",
]

# The plug-in's H.264 bitstream and NVENC setup code, and AVD's H.264 syntax (the SPS/PPS/avcC parse-back).
host_library(
    name = "h264_nvenc",
    srcs = [
        "//drivers/SwitchVideoDecoders:AVD/H264Syntax.c",
        "//drivers/SwitchVideoEncoders:AVE/H264NVENC.c",
        "//drivers/TegraNVENC:nvidia/clc5b7.h",
        "//drivers/TegraNVENC:nvidia/nvenc_drv.h",
    ],
    hdrs = [
        "//drivers/SwitchVideoDecoders:AVD/H264Syntax.h",
        "//drivers/SwitchVideoEncoders:AVE/H264NVENC.h",
        "//drivers/TegraNVENC:TegraNVENCABI.h",
        "//drivers/TegraNVENC:TegraNVENCCheck.h",
        "//drivers/TegraNVENC:TegraNVENCCheckCommon.h",
        "//drivers/TegraNVENC:TegraNVENCCheckH265.h",
    ],
    copts = ["-O1"],
)

# ave_host.c includes AVEEncoder.c itself (for its factory); its main() renamed so the test calls it.
host_library(
    name = "ave_host",
    srcs = [
        "ave_host.c",
        "EncodeCheck.c",
        "EncodeCheck.h",
        "//drivers/SwitchVideoEncoders:AVE/NVENCClient.h",
        "//drivers/SwitchVideoEncoders:AVE/RateControl.h",
        "//drivers/SwitchVideoEncoders:AVE/VTEncoderSPI.h",
        "//drivers/SwitchVideoDecoders:AVD/VTDecoderSPI.h",
        "//kits/SwitchRefusal:SwitchRefusal.c",
        "//kits/SwitchRefusal:SwitchRefusal.h",
    ],
    copts = ["-O1"],
    defines = ["main=ave_host_main"],
    linkopts = FRAMEWORKS,
    textual_hdrs = ["//drivers/SwitchVideoEncoders:AVE/AVEEncoder.c"],
    deps = [":h264_nvenc"],
)

# H264NVENC.c's setups at sizes that are not whole macroblocks, against the kernel's checker.
host_library(
    name = "h264nvenc_host",
    srcs = ["h264nvenc_host.c"],
    copts = ["-O1"],
    defines = ["main=h264nvenc_host_main"],
    deps = [":h264_nvenc"],
)

# The HEVC parameter set and slice header writer, parsed back with AVD's HEVC syntax.
host_library(
    name = "hevcenc_host",
    srcs = [
        "hevcenc_host.c",
        "//drivers/SwitchVideoDecoders:AVD/HEVCSyntax.c",
        "//drivers/SwitchVideoEncoders:AVE/HEVCEncSyntax.c",
    ],
    hdrs = [
        "//drivers/SwitchVideoDecoders:AVD/HEVCSyntax.h",
        "//drivers/SwitchVideoEncoders:AVE/HEVCEncSyntax.h",
    ],
    copts = ["-O1"],
    defines = ["main=hevcenc_host_main"],
    linkopts = FRAMEWORKS,
    deps = [":h264_nvenc"],
)

# HEVCNVENC.c's IDR setups against NVIDIA's T210 driver's, the kernel's H.265 checker, and the parameter sets agreeing
# with the setup.
host_library(
    name = "hevcnvenc_host",
    srcs = [
        "hevcnvenc_host.c",
        "//drivers/SwitchVideoDecoders:AVD/HEVCSyntax.c",
        "//drivers/SwitchVideoEncoders:AVE/HEVCEncSyntax.c",
        "//drivers/SwitchVideoEncoders:AVE/HEVCNVENC.c",
    ],
    hdrs = [
        "//drivers/SwitchVideoDecoders:AVD/HEVCSyntax.h",
        "//drivers/SwitchVideoEncoders:AVE/HEVCEncSyntax.h",
        "//drivers/SwitchVideoEncoders:AVE/HEVCNVENC.h",
    ],
    copts = ["-O1"],
    defines = ["main=hevcnvenc_host_main"],
    deps = [":h264_nvenc"],
)

host_test(
    name = "h264nvenc_host_test",
    srcs = ["h264nvenc_host_test.cpp"],
    deps = [":h264nvenc_host"],
)

host_test(
    name = "hevcnvenc_host_test",
    srcs = ["hevcnvenc_host_test.cpp"],
    deps = [":hevcnvenc_host"],
)

host_test(
    name = "hevcenc_host_test",
    srcs = ["hevcenc_host_test.cpp"],
    deps = [":hevcenc_host"],
)

host_test(
    name = "ave_host_test",
    srcs = ["ave_host_test.cpp"],
    deps = [":ave_host"],
)
