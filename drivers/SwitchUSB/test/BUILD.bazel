# drivers/SwitchUSB on the host: the XUDC's device-mode transfer planner and OUT residue protocol (XudcTransfer.h,
# xudc_transfer_test), its completion accounting against a model controller (XudcTransfer.h TdRing,
# xudc_completion_test), isochronous endpoints (XudcIsoch.h, xudc_isoch_test), host mode's power and data roles and register arithmetic (SwitchPDPolicy.h, XusbPorts.h,
# switch_usb_host_test), and SuperSpeed's lane and root port (XusbLanes.h, switch_usb_lanes_test).
#
#   bazel test //drivers/SwitchUSB/test:all
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

# --- Device mode: the XUDC transfer planner ---
# XudcTransfer.h's planner over 3000 random scatter-gather layouts and its OUT residue protocol against model
# controllers of both residue kinds, plus the cost model; only the header, so a SwitchXUDC.cpp edit does not rerun it.
host_test(
    name = "xudc_transfer_test",
    srcs = [
        "xudc_transfer_test.cpp",
        "//drivers/SwitchUSB:XudcTransfer.h",
    ],
    copts = ["-O1"],
)

# XudcTransfer.h's completion accounting (TdRing) against a model XUDC: short packets with one or two events, multi-TRB
# TDs, ring wrap, cancels and their stale events, long usbmux-like sessions with no request lost, an event ring
# overflow never silent, and a matching that fails earlier requests losing reads on the same model.
host_test(
    name = "xudc_completion_test",
    srcs = [
        "xudc_completion_test.cpp",
        "//drivers/SwitchUSB:XudcTransfer.h",
    ],
    copts = ["-O1"],
)

# XudcIsoch.h: the family's frame list layout, service intervals and stamps, one TRB per frame (direct or one bounce
# page), and the isochronous ring's accounting against a model controller: last-frame and short-frame events, missed
# frames, later events settling earlier requests, starved rings, cancels, a long stream around the ring.
host_test(
    name = "xudc_isoch_test",
    srcs = [
        "xudc_isoch_test.cpp",
        "//drivers/SwitchUSB:XudcIsoch.h",
        "//drivers/SwitchUSB:XudcTransfer.h",
    ],
    copts = ["-O1"],
)

# SwitchDMADirect.h (//drivers/SwitchUSB:xudc_direct) against SwitchXUDC.cpp admit()'s prepare() path: identical runs
# and TRBs, cache lines and copied bytes over random kernel-virtual layouts; what it refuses goes through prepare().
host_test(
    name = "switch_dma_direct_test",
    srcs = [
        "switch_dma_direct_test.cpp",
        "//drivers/SwitchUSB:SwitchDMADirect.h",
        "//drivers/SwitchUSB:XudcTransfer.h",
    ],
    copts = ["-O1"],
)

# What xudc_transfer_test cannot see in the driver itself.
host_test(
    name = "switch_xudc_source_test",
    srcs = ["switch_xudc_source_test.cpp"],
    data = [
        "//drivers/SwitchUSB:SwitchXUDC.cpp",
        "//drivers/SwitchUSB:XudcHardware.cpp",
        "//drivers/SwitchUSB:XudcRequestMemory.h",
    ],
)

# --- Host mode: the power role and the xHCI port arithmetic ---
# SwitchPDPolicy.h's power-role decisions under a model of SwitchPD.cpp's apply/enter (r7w's BM92T36 traces, a fuzzed
# walk) and XusbPorts.h's host-role register arithmetic and interrupt check, both headers compiled as C11 with
# -Wconversion -Wsign-conversion in switch_usb_host_harness.c.
host_library(
    name = "switch_usb_host_harness",
    srcs = ["switch_usb_host_harness.c"],
    hdrs = [
        "switch_usb_host_harness.h",
        "//drivers/SwitchUSB:SwitchPDPolicy.h",
        "//drivers/SwitchUSB:XusbPorts.h",
    ],
    copts = [
        "-O1",
        "-Wconversion",
        "-Wsign-conversion",
    ],
)

host_test(
    name = "switch_usb_host_test",
    srcs = ["switch_usb_host_test.cpp"],
    deps = [":switch_usb_host_harness"],
)

# What the headers cannot show: the interrupt routing (DT SPI 39/40 level-high, the LIC, IPFS as tegra_xusb_config,
# checkFired's one panic), that the kernel files use the tested headers in the order the model assumes, and the
# SuperSpeed lane's handshake with PCIe's UPHY PLL calibration.
host_test(
    name = "switch_usb_host_source_test",
    srcs = ["switch_usb_host_source_test.cpp"],
    data = [
        "//drivers/ArmGIC:ArmGIC.cpp",
        "//drivers/SwitchUSB:SwitchPD.cpp",
        "//drivers/SwitchUSB:SwitchUSB.cpp",
        "//drivers/SwitchUSB:SwitchXHCI.cpp",
        "//drivers/SwitchUSB:SwitchXHCIEvents.cpp",
        "//drivers/SwitchUSB:SwitchXHCIServices.cpp",
        "//drivers/SwitchUSB:UsbSmmuMapper.cpp",
        "//drivers/SwitchUSB:XusbHost.cpp",
        "//drivers/SwitchUSB:XusbHost.h",
        "//drivers/SwitchUSB:XusbSuperSpeed.cpp",
        "//drivers/SwitchWLAN:TegraPCIe.cpp",
    ],
)

# --- SuperSpeed: SS port 0's lane and root port, the falcon's SuperSpeed messages, SwitchXHCI's write adjustments ---
# XusbLanes.h compiled as C11 with -Wconversion -Wsign-conversion, and its decisions: the lane across DisplayPort alt
# mode's pin assignments, the role and PCIe's PLL calibrations, the root port across sessions and SC7, the register
# writes against the Linux sequences (never a bit of USB2 pad 0 or another lane), LFPS, DFE/CTLE and RESET_SSPI
# messages, the SMMU state the host accepts, U1/U2 off and the moderation floor.
host_library(
    name = "switch_usb_lanes_c",
    srcs = ["switch_usb_lanes_c.c"],
    hdrs = ["//drivers/SwitchUSB:XusbLanes.h"],
    copts = [
        "-O1",
        "-Wconversion",
        "-Wsign-conversion",
    ],
)

host_test(
    name = "switch_usb_lanes_test",
    srcs = [
        "switch_usb_lanes_test.cpp",
        "//drivers/SwitchUSB:XusbLanes.h",
        "//drivers/SwitchUSB:XusbPorts.h",
    ],
    deps = [":switch_usb_lanes_c"],
)

# XusbSleepwalk.h (XusbSleepwalk.cpp): pad 0's PMC sleepwalk values for a USB device's remote wake across SC7.
host_test(
    name = "xusb_sleepwalk_test",
    srcs = [
        "xusb_sleepwalk_test.cpp",
        "//drivers/SwitchUSB:XusbSleepwalk.h",
    ],
    copts = ["-O1"],
)

# UsbIova.h (UsbSmmuMapper.cpp): the XUSB host's SMMU window and the page layout of a scattered buffer at one IOVA range.
host_test(
    name = "usb_iova_test",
    srcs = [
        "usb_iova_test.cpp",
        "//drivers/SwitchUSB:UsbIova.h",
    ],
    copts = ["-O1"],
)

# The selected kind's prelink report: every host-side USB class kext prelinked, and on iOS 27 no new unnamed import.
py_test(
    name = "usb_prelink_test",
    srcs = ["usb_prelink_test.py"],
    data = ["//kernel:prelink_report"],
    deps = ["@rules_python//python/runfiles"],
)
