        "textures.cpp",
        "texture_chains.cpp",
        "texture_headers.cpp",
        "private_comp.cpp",
        "record_parts.cpp",
        "draw_bands.cpp",
        "job_uses.cpp",
        "mip_passes.cpp",
        "resolve_twod.cpp",
        "tessellation.cpp",
        "transfer.cpp",
        "kernel.cpp",
        "kernel_job.cpp",
        "resource_set.cpp",
        "encoder_state.cpp",
        "state_segment.cpp",
        "shared_events.cpp",
        "pack.cpp",
        "split.cpp",
        "variants.cpp",
        "vertex_streams.cpp",
        "zeta.cpp",
        "harness/fetchform.cpp",
    ] + ["//kits/SwitchGM20BEmit:" + s for s in EMIT_SOURCES],
    out = "build/switch-gpu/fetchform",
    hdrs = [
        ":gm20b_runtime_headers",
        "//drivers/TegraGM20B:TegraGM20BABI.h",
        "//drivers/TegraGM20B:TegraGM20BClockABI.h",
        "//drivers/TegraGM20B:TegraGM20BFencePageABI.h",
        "//drivers/TegraGM20B:TegraGM20BHost.h",
        "//drivers/TegraGM20B:TegraGM20BJobABI.h",
