# The pack generator (pack/make_pack.py and the modules it imports); //tools/gpu:make_pack runs it.
py_library(
    name = "pack",
    srcs = glob(
        [
            "pack/*.py",
            "pack/ca/*.py",
            "pack/iterated/*.py",
            "pack/rb/*.py",
        ],
        exclude = [
            "pack/ca/*_test.py",
            "pack/iterated/*_test.py",
            "pack/rb/*_test.py",
        ],
    ),
    data = [
        "pack/ca/qc-21H461.json",
        "pack/ca/qc-24B119.json",
        "pack/rb/rb-21H461.json",
        "pack/rb/rb-24B119.json",
        "srgb_table.h",  # pack/layouts.py reads it at import
        "own_states.h",  # pack/packfile.py reads it at import
    ],
)

