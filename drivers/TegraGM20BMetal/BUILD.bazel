    copts = [
        "-O2",
        "-std=c++17",
        "-DSWITCH_METAL_HARNESS_MARKS",
        "-Wall",
        "-Wextra",
        "-I",
        "drivers/TegraGM20B",
        "-I",
        "kits/SwitchGM20BEmit/mesa",
