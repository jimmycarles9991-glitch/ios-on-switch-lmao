# The TegraGM20B Metal plugin's sources and the precompile/stage tools (m2v and our changes to it: third_party/m2v). The bundle itself is
# built by //gpu:bundle (gpu/BUILD.bazel); the device-side tools here are what //deploy:* runs.
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:package.bzl", "ios_binary")
load("//kits/SwitchGM20BEmit:defs.bzl", "EMIT_SOURCES")

package(default_visibility = ["//visibility:public"])

# pack/mesa is Mesa's code, kept as upstream has it; srgb_knots.h is m2v's SRGB_KNOTS table and srgb_encode.h its
# inverse (ycbcr_converted_store_test holds it to the rule), generated; xr_srgb_decode.h and xr_srgb_encode.h are m2v's
# BGR10_XR_sRGB tables (metal/format/extended_srgb.rs), copied. plugin/TwoPlaneStandIn.h is generated (TwoPlaneStandIn.sh
# from TwoPlaneStandIn.metal). fill_texel_tables.h is the fill codes an Apple M4 wrote, as measured.
lint_files(exclude = [
    "fill_texel_tables.h",
    "plugin/TwoPlaneStandIn.h",
    "pack/mesa/**",
    "pack/srgb_encode.h",
    "pack/srgb_knots.h",
    "pack/xr_srgb_decode.h",
    "pack/xr_srgb_encode.h",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# The driver: its runtime (compiled into the plugin), its pack generator, and the sources its stack key hashes
# (stack_key_sources).
filegroup(
    name = "gm20b_runtime_headers",
    srcs = glob([
        "*.h",
        "fx/*.h",
    ]) + [
        "translate/NativeMetalTranslate.h",
        "pack/probe_bind.h",  # the probe's bind offsets, which name a record's residual words (record.h)
        "pack/srgb_encode.h",  # the sRGB YCbCr store states' table, the device's copy of it (Device::srgbEncode_)
        "pack/xr_srgb_decode.h",  # BGR10_XR_sRGB's tables, which xr_srgb.h's model reads
        "pack/xr_srgb_encode.h",
        "//drivers/TegraGM20BMetal/abi:MetalABI.h",
        "//drivers/TegraGM20BMetal/precompile/ca-selectors:ca_selector_layout.h",
    ],
)

# The plugin's own headers, which the plugin's units, the compiler daemon's and the runtime's include by name
filegroup(
    name = "plugin_headers",
    srcs = glob(["plugin/*.h"]),
)

# The driver's translation crate's Rust (//gpu:translate), which the stack key hashes by bytes
filegroup(
    name = "translate_rust",
    srcs = glob(["translate/*.rs"]),
)

# The facade's Objective-C++ units (TegraGM20BMetal.mm and the TegraGM20BMetal*.mm beside it, GM20BAlias.mm, TegraGM20BMetalComplete.mm, TegraGM20BMetalDirect.mm)
filegroup(
    name = "facade_srcs",
    srcs = glob(
        ["TegraGM20BMetal*.mm"],
        exclude = ["TegraGM20BMetalPlugin.mm"],
    ) + ["SwitchSharedEvent.mm"],
)

# Not a hand run's leftovers: a .pyc of the modules (the host Python's) in a checkout would change the pack's action key
# there and nowhere else, so that checkout's pack never hits the disk cache another checkout filled, and the other way round.
filegroup(
    name = "pack_generator",
    srcs = glob(
        ["pack/**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/.DS_Store",
        ],
    ) + [
        "owned.h",  # the methods the driver owns (pack/mkpack.py reads them)
        "//kits/SwitchGM20B:class_headers",  # pack/nvdec.cpp's method numbers
        "srgb_table.h",  # the colour table pack/layouts.py recognises
        "chip_facts.h",  # the chip facts pack/packfile.py writes into a pack's header
        "own_states.h",
        # a kernel's key (pack/kernel_shapes.h)
        "compute_key.h",
        "metallib.cpp",
        "metallib.h",
        "pack.h",
        "pack_selectors.h",
        "set_entries.h",
        "TegraGM20BMetalPipelineKey.h",  # the runtime's key of a state, which probe_states.h files records under
        "pipeline_fields.h",  # the descriptor fields that key reads
    ],
)

# The runtime's sources the pack generator's directpack.mm and native_seed.mm make records with (pack/make_pack.py
# DIRECT_RUNTIME), as the plugin makes its own
filegroup(
    name = "direct_sources",
    srcs = [
        "precompile/PrecompileInputs.h",
        "TegraGM20BMetalDirect.h",
        "TegraGM20BMetalDirect.mm",
        "TegraGM20BMetalOffline.h",
        "TegraGM20BMetalOffline.mm",
        "TegraGM20BMetalOfflineReflection.mm",
        "TegraGM20BMetalRenderKey.h",
        "TegraGM20BMetalRenderKey.mm",
        "TegraGM20BMetalPipelineKey.h",
        "pipeline_fields.h",
        "render_key.h",
        "gm20b_cache.cpp",
        "gm20b_cache.h",
        "cache_io.h",
        "cbuf.h",
        "kernel_cache.cpp",
        "compute_key.h",
        "compute_record.h",
        "chip_facts.h",
        "own_states.h",
        "cubic.h",
        "descriptors.h",
        "direct.cpp",
        "direct.h",
        "direct_abi.h",
        "translate/NativeMetalTranslate.h",
        "direct_compute.cpp",
        "direct_compute.h",
        "direct_encode.h",
        "direct_heap.h",
        "direct_nvk.h",
        "direct_push.h",
        "kernel_pairs.h",
        "dynamic_push.h",
        "spill_table.h",
        "direct_storage.h",
        "storage.h",
        "split_metadata.h",
        "emit.cpp",
        "emit.h",
        "metallib.cpp",
        "metallib.h",
        "nak_target.h",
        "owned.h",
        "program_pages.h",
        "sample_shading.h",
        "pack.cpp",
        "pack.h",
        "pack_selectors.h",
        "push.h",
        "record.h",
        "record_parts.cpp",
        "record_parts.h",
        "residual.h",
        "rotation.h",
        "selector_variants.h",
        "set_entries.h",
        "set_layout.h",
        "slot_mask.h",
        "stage_textures.h",
        "set_reads.h",
        "written_textures.h",
        "xr.h",
        "xr_pass.h",
        "zeta.h",  # the formats directpack.mm's test classes reach
    ],
)

# The pack generator but ca/, which only picks the states the pack makes and writes each as a corpus line: a line names
# its state's key and everything its record is made from, so no ca/ edit changes the bytes behind a key.
filegroup(
    name = "pack_records",
    srcs = glob(
        ["pack/**"],
        exclude = [
            "pack/ca/**",
            "pack/rb/**",
            "**/*_test.py",
            "**/__pycache__/**",
            "**/*.pyc",
            "**/.DS_Store",
            "**/.clang-format",
        ],
    ) + [
        "fx/test/twod_sim.h",  # the 2D engine nvdec executes (pack/nvdec.cpp)
        "srgb_table.h",  # the colour table pack/layouts.py recognises
        "//kits/SwitchGM20B:class_headers",  # pack/nvdec.cpp's method numbers
        "//kits/SwitchGM20BEmit:context",  # the channel's context init pack/context_state.cpp runs
    ],
)

# The system shader compiler (compiler/): compiled into the plugin and run by SwitchShaderCompiler below. Not part of the
# stack key: a store is named by the stack and the pack's rules, its entries are gm20b_cache.cpp's, and a store name made
# otherwise only misses.
filegroup(
    name = "compiler_srcs",
    srcs = [
        "compiler/compiler_codegen.mm",
        "compiler/compiler_debug.mm",
        "compiler/compiler_engine.mm",
        "compiler/compiler_facts.mm",
        "compiler/compiler_libraries.mm",
        "compiler/compiler_record.mm",
        "compiler/compiler_request.mm",
        "compiler/compiler_sandbox.mm",
        "compiler/compiler_service.mm",
    ],
)

filegroup(
    name = "compiler_cc_srcs",
    srcs = [
        "compiler/compiler_log.cpp",
        "compiler/compiler_pool.cpp",
        "compiler/compiler_store.cpp",
    ],
)

filegroup(
    name = "compiler_headers",
    srcs = glob(["compiler/*.h"]),
)

# /usr/libexec/SwitchShaderCompiler (overlay/manifest.json): loads the plugin and runs its compiler. launchd starts it on
# iOS 27 (com.brunostjohn.switch.shadercompiler.plist), the BlueTool stand-in on iOS 17.
ios_binary(
    name = "SwitchShaderCompiler",
    srcs = ["compiler/SwitchShaderCompiler.c"],
    out = "build/switch-gpu/SwitchShaderCompiler",
    copts = [
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-framework",
        "IOKit",
        "-framework",
        "CoreFoundation",
    ],
    entitlements = "compiler/SwitchShaderCompiler.entitlements",
)

# The overlay files of the compiler that overlay/manifest.json names
filegroup(
    name = "overlay_files",
    srcs = ["compiler/com.brunostjohn.switch.shadercompiler.plist"],
)

# What the driver's records, pack entries and native seed records are made by, as //gpu:stack_key hashes it: the shader
# tools build the pack's tools from exactly these files (//gpu/seed:local_tools), and the plugin makes and reads its
# records with the same units. stack_key checks that each unit here includes nothing else; tools/gpu/stack_key_test.py
# that the generator builds and reads nothing else.
filegroup(
    name = "stack_key_sources",
    srcs = [
        ":direct_sources",
        ":pack_records",
        "//drivers/TegraGM20BMetal:plugin/MetallibEntries.h",
        "//drivers/TegraGM20BMetal:plugin/MetallibSlice.h",
        "//drivers/TegraGM20BMetal:plugin/TwoPlaneStandIn.h",
        "//drivers/TegraGM20B:TegraGM20BABI.h",
        "//drivers/TegraGM20B:TegraGM20BFencePageABI.h",
        "//drivers/TegraGM20B:TegraGM20BJobABI.h",
        "//drivers/TegraGM20B:TegraGM20BLayout.h",
        "//kits/SwitchRefusal:SwitchRefusal.h",
        "//kits/SwitchRefusal:SwitchRefusalSite.h",
        "//kits/SwitchSeedPack:SwitchSeedPack.h",
    ],
)

# Every file below raw/: what stack_key_test.py looks the generator's file names up in
filegroup(
    name = "driver_tree",
    srcs = glob(
        [
            "*.h",
            "*.cpp",
            "*.mm",
            "pack/**",
            "fx/**",
            "harness/**",
        ],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/.DS_Store",
        ],
    ),
)

