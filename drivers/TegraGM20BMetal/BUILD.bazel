# The TegraGM20B Metal plugin's sources and the precompile/stage tools (m2v and our changes to it: third_party/m2v). The bundle itself is
# built by //gpu:bundle (gpu/BUILD.bazel); the device-side tools here are what //deploy:* runs.
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:package.bzl", "ios_binary")

package(default_visibility = ["//visibility:public"])

# raw/pack/mesa is Mesa's code, kept as upstream has it; srgb_knots.h is m2v's SRGB_KNOTS table, generated.
lint_files(exclude = [
    "raw/pack/mesa/**",
    "raw/pack/srgb_knots.h",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# The raw GM20B path: its runtime (compiled into the plugin), its pack generator, and every source its stack key hashes
# (every .h/.c/.cpp/.mm/.py/.inc/.metal below raw/, the old build's raw_stack()).
filegroup(
    name = "raw_runtime_headers",
    srcs = glob([
        "raw/runtime/*.h",
        "raw/fx/*.h",
    ]) + ["raw/pack/probe_bind.h"],  # the probe's bind offsets, which name a record's residual words (raw_record.h)
)

# The raw facade's Objective-C++ units (RawMetal.mm and the RawMetal*.mm beside it, RawAlias.mm, RawComplete.mm, RawDirect.mm)
filegroup(
    name = "raw_facade_srcs",
    srcs = glob(["raw/runtime/Raw*.mm"]),
)

# Not a hand run's leftovers: a .pyc of the modules (the host Python's) in a checkout would change the raw pack's action key
# there and nowhere else, so that checkout's pack never hits the disk cache another checkout filled, and the other way round.
filegroup(
    name = "raw_pack_generator",
    srcs = glob(
        ["raw/pack/**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/.DS_Store",
        ],
    ) + [
        "raw/runtime/raw_owned.h",  # the methods the raw path owns (pack/mkpack.py reads them)
        "raw/runtime/raw_srgb_table.h",  # the colour table pack/layouts.py recognises
        # the compute probe's key of a kernel (pack/probecompute.mm)
        "raw/runtime/raw_compute_key.h",
        "raw/runtime/raw_metallib.cpp",
        "raw/runtime/raw_metallib.h",
        "raw/runtime/raw_pack.h",
    ],
)

# The raw runtime's sources the pack generator's directpack.mm makes records with (raw/pack/rawpack.py DIRECT_RUNTIME)
filegroup(
    name = "raw_direct_sources",
    srcs = [
        "raw/runtime/RawDirect.h",
        "raw/runtime/RawDirect.mm",
        "raw/runtime/raw_cache.h",
        "raw/runtime/raw_compiler.h",
        "raw/runtime/raw_direct.cpp",
        "raw/runtime/raw_direct.h",
        "raw/runtime/raw_emit.cpp",
        "raw/runtime/raw_emit.h",
        "raw/runtime/raw_pack.cpp",
        "raw/runtime/raw_record.h",
        "raw/runtime/raw_record_parts.cpp",
        "raw/runtime/raw_record_parts.h",
    ],
)

filegroup(
    name = "raw_stack_sources",
    srcs = glob(["raw/**/*.%s" % suffix for suffix in ("h", "c", "cpp", "mm", "py", "metal")]),
)

# The GPU context-switch stress and fetch readback (raw/test/fetchform.cpp): debug boot packages stage it at
# /usr/bin/switch-fetchform, and the BlueTool stand-in runs it when the Mac posts
# com.brunostjohn.switch.debug.ctxsw-stress (`idevicenotificationproxy -u <udid> post com.brunostjohn.switch.debug.ctxsw-stress`);
# its lines are the "fetchform" category of com.brunostjohn.switch.TegraGM20BMetal (`idevicesyslog -u <udid> -m fetchform`).
ios_binary(
    name = "fetchform",
    srcs = [
        "raw/fx/fx_image.cpp",
        "raw/fx/fx_mip.cpp",
        "raw/runtime/raw_alias.cpp",
        "raw/runtime/raw_arena.cpp",
        "raw/runtime/raw_comp.cpp",
        "raw/runtime/raw_gpu.cpp",
        "raw/runtime/raw_kernel.cpp",
        "raw/runtime/raw_pack.cpp",
        "raw/runtime/raw_zeta.cpp",
        "raw/test/fetchform.cpp",
    ],
    out = "build/switch-gpu/fetchform",
    hdrs = [
        ":raw_runtime_headers",
        "//drivers/TegraGM20B:TegraGM20BABI.h",
        "//drivers/TegraGM20B:TegraGM20BLayout.h",
    ],
    copts = [
        "-O2",
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-I",
        "drivers/TegraGM20B",
        "-lc++",
        "-framework",
        "CoreFoundation",
        "-framework",
        "IOKit",
    ],
    # debug builds only (Device::fetchBarrier): //boot:package depends on it in the debug profile
    tags = ["manual"],
)

# The pack generator (raw/pack/rawpack.py and the modules it imports); //tools/gpu:rawpack runs it.
py_library(
    name = "raw_pack",
    srcs = glob(
        [
            "raw/pack/*.py",
            "raw/pack/ca/*.py",
        ],
        exclude = ["raw/pack/ca/*_test.py"],
    ),
    data = [
        "raw/pack/ca/qc-21H461.json",
        "raw/pack/ca/qc-24B119.json",
        "raw/runtime/raw_srgb_table.h",  # pack/layouts.py reads it at import
    ],
)

# raw/pack/ca/caspec.py makes every Core Animation state of the corpus from its name alone (QuartzCore's own decoding).
py_test(
    name = "caspec_test",
    srcs = ["raw/pack/ca/caspec_test.py"],
    data = [
        "precompile/corpus.log",
        "raw/pack/ca/qc-21H461.json",
    ],
    main = "raw/pack/ca/caspec_test.py",
    deps = [":raw_pack"],
)

# The same for iOS 27's QuartzCore (raw/pack/ca/caspec27.py): every state of the raw pack's tiers against the functions
# and constants its own library declares, and the journal's iOS 27 states made as drawn.
py_test(
    name = "caspec27_test",
    srcs = ["raw/pack/ca/caspec27_test.py"],
    data = [
        "precompile/corpus.log",
        "raw/pack/ca/qc-24B119.json",
    ],
    main = "raw/pack/ca/caspec27_test.py",
    deps = [":raw_pack"],
)

# Developer tools, `bazel run //drivers/TegraGM20BMetal:<name> -- ...`: the shader corpus
# (corpus/tools), the raw path's draw-order check, and the dyld shared cache import check.
[py_binary(
    name = tool,
    srcs = ["corpus/tools/%s.py" % tool],
    main = "corpus/tools/%s.py" % tool,
) for tool in [
    "categorize",
    "dsc_metallibs",
    "dsc_owner",
    "make_corpus",
    "mtlb_extract",
    "report",
    "run_corpus",
    "runtime_compile_callers",
]]

# The pipeline states Apple's OS declares ahead (corpus/tools/archives): binary archives, pipeline libraries and pipeline
# scripts. `bazel run //drivers/TegraGM20BMetal:declared -- --root <mounted OS volume> --root <mounted cryptex>...
# --inventory <tsv>` writes precompile/archives/<build>.tsv from an IPSW's images; archive_coverage diffs one against the
# raw pack's states and the device's journals.
# What the raw pack makes of them (//gpu/seed:raw_pack takes the IPSW kind's: tools/gpu/rawpack.py archive_lines).
filegroup(
    name = "archive_inventories",
    srcs = glob(["precompile/archives/*.tsv"]),
)

py_library(
    name = "archives",
    srcs = glob(
        ["corpus/tools/archives/*.py"],
        exclude = [
            "corpus/tools/archives/*_test.py",
            "corpus/tools/archives/coverage.py",
            "corpus/tools/archives/declared.py",
        ],
    ),
)

py_binary(
    name = "declared",
    srcs = ["corpus/tools/archives/declared.py"],
    main = "corpus/tools/archives/declared.py",
    deps = [
        ":archives",
        "//tools/gpu/shaders:metallib",
    ],
)

py_binary(
    name = "archive_coverage",
    srcs = ["corpus/tools/archives/coverage.py"],
    main = "corpus/tools/archives/coverage.py",
    deps = [
        ":archives",
        ":raw_pack",
    ],
)

# Every render state the IPSW kinds' archives declare for the device is the raw pack's, or raw takes it from elsewhere
py_test(
    name = "archive_coverage_test",
    srcs = ["corpus/tools/archives/coverage_test.py"],
    data = [
        "precompile/corpus.log",
        "raw/pack/ca/qc-21H461.json",
        "raw/pack/ca/qc-24B119.json",
        ":archive_inventories",
    ],
    main = "corpus/tools/archives/coverage_test.py",
    deps = [
        ":archives",
        ":raw_pack",
        "//tools/gpu:rawpack_steps",
    ],
)

py_test(
    name = "archives_test",
    srcs = ["corpus/tools/archives/archives_test.py"],
    main = "corpus/tools/archives/archives_test.py",
    deps = [":archives"],
)

py_binary(
    name = "ordercheck",
    srcs = ["raw/test/ordercheck.py"],
    main = "raw/test/ordercheck.py",
)

# The raw path's shader-data and target checks against the pack (they read it with the pack generator's modules).
[py_binary(
    name = check,
    srcs = ["raw/test/%s.py" % check],
    main = "raw/test/%s.py" % check,
    deps = [":raw_pack"],
) for check in [
    "datacheck",
    "targetcheck",
]]

py_binary(
    name = "check_dyld_cache_imports",
    srcs = ["check-dyld-cache-imports.py"],
    main = "check-dyld-cache-imports.py",
)

# Merges the shader journals of a mounted Data volume into precompile/corpus.log and stages the device's own data (deploy's
# log pull runs it); --pack makes @gpu_device_data's tar of it.
py_binary(
    name = "harvest",
    srcs = ["precompile/harvest.py"],
    main = "precompile/harvest.py",
)

# The OS volume's library pins (pins), names.json (names: //gpu/seed:crawl) and the corpus's libraries (resolve: the seed).
py_binary(
    name = "libraries",
    srcs = ["precompile/libraries.py"],
    main = "precompile/libraries.py",
)

# Stages a built bundle (//gpu:bundle's directory) onto a mounted Data volume (deploy --stage-gpu runs it).
py_binary(
    name = "stage",
    srcs = ["stage-tegra-gm20b-metal.py"],
    main = "stage-tegra-gm20b-metal.py",
)
