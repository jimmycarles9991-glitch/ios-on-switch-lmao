load("@rules_python//python:py_binary.bzl", "py_binary")
load("//bazel/lint:defs.bzl", "lint_files")
load("//ipsw:defs.bzl", "ipsw_pins")
load("//kernel/rules:inputs.bzl", "tool_output")

package(default_visibility = ["//visibility:public"])

lint_files()

ipsw_pins(name = "ipsw")

py_binary(
    name = "check_donor",
    srcs = ["check_donor.py"],
    deps = ["//tools/install:lib"],
)

tool_output(
    name = "donor_contract",
    srcs = [
        ":ipsw",
        "@ipsw//:os",
    ],
    outs = ["build/switch-bootstrap-migration/donor.json"],
    args = [
        "$(execpath @ipsw//:os)",
        "$(execpath :ipsw)",
        "{out}",
    ],
    binary = ":check_donor",
    message = "Checking the selected IPSW's native migration contract",
    mnemonic = "SwitchMigrationContract",
    requirements = [
        "no-sandbox",
        "requires-darwin",
    ],
)
