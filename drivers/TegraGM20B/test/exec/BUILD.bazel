# gpu_exec.c itself on the host: built with the kernel's flags against the real shim, nvkm and nvif headers, on a real
# nvif 906f channel in host memory and the real backing layer. What it links from the rest of the driver is in
# switch_gpu_exec_driver.c (taken from `nm -u` of its object).
#
#   bazel test //drivers/TegraGM20B/test/exec:all
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")
load("//kernel/rules:driver_flags.bzl", "GPU_C_FLAGS", "LINUX_RELAXATIONS")

lint_files()

# -nostdlibinc as the kernel's freestanding C recipe: the shim's os.h is the whole C library, and the host's
# <sys/cdefs.h> redefines its __cold.
GPU_HOST_COPTS_BASE = [flag.replace("{tree}/", "") for flag in GPU_C_FLAGS] + [
    "-nostdlibinc",
    "-fno-builtin",
    "-fno-common",
    "-I",
    "drivers/TegraGM20B",
]

GPU_HOST_COPTS = GPU_HOST_COPTS_BASE + ["-DDEVELOPMENT=1"]

GPU_HOST_RELEASE_COPTS = GPU_HOST_COPTS_BASE + [
    "-UDEVELOPMENT",
    "-DDEVELOPMENT=0",
    "-UDEBUG",
    "-DDEBUG=0",
]

GPU_HEADERS = [
    "//drivers/SwitchSuspend:headers",
    "//drivers/TegraDisplayFlip:headers",
    "//drivers/TegraGM20B:headers",
    "//kits/SwitchIdle:headers",
    "//kits/SwitchLinux:headers",
    "//kits/SwitchMMIO:headers",
]

host_library(
    name = "nvif_chan",
    srcs = [
        "//drivers/TegraGM20B:nouveau/nvif/chan.c",
        "//drivers/TegraGM20B:nouveau/nvif/chan506f.c",
        "//drivers/TegraGM20B:nouveau/nvif/chan906f.c",
    ] + GPU_HEADERS,
    c_std = "gnu11",
    copts = GPU_HOST_COPTS + LINUX_RELAXATIONS,
)

genrule(
    name = "owned_waits_source",
    testonly = True,
    srcs = ["//drivers/TegraGM20B:gpu_promise.c"],
    outs = ["switch_gpu_exec_owned_waits.h"],
    cmd = """
set -e
awk '/^void switch_gpu_chan_park_promises_locked\\(/ { body = 1; count++ } body { print } /^}/ { body = 0 } END { if (count != 1) exit 1 }' $< > $@
""",
)

host_library(
    name = "exec_driver",
    srcs = [
        ":owned_waits_source",
        "switch_gpu_exec_channel.c",
        "switch_gpu_exec_driver.c",
        "switch_gpu_exec_fixture.h",
    ] + GPU_HEADERS,
    c_std = "gnu11",
    copts = GPU_HOST_COPTS,
)

# Its MMIO through the harness's model (switch_gpu_exec_channel.c), which sees the doorbell's GP_PUT write to USERD
host_library(
    name = "gpu_exec",
    srcs = ["//drivers/TegraGM20B:gpu_exec.c"] + GPU_HEADERS,
    c_std = "gnu11",
    copts = GPU_HOST_COPTS + ["-DSWITCH_MMIO_HOST_MODEL"],
)

host_library(
    name = "exec_driver_release",
    srcs = [
        ":owned_waits_source",
        "switch_gpu_exec_channel.c",
        "switch_gpu_exec_driver.c",
        "switch_gpu_exec_fixture.h",
    ] + GPU_HEADERS,
    c_std = "gnu11",
    copts = GPU_HOST_RELEASE_COPTS,
)

host_library(
    name = "gpu_exec_release",
    srcs = ["//drivers/TegraGM20B:gpu_exec.c"] + GPU_HEADERS,
    c_std = "gnu11",
    copts = GPU_HOST_RELEASE_COPTS + ["-DSWITCH_MMIO_HOST_MODEL"],
)

EXEC_TEST_SRCS = [
    "switch_gpu_exec_backing.cpp",
    "switch_gpu_exec_backing.h",
    "switch_gpu_exec_commit_test.cpp",
    "switch_gpu_exec_fixture.h",
    "switch_gpu_exec_kernel.cpp",
]

EXEC_TEST_DEPS = [
    ":exec_driver",
    ":nvif_chan",
    "//drivers/TegraGM20B/test:backing",
    "//drivers/TegraGM20B/test:coherency_kernel",
]

host_test(
    name = "switch_gpu_exec_commit_test",
    srcs = EXEC_TEST_SRCS,
    deps = [":gpu_exec"] + EXEC_TEST_DEPS,
)

host_test(
    name = "switch_gpu_exec_wfi_debug_test",
    srcs = [
        "switch_gpu_exec_backing.cpp",
        "switch_gpu_exec_backing.h",
        "switch_gpu_exec_fixture.h",
        "switch_gpu_exec_kernel.cpp",
        "switch_gpu_exec_wfi_test.cpp",
    ],
    defines = ["SWITCH_EXEC_WFI_RELEASE=0"],
    deps = [":gpu_exec"] + EXEC_TEST_DEPS,
)

host_test(
    name = "switch_gpu_exec_wfi_release_test",
    srcs = [
        "switch_gpu_exec_backing.cpp",
        "switch_gpu_exec_backing.h",
        "switch_gpu_exec_fixture.h",
        "switch_gpu_exec_kernel.cpp",
        "switch_gpu_exec_wfi_test.cpp",
    ],
    defines = ["SWITCH_EXEC_WFI_RELEASE=1"],
    deps = [
        ":exec_driver_release",
        ":gpu_exec_release",
        ":nvif_chan",
        "//drivers/TegraGM20B/test:backing",
        "//drivers/TegraGM20B/test:coherency_kernel",
    ],
)

# The same test against gpu_exec.c with its commit moved (switch_gpu_exec_mutant.py): each of these is expected to
# FAIL, which shows what the test catches. Manual: never part of //...
MUTANTS = [
    "after_first_kick",
    "after_doorbell",
    "before_checks",
    "no_empty_commit",
    "finish_after_doorbell",
    "finish_at_publish",
]

py_binary(
    name = "mutate",
    testonly = True,
    srcs = ["switch_gpu_exec_mutant.py"],
    main = "switch_gpu_exec_mutant.py",
)

[genrule(
    name = "gpu_exec_%s_source" % mutant,
    testonly = True,
    srcs = ["//drivers/TegraGM20B:gpu_exec.c"],
    outs = ["gpu_exec_%s.c" % mutant],
    cmd = "$(execpath :mutate) %s $< $@" % mutant,
    tags = ["manual"],
    tools = [":mutate"],
) for mutant in MUTANTS]

[host_library(
    name = "gpu_exec_%s" % mutant,
    srcs = [":gpu_exec_%s_source" % mutant] + GPU_HEADERS,
    c_std = "gnu11",
    copts = GPU_HOST_COPTS + ["-DSWITCH_MMIO_HOST_MODEL"],
    tags = ["manual"],
) for mutant in MUTANTS]

[host_test(
    name = "switch_gpu_exec_commit_%s_test" % mutant,
    srcs = EXEC_TEST_SRCS,
    tags = ["manual"],
    deps = [":gpu_exec_%s" % mutant] + EXEC_TEST_DEPS,
) for mutant in MUTANTS]

# gpu_chan.c's channel creation over a model of the host's RAMFC (switch_gpu_chan_new_driver.c): a new channel's
# timeslice and acquire timeout hold through the host's load at its runlist insert and its objects' context binds.
host_library(
    name = "gpu_chan",
    srcs = [
        "//drivers/TegraGM20B:gpu_chan.c",
        "//drivers/TegraGM20B:gpu_chan_level.c",
    ] + GPU_HEADERS,
    c_std = "gnu11",
    copts = GPU_HOST_COPTS,
)

host_library(
    name = "chan_new_driver",
    srcs = [
        "switch_gpu_chan_new_driver.c",
        "switch_gpu_chan_new_harness.h",
        "//drivers/TegraGM20B:TegraGM20BRamfcOrder.h",
    ] + GPU_HEADERS,
    c_std = "gnu11",
    copts = GPU_HOST_COPTS,
)

host_test(
    name = "switch_gpu_chan_new_test",
    srcs = [
        "switch_gpu_chan_new_harness.h",
        "switch_gpu_chan_new_test.cpp",
        "switch_gpu_exec_fixture.h",
        "switch_gpu_exec_kernel.cpp",
    ],
    deps = [
        ":chan_new_driver",
        ":gpu_chan",
    ],
)
