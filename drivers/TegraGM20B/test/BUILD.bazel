# drivers/TegraGM20B on the host:
#   gm20b_comp_test          TegraGM20BComp.h against nvgpu's gm20b: the compbit backing store's size, lines and base for
#                            every plausible CBC_PARAM, which page lists and binds may compress, a compressed bind's PTEs
#   gm20b_load_test          TegraGM20BLoad.h: the PMU idle counters' program (nvgpu's raw load pair) and their reads
#                            extended to 64 bits, an interval counted only when it cannot hide a wrap
#   gm20b_zcull_test         TegraGM20BZcull.h against nvgpu's zcull report for the X1's GR; its record is
#                            drm_nouveau_get_zcull_info's
#   gm20b_zcull_context_test TegraGM20BZcullContext.h: each GR context's own zcull image and the context words
#                            pointing FECS at it (nvgpu's separate buffer mode), released at teardown
#   gm20b_tiled_cache_test   TegraGM20BTiledCache.h: the tile coalescer's table in the golden context is deko3d's masked
#                            writes folded over sw_ctx's zero
#   gm20b_nvn_golden_test    TegraGM20BNvnGolden.h: NVN's three golden-context bits over the netlist's values, written
#                            after sw_ctx; only a debug kernel's boot-arg leaves one out
#   gm20b_coherency_test     TegraGM20BCoherency.cpp: which IOSurface lock/unlock traps clean or invalidate an import,
#                            across imports of one surface and their release, and traps racing a release; each surface's
#                            layout decision (TegraGM20BTiled.cpp) and its contents tiled in place; CPU locks of a
#                            block-linear surface (TegraGM20BViews.cpp): rows in a scratch at the task's own address
#                            while the pages keep texels, shared readers, nested locks, writes put back, dead tasks
#   gm20b_relayout_test      TegraGM20BRelayout.h's copy-engine pushes over a model of MAXWELL_DMA_COPY_A: every move
#                            gives back exactly TegraGM20BLayout.h's bytes, for every texel size and NIL's shapes
#   gm20b_copy_test          TegraGM20BCopyPush.h (TegraVIC's plane bounce) over the same model: rows at the new pitch
#                            from pitch, block-linear and two-plane sources; writer and syncpoint waits first, the
#                            syncpoint increment after the copy is in DRAM
#   gm20b_wiring_test        TegraGM20BSharedWiring.cpp: one wiring per task and range, shared while the task still
#                            maps it there, a racing publish, the last import's release
#   gm20b_tlb_test           TegraGM20BTlb.h over a GMMU model (PTEs, the L2's copies, a TLB per space, running work
#                            that refills it): GPU-ordered maps and synchronous unmaps never reach a released page
#   gm20b_pool_policy_test   TegraGM20BPoolPolicy.h (where a coherent BO's memory comes from) over a model of the pool
#                            when Maps opened: its first buffers come from system memory instead of being refused;
#                            MapKit's 4 KiB, the compositor's 16 MiB block, the floor, room for everyone
#   gm20b_prefault_test      TegraGM20BSurfacePrefault.h over a mock create ABI: which IOSurfaceRootUserClient outputs
#                            name a new surface, and which surfaces are faulted in (size, memory pressure)
#   gm20b_push_scan_test     TegraGM20BPushScan.h (the kernel's method-stream reader and the push profile's classes) over
#                            streams laid out as NVK and the driver write them: every counter, each drawn target's
#                            image under its sample grid, a raw job's indirect command buffer draws inside their executed
#                            range (its macro slots the generator's), and no profile stamp after a push whose method
#                            continues, one the kernel could not read or one with an opcode NVK never writes
#   gm20b_target_peaks_test  SwitchGpuTargetPeaks.h: each process's largest target image since boot, and its line
#   gm20b_span_notes_test    SwitchGpuSpanNotes.h: the render server's long spans and the compositor's longest job
#   gm20b_preempt_landing_test SwitchGpuPreemptLanding.h: where a kick's preempt landed (a band's release, a job's end)
#   gm20b_inheritor_sleep_test SwitchGpuInheritorSleep.h's kernel branch: an owner is pushed, no owner is a plain sleep,
#                            and a wake reaches both
#   gm20b_cost_hist_test     TegraGM20BCostHist.h: the debug lines' buckets, and a p95 a single slow frame leaves alone
#   switch_gpu_owner_memory_test SwitchGpuOwnerMemory.h: a connection's BO counts, the debug line summing them by process
#   gm20b_sched_test         TegraGM20BSchedPolicy.h and tgm_hang_blame over deploy-2045's hang registers: what a
#                            compositor kick preempts, the interleaved runlist (full, empty, one level), which channel a
#                            late wait kills (the context GR cannot switch, a self-hung channel, never slow work)
#   gm20b_recover_test       TegraGM20BRecover.h over device boots 7 and 9: every SCHED_ERROR and BIND_ERROR code's name,
#                            which engine whose switch timed out is waited for, killed off or reset (a killed channel's
#                            context), which engines hold a channel at its unbind, that a PBDMA ENG_RESET or ACQUIRE never
#                            reaches nvkm as the channel's error; F-v1's twod_clear save timeout and its engine line
#   gm20b_kernel_hang_model_test  T-v5a's pool-scrub panic over a model of runlist 0 under hundreds of client
#                            kills: the rule before ends in it, the kernel channel's steps (TegraGM20BKernelHang.h)
#                            never do while a reset frees the GPU, and panic only once a clean reset of every engine
#                            did not
#   gm20b_eng_reset_order_test  recover_engine.c's hold of the PBDMA's ENG_RESET over a model of an engine reset and
#                            the interrupt pass: at every point the pass can run, the PBDMA goes on only once the engine is
#                            back, its live channel preempted, a killed one's method dropped
#   gm20b_bystander_test     one client's kill with other clients' work on runlist 0 (gm20b_bystander_model.h): boot 21's
#                            reset, a bystander mid-copy, one on PBDMA0 with a method pending while another preempt is in
#                            flight, two bystanders and every such state: no other channel killed or its work lost
#   gm20b_owed_preempt_test  recover_engine.c's owed preempt as the kernel builds it: asked once no preempt is in flight
#                            and while its channel is on the PBDMA, never during a hold, under the runlist's mutex, and
#                            its step with interrupts off takes no lock, sleep or allocation
#   gm20b_view_merge_test    TegraGM20BViewMerge.h: a CPU write lock's unlock keeps the bytes a GPU write left where the
#                            CPU wrote none, byte by byte
#   gm20b_pmc_enable_test    TegraGM20BPmcEnable.h with a recovery's GR reset and an engine's first use on PMC_ENABLE: no
#                            change made inside another is lost
#   gm20b_ramfc_order_test   TegraGM20BRamfcOrder.h over a model of the host's RAMFC save: a level change's timeslice
#                            written while the save of the switched-out channel is in flight still holds after a job
#   gm20b_acquire_test       TegraGM20BAcquire.h: the RAMFC ACQUIRE word as nvgpu computes it, CCSR's parked states, the
#                            semaphore or syncpoint a parked channel's RAMFC names
#   gm20b_sleep_test         TegraGM20BSleepGate.h (system sleep's gate and plan): every transition, and on threads moving
#                            between CPUs with gpu_power.c's sleeping protocol around it, no caller inside between the drain
#                            and the wake, a submission waiting at the gate goes on at the wake, a caller that never leaves
#                            fails the drain
#   gm20b_source_test        how the user client and gpu_*.c use both, the pool's zeroing (nvkm shim, scrubber), the
#                            fence-only present, and which paths go through the sleep gate in what order (none of which a
#                            host model runs); NVK's stencil copy temp on the bind alignment
#   gm20b_rail_test          TegraGM20BRail.h: the rail goes down with the display off and the GPU idle, once a demand's
#                            hold has run out, up on its thread call only for the display, never while system sleep holds it;
#                            gpu_bringup.c's lock protocol on threads; GPU time never backwards across rail cycles
#   gm20b_rail_sequence_test platform.c's rail-gating and ungating against the TRM's GPU procedure (12.2.7.17) step for step,
#                            on a register file of CAR, PMC, MC and the MAX77812, from a cold boot and after a gate
#   gm20b_clkgate_test       TegraGM20BClkgate.h against nvgpu's gm20b_gating_reglist.c (nvidia/, verbatim): the SLCG and
#                            BLCG writes are nvgpu's prod lists in its load order; ELCG's gate control; where gpu_bringup.c
#                            applies them; GR's reset in a recovery with gating off; TegraGM20BTherm.h's slowdown arming
#                            against L4T's captured THERM registers
#   gm20b_tex_trap_test      TegraGM20BTexTrap.h: GR traps that are TEX exceptions alone, their ESR line and repeats; nouveau's
#                            handler reports them as nvgpu does and leaves the channel running, other traps as before
#   gm20b_gr_init_test       GR floorsweeps at every init as nvgpu's power-on setup does; every GR context's debug line
#   gm20b_regdump_test       TegraGM20BRegDump.h against regs_gm20b.txt, the L4T capture's register list: same offsets,
#                            order and list id; the dump's lines are the capture's form, one value per register; the
#                            kernel log's lines carry every value once, in order, under a count and sum
#   switch_gpu_async_rights_test     an asynchronous call's wake port right on every return of EventObserve and
#                                    ResourceObserve: MIG releases it after an error, the notification after a success
#   switch_gpu_probe_gate_test       HW Test's paths op 7 (host1x syncpoints) and the facade's raw 3D-class methods: debug
#                                    builds alone, and only for a process holding SWITCH_GPU_PROBES_ENTITLEMENT
#   switch_gpu_refusal_sites_test    SwitchGpuRefusalSites.h: a SubmitJob or ResourceSetCreate refusal's line (process,
#                                    channel, site, values) from the call's one exit, silent only for an ended set and a
#                                    held admission, four then every 256th per connection and site
#   switch_gpu_compiler_rights_test  the same for the shader compiler broker's Compile: a request answered, abandoned or
#                                    refused (past its connection's bound, a stack not the compiler's, no compiler while
#                                    one was lost a third time); kern.switch_shader_compiler's line of the broker
#
#   bazel test //drivers/TegraGM20B/test:all
