load("//bazel/lint:defs.bzl", "lint_files")

# drivers/TegraGM20B: moved from out/native-a57/root-v1/tree/drivers/TegraGM20B by the layout move.
load("//kernel/rules:driver_flags.bzl", "GPU_C_FLAGS", "LINUX_RELAXATIONS")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

kernel_driver(
    name = "TegraGM20B_nvkm",
    srcs = [":" + f for f in glob(["nouveau/**/*.c"])],
    # TegraGM20BComp.h: compression numbers shared with gpu.c and test/gm20b_comp_test.cpp
    c_copts = GPU_C_FLAGS + LINUX_RELAXATIONS + [
        "-I",
        "{tree}/drivers/TegraGM20B",
    ],
    c_recipe = ":freestanding_c",
    hdr_deps = [],
    object_names = "path",
)

kernel_driver(
    name = "TegraGM20B",
    srcs = [
        "shim/linux.c",
        "shim/tegra_shim.c",
        "shim/stubs.c",
        "shim/nvif_nvkm.c",
        "platform.c",
        "gpu.c",
        "clkgate.c",
        "recover.c",
        "sched.c",
        "hold.c",
        "deadline.c",
        "shim/xnu_glue.cpp",
        "TegraGM20B.cpp",
        "TegraGM20BUserClient.cpp",
        "TegraGM20BDeviceClient.cpp",
        "TegraGM20BCoherency.cpp",
        "TegraGM20BRelayout.cpp",
        "TegraGM20BCopy.cpp",
        "TegraGM20BSurfaceClient.cpp",
        "TegraGM20BTiled.cpp",
        "TegraGM20BViews.cpp",
        "TegraGM20BExecSurfaces.cpp",
        "TegraGM20BSharedWiring.cpp",
        "TegraGM20BSurfacePrefault.cpp",
        # Subclasses the original IOAcceleratorES: a late object, run by TegraGM20B.cpp after IOGPUFamily loads.
        "TegraGM20BAccelerator.cpp",
        # GM20B falcon firmware (linux-firmware nvidia/gm20b) by .incbin.
        "firmware.S",
    ],
    abi = [
        "IOSurface",
        "IOSurfaceClient",
        "IOSurfaceRootUserClient",
    ],
    c_copts = GPU_C_FLAGS,
    c_recipe = ":freestanding_c",
    copts = [
        "-I",
        "{tree}/drivers/TegraGM20B",
    ],
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/SwitchSuspend",
        "drivers/TegraDisplayFlip",
        "drivers/TegraI2C",
        "kits/SwitchIdle",
        "kits/SwitchRefusal",
        "kits/SwitchScratch",
        "kits/SwitchSysctl",
    ],
    late = ["TegraGM20BAccelerator.cpp"],
    object_names = "path",
    # IOAcceleratorES for QuartzCore's 30 s accelerator poll and the GM20B driver.
    prelink = ["com.apple.iokit.IOGPUFamily"],
)
