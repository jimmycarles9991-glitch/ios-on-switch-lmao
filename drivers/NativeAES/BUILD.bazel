load("//bazel/lint:defs.bzl", "lint_files")

# drivers/NativeAES: moved from out/native-a57/root-v1/tree/drivers/NativeAES by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kits/SwitchABI:defs.bzl", "switch_abi_bindings")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# NativeAES.
kernel_driver(
    name = "NativeAES",
    srcs = [
        "NativeAES.cpp",
        "original-bindings.S",
    ],
    abi = ["IOAESAccelerator"],
    hdr_deps = [
        "drivers/TegraSE",
        "kits/SwitchRefusal",
    ],
)

switch_abi_bindings(
    name = "original_bindings",
    out = "original-bindings.S",
    classes = ["//kits/SwitchABI:IOAESAccelerator"],
    objects = [":NativeAES_cc"],
)
