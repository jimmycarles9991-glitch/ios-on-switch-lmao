    hdrs = _PAYLOAD_HDRS + _CANDIDATE_HDRS,
    candidate = True,
    header = "payload_candidate_release.h",
    link_script = "candidate.ld",
    lto = True,
    retain_symbols = _CANDIDATE_ROOTS,
)

# The payloads' ELFs and flat binaries (bootstrap_elf, bootstrap_binary, candidate_elf, candidate_binary), development
# and release, as their tests read them.
[
    filegroup(
        name = "%s_%s" % (payload, group),
        srcs = [
            ":" + payload,
            ":%s_release" % payload,
        ],
        output_group = group,
    )
    for payload in [
        "bootstrap",
        "candidate",
    ]
    for group in [
        "elf",
        "binary",
    ]
]

# The CPU tests' images. Each is one gcc compile and link, and srcs order is the link order.
_TEST_HDRS = glob(["*.h"])

_TEST_COPTS = [
    "-mcpu=cortex-r4",
    "-mthumb",
    "-mno-unaligned-access",
    "-Os",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-ffreestanding",
    "-fno-builtin",
    "-nostdlib",
]

# The native-symbol checks link at the island's address without running, for objdump.
_LINK_COPTS = [
    "-mcpu=cortex-r4",
    "-mthumb",
    "-mno-unaligned-access",
    "-Os",
    "-ffreestanding",
    "-fno-builtin",
    "-nostdlib",
]

_ASM_LINK_COPTS = [
    "-mcpu=cortex-r4",
    "-mthumb",
    "-nostdlib",
]

_FIRMWARE = "//drivers/SwitchWLAN:firmware/brcm/brcmfmac4356A3-pcie.bin"

_LTO = {
