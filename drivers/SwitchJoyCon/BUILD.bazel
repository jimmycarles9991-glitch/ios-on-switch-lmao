load("//bazel/lint:defs.bzl", "lint_files")

# drivers/SwitchJoyCon: moved from out/native-a57/root-v1/tree/drivers/SwitchJoyCon by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kernel/rules:package.bzl", "ios_binary")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# Joy-Cons. SwitchJoyConHID subclasses the original IOHIDDevice (late).
kernel_driver(
    name = "SwitchJoyCon",
    srcs = [
        "SwitchJoyConHID.cpp",
        "SwitchJoyConRail.cpp",
    ],
    abi = ["IOHIDDevice"],
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/SwitchSuspend",
        "drivers/TegraAPBDMA",
        "drivers/TegraGPIO",
        "kits/SwitchCAR",
        "kits/SwitchDMA",
        "kits/SwitchMMIO",
        "kits/SwitchTime",
    ],
    late = ["SwitchJoyConHID.cpp"],
    # Game-controller personalities.
    prelink = ["com.apple.driver.AppleGameControllerPersonality"],
)

# joyconpaird / joyconnfc: Joy-Con Bluetooth pairing hand-off and NFC.
[ios_binary(
    name = tool,
    srcs = ["helper/{}.c".format(tool)],
    out = "build/switch-joycon/" + tool,
    copts = [
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-framework",
        "CoreFoundation",
        "-framework",
        "IOKit",
    ],
    entitlements = "helper/{}.entitlements".format(tool),
) for tool in ("joyconpaird", "joyconnfc")]

# The overlay files of this driver that overlay/manifest.json names.
filegroup(
    name = "overlay_files",
    srcs = glob(["helper/*.plist"]),
)
