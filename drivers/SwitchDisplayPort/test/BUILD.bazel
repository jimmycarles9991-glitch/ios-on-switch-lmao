# drivers/SwitchDisplayPort's pure-C policies on the host:
#   alt_mode_test   the BM92T36 alternate-mode steps against a model dock, adapters and chargers; pin assignment D first
#   dp_modes_test   EDID parsing, source limits and native IOAV timing payloads
#   dp_link_test    the link for a mode, SOR1's transfer units (Linux's numbers), PLL_D2, training against a model sink
#   dp_aux_test     DPAUX1 control words (Linux's), replies, retries, the EDID read plan
#   policy_c11      every header again as C11 under -Wconversion -Wsign-conversion
#   external_planes_<kind>_test  SwitchExternalPlanes.h: clone swaps onto DC B's windows, the published limits
#   dcb_scanout_test             TegraDisplayB against a model of DC B's banked window registers
#
#   bazel test //drivers/SwitchDisplayPort/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

POLICY = [
    "//drivers/SwitchDisplayPort:SwitchDPAux.h",
    "//drivers/SwitchDisplayPort:SwitchDPCEC.h",
    "//drivers/SwitchDisplayPort:SwitchDPAppleTiming.h",
    "//drivers/SwitchDisplayPort:SwitchDPLink.h",
    "//drivers/SwitchDisplayPort:SwitchDPModes.h",
    "//drivers/SwitchDisplayPort:SwitchDPTraining.h",
    "//drivers/SwitchDisplayPort:SwitchPDAltMode.h",
    "//drivers/SwitchDisplayPort:SwitchPDAltModeSteps.h",
]

host_library(
    name = "policy_c11",
    srcs = ["policy_c11.c"] + POLICY,
    copts = [
        "-Wconversion",
        "-Wsign-conversion",
    ],
)

host_test(
    name = "alt_mode_test",
    srcs = ["alt_mode_test.cpp"] + POLICY,
    deps = [":policy_c11"],
)

host_test(
    name = "dp_modes_test",
    srcs = ["dp_modes_test.cpp"] + POLICY,
    deps = [":policy_c11"],
)

host_test(
    name = "dp_link_test",
    srcs = ["dp_link_test.cpp"] + POLICY,
    deps = [":policy_c11"],
)

host_test(
    name = "dp_aux_test",
    srcs = ["dp_aux_test.cpp"] + POLICY,
    deps = [":policy_c11"],
)

host_library(
    name = "sor_registers",
    srcs = [
        "//drivers/SwitchDisplayPort:TegraDpaux1.cpp",
        "//drivers/SwitchDisplayPort:TegraSor1.cpp",
        "//kits/SwitchCAR:SwitchCAR.cpp",
    ],
    hdrs = [
        "//drivers/SwitchDisplayPort:SwitchDPAux.h",
        "//drivers/SwitchDisplayPort:SwitchDPLink.h",
        "//drivers/SwitchDisplayPort:SwitchDPModes.h",
        "//drivers/SwitchDisplayPort:SwitchDPTraining.h",
        "//drivers/SwitchDisplayPort:TegraDpaux1.h",
        "//drivers/SwitchDisplayPort:TegraSor1.h",
        "//drivers/TegraI2C:TegraI2C.h",
        "//kits/SwitchCAR:SwitchCAR.h",
        "//kits/SwitchCAR:SwitchPMC.h",
        "//kits/SwitchMMIO:SwitchMMIO.h",
        "//kits/SwitchMMIO:SwitchMMIOKernel.h",
    ],
    defines = ["SWITCH_MMIO_HOST_MODEL=1"],
    deps = ["//drivers/SwitchUSB/test:xusb_kernel"],
)

host_test(
    name = "sor_registers_test",
    srcs = [
        "sor_registers_test.cpp",
        "//drivers/SwitchDisplayPort:TegraSor1.h",
    ],
    deps = [
        ":sor_registers",
        "//drivers/SwitchUSB/test:xusb_register_model",
    ],
)

PLANES = [
    "//drivers/NativeMobileDisplay:NativePlanes.h",
    "//drivers/NativeMobileDisplay:SwitchWindowCaps.h",
    "//drivers/NativeMobileDisplay:SwitchWindowFormatImage.h",
    "//drivers/SwitchDisplayPort:SwitchDPModes.h",
    "//drivers/SwitchDisplayPort:SwitchExternalPlanes.h",
    "//drivers/SwitchDisplayPort:SwitchExternalWindows.h",
    "//drivers/SwitchPower:SwitchDisplayBandwidth.h",
    "//drivers/SwitchPower:SwitchDisplayMemory.h",
    "//drivers/SwitchPower:SwitchDisplayMemoryMath.h",
    "//drivers/TegraGM20B:TegraGM20BLayout.h",
    "//drivers/TegraVIC:SwitchSurfaceColor.h",
    "//drivers/TegraVIC:TegraVICFormats.h",
]

# The planner as each IPSW kind builds it (the published dictionary differs).
[
    host_test(
        name = "external_planes_{}_test".format(kind),
        srcs = ["external_planes_test.cpp"] + PLANES,
        copts = ["-O1"],
        defines = ["SWITCH_IPSW_KIND_{}=1".format(kind)],
    )
    for kind in ("21H461", "24B119")
]

