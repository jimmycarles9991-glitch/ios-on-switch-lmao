load("//bazel/lint:defs.bzl", "lint_files")

# drivers/SwitchPower: moved from out/native-a57/root-v1/tree/drivers/SwitchPower by the layout move.
load("//kernel/rules:driver_flags.bzl", "IPSW_KIND_FLAGS")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# SwitchThermal: fan curve, CPU operating point; SwitchPerfGovernor: the CPU's on-demand governor (perfcontrol callouts);
# SwitchEMC: the EMC clock on demand (ACTMON); SwitchSensors: SOC_THERM and thermalmonitord's HID temperature sensors
# (drivers/SwitchPower/CONTRACT.md); SwitchSocTherm: SOC_THERM's die groups and their threshold interrupt.
kernel_driver(
    name = "SwitchThermal",
    srcs = [
        "SwitchThermal.cpp",
        "SwitchEMC.cpp",
        "SwitchPerfGovernor.cpp",
        "SwitchPowerStats.cpp",
        "SwitchSensors.cpp",
        "SwitchSocTherm.cpp",
        "SwitchVirtualTemps.cpp",
    ],
    # SwitchSensors.h's thermal model is the IPSW kind's iPad's.
    copts = IPSW_KIND_FLAGS,
    hdr_deps = [
        "diagnostics/switch",
        "drivers/ArmGIC",
        "drivers/NativeMobileDisplay",
        "drivers/NativeSwitchBlock",
        "drivers/SwitchBattery",
        "drivers/SwitchSuspend",
        "drivers/SwitchTouch",
        "drivers/TegraBPMP",
        "drivers/TegraDFLL",
        "drivers/TegraGM20B",
        "drivers/TegraGPIO",
        "drivers/TegraI2C",
        "kits/SwitchCAR",
        "kits/SwitchIdle",
        "kits/SwitchMMIO",
        "kits/SwitchRefusal",
    ],
)

# Boot clock line, MAX77620 RTC (IORTC) and power-off/restart; called from IOKitInitializeTime() (xnu patch).
kernel_driver(
    name = "SwitchPMIC",
    srcs = [
        "SwitchPMIC.cpp",
        "SwitchPowerMark.cpp",
        "SwitchMonotonicClock.cpp",
    ],
    hdr_deps = [
        "diagnostics/switch",
        "drivers/SwitchBrightness",
        "drivers/TegraBPMP",
        "drivers/TegraI2C",
        "kits/SwitchCAR",
        "kits/SwitchMMIO",
        "kits/SwitchSysctl",
    ],
)
