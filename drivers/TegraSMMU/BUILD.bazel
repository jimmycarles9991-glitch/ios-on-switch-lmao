load("//bazel/lint:defs.bzl", "lint_files")

# drivers/TegraSMMU: moved from out/native-a57/root-v1/tree/drivers/TegraSMMU by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# TegraVIC: the VIC falcon (Video Image Compositor 4.0) as the system's IOSurfaceAccelerator (AppleM2ScalerCSCDriver and
# its IOSurfaceAcceleratorClient): its SMMU domain, job engine, boot self-test (V0..V5) and user client; firmware by
# .incbin; the IOSurface kext's accessors by address, from kits/SwitchABI's IOSurface tables.
# TegraSMMU: the memory controller's SMMU registers under one lock, the page-table layout (TegraSMMUDomain.h) every
# translated swgroup uses, and an engine's whole address space (TegraSMMUEngine.h: NVDEC's and NVENC's).
kernel_driver(
    name = "TegraSMMU",
    hdr_deps = ["kits/SwitchDMA"],
)
