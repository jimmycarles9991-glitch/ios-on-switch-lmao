load("//bazel/lint:defs.bzl", "lint_files")

# drivers/SwitchMotion: moved from out/native-a57/root-v1/tree/drivers/SwitchMotion by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# The 6-axis IMU (SPI4) as the accelerometer and gyroscope HID services; calls SwitchHIDDevice (this archive).
kernel_driver(
    name = "SwitchMotion",
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/NativeMobileDisplay",
        "drivers/SwitchTouch",
        "drivers/TegraGPIO",
        "drivers/TegraSPI",
        "kits/SwitchRefusal",
    ],
)
