load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_shims", "host_test")

lint_files()

host_shims(
    name = "buttons_kernel",
    headers = [
        "IOKit/IOInterruptEventSource.h",
        "IOKit/IOLib.h",
        "IOKit/IOReturn.h",
        "IOKit/IOService.h",
        "IOKit/IOTimerEventSource.h",
