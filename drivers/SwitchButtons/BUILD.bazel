load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:driver_flags.bzl", "IPSW_KIND_FLAGS")

# drivers/SwitchButtons: moved from out/native-a57/root-v1/tree/drivers/SwitchButtons by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

kernel_driver(
    name = "SwitchButtons",
    # SwitchHID.h's report lengths are the IPSW kind's.
    copts = IPSW_KIND_FLAGS,
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/NativeMobileDisplay",
        "drivers/SwitchPower",
        "drivers/SwitchSuspend",
        "drivers/SwitchTouch",
        "drivers/TegraGPIO",
        "drivers/TegraI2C",
        "kits/SwitchCAR",
    ],
)
