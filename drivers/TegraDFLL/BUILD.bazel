load("//bazel/lint:defs.bzl", "lint_files")

# drivers/TegraDFLL: moved from out/native-a57/root-v1/tree/drivers/TegraDFLL by the layout move.
load("//kernel/rules:driver_flags.bzl", "DFLL_C_FLAGS", "LINUX_RELAXATIONS")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

kernel_driver(
    name = "TegraDFLL_linux",
    srcs = [
        "linux/drivers/clk/tegra/clk-dfll.c",
        "linux/drivers/clk/tegra/clk-tegra124-dfll-fcpu.c",
        "linux/drivers/soc/tegra/cvb.c",
        "linux/drivers/soc/tegra/fuse/speedo-tegra210.c",
    ],
    c_copts = DFLL_C_FLAGS + LINUX_RELAXATIONS,
    c_recipe = ":freestanding_c",
    hdr_deps = [
        "kits/SwitchLinux",
        "kits/SwitchMMIO",
    ],
    object_names = "path",
)

kernel_driver(
    name = "TegraDFLL",
    srcs = [
        "shim/linux.c",
        "platform.c",
        "dfll.c",
    ],
    c_copts = DFLL_C_FLAGS,
    c_recipe = ":freestanding_c",
    hdr_deps = [
        "drivers/TegraI2C",
        "kits/SwitchLinux",
        "kits/SwitchMMIO",
    ],
    object_names = "path",
)
