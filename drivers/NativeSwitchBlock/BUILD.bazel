load("//bazel/lint:defs.bzl", "lint_files")

# drivers/NativeSwitchBlock: moved from out/native-a57/root-v1/tree/drivers/NativeSwitchBlock by the layout move.
load("//kernel/rules:driver_flags.bzl", "BLOCK_FLAGS")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kits/SwitchABI:defs.bzl", "switch_abi_bindings")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

kernel_driver(
    name = "NativeSwitchBlock",
    srcs = [
        "NativeSwitchBlock.cpp",
        "original-bindings.S",
        "SwitchCryptex.cpp",
    ],
    copts = BLOCK_FLAGS,
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/SwitchBrightness",
        "drivers/SwitchPower",
        "drivers/TegraGPIO",
        "drivers/TegraI2C",
        "kits/SwitchDMA",
        "kits/SwitchMMIO",
        "kits/SwitchRefusal",
        "kits/SwitchTime",
    ],
    stems = {"NativeSwitchBlock.cpp": "NativeSwitchBlockDevice"},
)

switch_abi_bindings(
    name = "original_bindings",
    out = "original-bindings.S",
    classes = ["//kits/SwitchABI:IOBlockStorageDevice"],
    objects = [":NativeSwitchBlock_cc"],
)
