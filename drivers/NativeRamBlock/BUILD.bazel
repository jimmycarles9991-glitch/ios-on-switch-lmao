load("//bazel/lint:defs.bzl", "lint_files")

# drivers/NativeRamBlock: moved from out/native-a57/root-v1/tree/drivers/NativeRamBlock by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# NativeRamBlock: linked as a plain object next to the block driver's bindings (the XNU build script never linked its
# archive in this configuration).
kernel_driver(
    name = "NativeRamBlock",
    copts = [
        "-march=armv8-a",
        "-mgeneral-regs-only",
        "-fno-lto",
        "-I",
        "{xnu}/osfmk",
        "-I",
        "{build}/storage-abi/include",
        "-I",
        "{build}/native-ram-block",
    ],
    hdr_deps = [
        "kits/SwitchCRC",
        "kits/SwitchDT",
    ],
    include_osfmk = False,
    recipe = ":iokit_cxx_generic",
)
