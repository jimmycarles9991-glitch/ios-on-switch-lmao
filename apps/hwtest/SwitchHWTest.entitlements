<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>application-identifier</key>
	<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
	<key>platform-application</key>
	<true/>
	<key>com.apple.frontboard.launchapplications</key>
	<true/>
	<key>com.apple.private.memorystatus</key>
	<true/>
	<key>com.brunostjohn.switch.gpu-probes</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<true/>
	<key>com.apple.security.system-groups</key>
	<array>
		<string>systemgroup.com.apple.lsd.iconscache</string>
	</array>
	<key>com.apple.security.exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.BlueTool</string>
	</array>
	<key>com.apple.security.exception.files.absolute-path.read-only</key>
	<array>
		<string>/Applications/</string>
		<string>/private/var/mobile/Library/Logs/CrashReporter/</string>
		<string>/private/var/Switch/icon-cache-gpu</string>
		<string>/private/var/Switch/icon-cache-reset</string>
		<string>/private/var/Switch/icon-cache-restored</string>
	</array>
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/private/var/mobile/Media/Switch/benchloop/</string>
	</array>
	<key>com.apple.security.exception.sysctl.read-only</key>
	<array>
		<string>kern.bootsessionuuid</string>
		<string>kern.uuid</string>
		<string>kern.version</string>
		<string>kern.switch_motion_reports</string>
		<string>kern.switch_motion_fastpath_copies</string>
		<string>kern.switch_motion_gyro_us</string>
		<string>kern.switch_planes_flips</string>
		<string>kern.switch_planes_latched</string>
		<string>kern.switch_planes_maps</string>
		<string>kern.switch_planes_dropped</string>
		<string>kern.switch_planes_native</string>
		<string>kern.switch_planes_remaps</string>
		<string>kern.switch_vic_maps</string>
		<string>kern.switch_vic_remaps</string>
		<string>kern.switch_native_objects</string>
		<string>kern.switch_native_surfaces</string>
		<string>kern.switch_native_publications</string>
		<string>kern.switch_frame_info_shown</string>
		<string>kern.switch_frame_info_unsent</string>
		<string>kern.switch_frame_info_early</string>
		<string>kern.switch_frame_info_unphased</string>
		<string>kern.switch_display_refresh_min</string>
		<string>kern.switch_display_refresh_min_mach</string>
		<string>kern.switch_display_refresh_max</string>
		<string>kern.switch_display_refresh_max_mach</string>
		<string>kern.switch_display_refresh_step</string>
		<string>kern.switch_display_refresh_step_mach</string>
		<string>kern.switch_audio</string>
		<string>kern.switch_joycon</string>
		<string>kern.switch_soctherm</string>
		<string>kern.switch_sd</string>
		<string>kern.switch_gpu_paths</string>
		<string>kern.switch_gpu_promises</string>
		<string>kern.a64x.images</string>
		<string>kern.a64x.images_native</string>
		<string>kern.a64x.images_marked</string>
		<string>kern.a64x.text_pages</string>
		<string>kern.a64x.stub_words</string>
		<string>kern.a64x.stub_mismatch</string>
		<string>kern.a64x.traps</string>
		<string>kern.a64x.traps_unhandled</string>
		<string>kern.switch_flips_completion</string>
		<string>kern.switch_flips_gate</string>
		<string>kern.switch_flips_lead_us</string>
		<string>kern.switch_flips_withdrawn</string>
		<string>kern.switch_flips_refused</string>
		<string>kern.switch_flips_filter</string>
		<string>kern.switch_flips_filter_lead_us</string>
		<string>kern.switch_flips_filter_declined</string>
		<string>kern.switch_scan_checks</string>
		<string>kern.switch_scan_handed</string>
		<string>kern.switch_scan_overlaps</string>
		<string>kern.switch_flips_filter_calls</string>
		<string>kern.switch_flips_host1x</string>
		<string>kern.switch_media_flips_completion</string>
		<string>kern.switch_media_flips_withdrawn</string>
		<string>kern.switch_media_flips_refused</string>
		<string>kern.switch_media_flips_lead_us</string>
		<string>kern.switch_media_flips_armed</string>
		<string>kern.switch_media_flips_filter</string>
		<string>kern.switch_media_flips_filter_declined</string>
		<string>kern.switch_media_flips_done_at_swap</string>
		<string>kern.switch_media_flips_fenced</string>
		<string>kern.switch_media_flips_declined</string>
		<string>debug.switch_display_dc_host1x_class</string>
		<string>debug.switch_display_host1x_flip</string>
		<string>debug.switch_gpu_rail_cycle</string>
		<string>debug.switch_gpu_ramfc</string>
		<string>debug.switch_perf_dfll_landing</string>
		<string>debug.switch_joycon_probe</string>
		<string>debug.switch_recorder</string>
		<string>debug.switch_recorder_expect</string>
		<string>debug.switch_recorder_wait</string>
		<string>kern.switch_scanout_cpu</string>
		<string>kern.switch_scanout_unshown</string>
		<string>kern.switch_scanout_vic</string>
		<string>kern.switch_scanout_vic_up</string>
		<string>kern.memorystatus_level</string>
		<string>kern.proc.all</string>
		<string>kern.switch_shader_compiler</string>
		<string>kern.switch_fsctl_marks</string>
	</array>
	<key>com.apple.security.exception.sysctl.read-write</key>
	<array>
		<string>debug.switch_recorder_expect</string>
		<string>debug.switch_display_dc_host1x_class</string>
		<string>debug.switch_display_host1x_flip</string>
		<string>debug.switch_gpu_rail_cycle</string>
		<string>debug.switch_gpu_ramfc</string>
		<string>debug.switch_perf_dfll_landing</string>
		<string>debug.switch_joycon_probe</string>
	</array>
</dict>
</plist>
