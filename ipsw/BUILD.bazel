# What the build derives from the IPSW's members: @ipsw//:<role>, the kind --//ipsw:kind selects (fetched by
# range request; //ipsw). The kind's own pins (the decompressed kernelcache's sha256, ...) are in
# ipsw/pins.bzl, which the rules read through //ipsw:current.

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("//bazel/lint:defs.bzl", "lint_files")
load(":defs.bzl", "ipsw_apple_trust", "ipsw_device_tree", "ipsw_kernelcache", "ipsw_pretranslated")
load(":ipsw.bzl", "ipsw_kinds")
load(":pins.bzl", "IPSWS")

package(default_visibility = ["//visibility:public"])

lint_files()

# The original kernelcache, decompressed: what the prelinker takes Apple's kexts from and the ABI checks read.
ipsw_kernelcache(
    name = "kernelcache",
    src = "@ipsw//:kernelcache",
    out = "kernelcache.decompressed",
)

# Apple's device tree of the IPSW's own device (J120AP, J181AP): where the ADT's iPad identity comes from (adt_edit.py).
ipsw_device_tree(
    name = "device_tree",
    src = "@ipsw//:device_tree",
    out = "device_tree.adt",
)

# iOS 17's kernelcache under every kind: the iPadOS 27 prelink names Apple kernel addresses by the GOT names kexts
# imported in it.
ipsw_kernelcache(
    name = "kernelcache_21H461",
    src = ":21H461_kernelcache",
    out = "21H461/kernelcache.decompressed",
    kind = "21H461",
)

# Apple's trust caches for the root and the two cryptexes, as the boot package's static module takes them, each checked
# against the BuildManifest's Digest of it.
[
    ipsw_apple_trust(
        name = name,
        src = "@ipsw//:" + role,
        out = name + ".trustcache",
        fourcc = fourcc,
        role = role,
    )
    for name, role, fourcc in (
        ("static_trust", "static_trust_cache", "trst"),
        ("system_cryptex_trust", "system_cryptex_trust_cache", "trcs"),
        ("app_cryptex_trust", "app_cryptex_trust_cache", "trca"),
    )
]

# iOS 27: what the boot package carries of the pretranslate run (pretranslated/<kind>/, made offline from the decrypted
# images by //translate/arm64e/pretranslate's driver, which needs root to mount them): the trust modules, the dyld
# cache list and the pins the image composer's own run must match. Empty for a kind with no derived "pretranslated".
ipsw_pretranslated(
    name = "pretranslated",
    srcs = select({
        ":" + kind: glob(["pretranslated/{}/*".format(kind)])
        for kind, ipsw in IPSWS.items()
        if ipsw.get("derived", {}).get("pretranslated")
    } | {"//conditions:default": []}),
)

filegroup(
    name = "pretranslated_pins",
    srcs = [":pretranslated"],
    output_group = "pins",
)

py_binary(
    name = "derived",
    srcs = ["derived.py"],
)

# `bazel run //ipsw:pin -- --kind=<build> <ipsw url> <product> <device class>`: pins one IPSW kind's members in
# ipsw/pins.bzl (the others and every kind's derived pins are kept).
py_binary(
    name = "pin",
    srcs = ["pin.py"],
    deps = [":aea"],
)

py_library(
    name = "aea",
    srcs = ["aea.py"],
    deps = ["@switch_pypi//cryptography"],
)

py_binary(
    name = "aea_decrypt",
    srcs = ["aea_decrypt.py"],
)

# Inflates a deflated member's bytes and checks the content against its pin (ipsw_inflate runs it).
py_binary(
    name = "inflate",
    srcs = ["inflate.py"],
)

# --//ipsw:kind (default pins.bzl's DEFAULT_KIND), a config_setting per kind (//ipsw:<kind>), the deflated
# members inflated (//ipsw:<kind>_<role>, what @ipsw//:<role> selects), :current (the kind's IpswInfo).
ipsw_kinds()
