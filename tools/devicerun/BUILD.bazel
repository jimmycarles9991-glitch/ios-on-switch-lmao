# stutter.py's frame-pacing checks over lines in the kernel's formats.
py_test(
    name = "stutter_test",
    size = "small",
    srcs = ["stutter_test.py"],
    deps = [":lib"],
)

# apps.py's checks over boot 16b's lsd and SpringBoard lines.
py_test(
    name = "apps_test",
    size = "small",
    srcs = ["apps_test.py"],
    deps = [":lib"],
