load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

lint_files()

py_library(
    name = "lib",
    srcs = [
        "apps.py",
        "audio.py",
        "checks.py",
        "cut.py",
        "devicerun.py",
        "dispatch.py",
        "hwtest.py",
        "joycon.py",
        "lockscreen.py",
        "morning.py",
        "protection.py",
        "reports.py",
        "rules.py",
        "stutter.py",
        "textures.py",
    ],
    deps = [
        ":renamed",
        "//tools/frames:lib",
    ],
)

# Device output from before the driver's rename in today's names (renamed.tsv: generated by the rename tool's
# gen_compare.py from its rules), for comparing pulls and HW Test runs across it.
py_library(
    name = "renamed",
    srcs = ["renamed.py"],
    data = ["renamed.tsv"],
    visibility = ["//tools/hwtest:__pkg__"],
)

py_test(
    name = "renamed_test",
    size = "small",
    srcs = ["renamed_test.py"],
    deps = [":renamed"],
)

# bazel run //tools/devicerun -- <absolute .logarchive> [--crashes <dir>] [--tsv <file>]: the morning device table.
py_binary(
    name = "devicerun",
    srcs = ["devicerun.py"],
    deps = [":lib"],
)

py_test(
    name = "devicerun_test",
    size = "small",
    srcs = ["devicerun_test.py"],
    data = glob(["test/**"]),
    deps = [":lib"],
)

# hwtest.py's checks over synthetic app lines, and its TESTS against the app's own test IDs.
py_test(
    name = "hwtest_test",
    size = "small",
    srcs = ["hwtest_test.py"],
    data = [
        "//apps/hwtest:SwitchHWTest.entitlements",
        "//apps/hwtest:SwitchHWTest27.entitlements",
        "//apps/hwtest:swift_sources",
        "//apps/hwtest:test_sources",
    ],
    deps = [":lib"],
)

# audio.py's checks over boot 16's audiomxd lines.
py_test(
    name = "audio_test",
    size = "small",
    srcs = ["audio_test.py"],
    deps = [":lib"],
)

