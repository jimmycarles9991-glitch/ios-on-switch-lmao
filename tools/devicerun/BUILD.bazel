# bazel run //tools/devicerun:frame_weights -- <absolute .logarchive> --pack <pack.bin>: the frame-weights capture's table
# (drivers/TegraGM20BMetal/draw_times.h, tools/devicerun/README.md)
py_library(
    name = "frame_weights_lib",
    srcs = ["frame_weights.py"],
    deps = [
        ":lib",
        "//tools/gpu/maxwell:nakstat",
    ],
)

