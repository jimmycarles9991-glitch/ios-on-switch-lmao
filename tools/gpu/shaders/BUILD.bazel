load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//gpu:__subpackages__"])

lint_files()

# The crawl takes metallib.py alone: its action is keyed on the IPSW's images and the crawler, nothing the corpus tools
# change.
py_library(
    name = "metallib",
    srcs = ["metallib.py"],
    visibility = [
        "//drivers/TegraGM20BMetal:__pkg__",
        "//gpu:__subpackages__",
    ],
)

py_library(
    name = "lib",
    srcs = [
        "derive.py",
        "journal.py",
        "plan.py",
    ],
    deps = [":metallib"],
)

py_binary(
    name = "plan",
    srcs = ["plan.py"],
    deps = [":lib"],
)

py_binary(
    name = "precompile",
    srcs = ["precompile.py"],
)

py_binary(
    name = "crawl",
    srcs = ["crawl.py"],
    deps = [":metallib"],
)

py_binary(
    name = "merge",
    srcs = ["merge.py"],
    deps = ["//tools/gpu:nvk_twin"],
)

[py_test(
    name = name,
    srcs = [name + ".py"],
    deps = [":lib"],
) for name in (
    "derive_test",
    "metallib_test",
    "plan_test",
)]

py_test(
    name = "merge_test",
    srcs = [
        "merge.py",
        "merge_test.py",
        "precompile.py",
    ],
    deps = ["//tools/gpu:nvk_twin"],
)
