# The GPU bundle's build steps (gpu/defs.bzl runs them as actions).
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//gpu:__subpackages__"])

lint_files()

py_binary(
    name = "xcode_run",
    srcs = ["xcode_run.py"],
)

py_binary(
    name = "bundle",
    srcs = ["bundle.py"],
    deps = [
        "//tools/common:macho",
        "//tools/trustcache",
    ],
)

py_library(
    name = "nvk_twin",
    srcs = ["nvk_twin.py"],
    visibility = ["//tools/gpu/shaders:__pkg__"],
    deps = ["//tools/common:macho"],
)

py_binary(
    name = "seed",
    srcs = ["seed.py"],
    deps = [":nvk_twin"],
)

# Runs the pack generator (--generator: drivers/TegraGM20BMetal/raw/pack/rawpack.py, by path) with the twin seed.py
# made. The generator's modules are each step's own inputs, not this tool's runfiles: a module edit reruns only the
# steps that run it.
py_binary(
    name = "rawpack",
    srcs = ["rawpack.py"],
)

# Its steps, for the pack's coverage test (//drivers/TegraGM20BMetal:archive_coverage_test: archive_lines)
py_library(
    name = "rawpack_steps",
    srcs = ["rawpack.py"],
    visibility = ["//drivers/TegraGM20BMetal:__pkg__"],
)

py_binary(
    name = "raw_stack",
    srcs = ["raw_stack.py"],
)

py_binary(
    name = "assemble",
    srcs = ["assemble.py"],
)

py_binary(
    name = "stage_manifest",
    srcs = ["stage_manifest.py"],
    deps = ["//tools/common:hashing"],
)
