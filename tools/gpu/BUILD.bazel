# The GPU bundle's build steps (gpu/defs.bzl runs them as actions).
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//ipsw:pins.bzl", "IPSWS")

package(default_visibility = ["//gpu:__subpackages__"])

lint_files()

py_binary(
    name = "xcode_run",
    srcs = ["xcode_run.py"],
)

py_binary(
    name = "bundle",
    srcs = ["bundle.py"],
    deps = [
        "//tools/common:macho",
        "//tools/trustcache",
    ],
)

# bundle.py's check: the plugin holds the translation's entry points and nothing of m2v's runtime, bridge or frontend
py_test(
    name = "bundle_test",
    srcs = [
        "bundle.py",
        "bundle_test.py",
    ],
    data = ["//drivers/TegraGM20BMetal:translate/NativeMetalTranslate.h"],
    env = {"TRANSLATE_HEADER": "$(rootpath //drivers/TegraGM20BMetal:translate/NativeMetalTranslate.h)"},
    deps = [
        "//tools/common:macho",
        "//tools/trustcache",
    ],
)

py_binary(
    name = "seed",
    srcs = ["seed.py"],
)

# Runs the pack generator (--generator: drivers/TegraGM20BMetal/pack/make_pack.py, by path). The generator's modules
# are each step's own inputs, not this tool's runfiles: a module edit reruns only the steps that run it.
py_binary(
    name = "make_pack",
    srcs = ["make_pack.py"],
)

# One bucket of the pack (--generator: drivers/TegraGM20BMetal/pack/directbucket.py): its own tool, so a bucket's
# action is keyed on neither make_pack.py's other steps nor the generator's other modules.
py_binary(
    name = "probe",
    srcs = ["probe.py"],
)

py_library(
    name = "probe_steps",
    srcs = ["probe.py"],
)

py_test(
    name = "probe_test",
    srcs = ["probe_test.py"],
    deps = [":probe_steps"],
)

py_test(
    name = "seed_tools_debug_map_test",
    srcs = ["seed_tools_debug_map_test.py"],
    data = ["//gpu/seed:local_tools"],
    env = {"SEED_TOOLS": "$(rootpath //gpu/seed:local_tools)"},
    deps = ["//tools/common:macho"],
)

# Its steps, for the pack's coverage test (//drivers/TegraGM20BMetal:archive_coverage_test: archive_lines)
py_library(
    name = "make_pack_steps",
    srcs = ["make_pack.py"],
    visibility = ["//drivers/TegraGM20BMetal:__pkg__"],
)

py_test(
    name = "make_pack_test",
    srcs = ["make_pack_test.py"],
    data = [
        "//drivers/TegraGM20BMetal:precompile/corpus.log",
        "//drivers/TegraGM20BMetal:format_standin.h",
        "//drivers/TegraGM20BMetal:xr.h",
        "//drivers/TegraGM20BMetal:ycbcr_store.h",
    ],
    env = {
        "RAWPACK_BUILDS": " ".join(IPSWS.keys()),
        "RAWPACK_CORPUS": "$(rootpath //drivers/TegraGM20BMetal:precompile/corpus.log)",
    },
    deps = [":make_pack_steps"],
)

# Adds the states a device made at run time to the precompile corpus, from a pulled logarchive (logharvest.py)
py_binary(
    name = "logharvest",
    srcs = ["logharvest.py"],
    deps = ["//drivers/TegraGM20BMetal:pack"],
)

py_test(
    name = "logharvest_test",
    srcs = [
        "logharvest.py",
        "logharvest_test.py",
    ],
    deps = ["//drivers/TegraGM20BMetal:pack"],
)

# Adds the compute kernels a device dispatched at run time to the precompile corpus, from pulled logarchives
# (kernelharvest.py)
py_binary(
    name = "kernelharvest",
    srcs = [
        "kernelharvest.py",
        "logharvest.py",
    ],
    data = ["//drivers/TegraGM20BMetal:precompile/libraries.py"],
    deps = ["//drivers/TegraGM20BMetal:pack"],
)

py_test(
    name = "kernelharvest_test",
    srcs = [
        "kernelharvest.py",
        "kernelharvest_test.py",
        "logharvest.py",
    ],
    data = ["//drivers/TegraGM20BMetal:precompile/libraries.py"],
    deps = ["//drivers/TegraGM20BMetal:pack"],
)

py_binary(
    name = "stack_key",
    srcs = ["stack_key.py"],
)

py_test(
    name = "stack_key_test",
    srcs = [
        "stack_key.py",
        "stack_key_test.py",
    ],
    data = [
        "//drivers/TegraGM20BMetal:stack_key_sources",
        "//drivers/TegraGM20BMetal:driver_tree",
        "//gpu:stack_key_inputs",
    ],
)

py_binary(
    name = "assemble",
    srcs = ["assemble.py"],
    deps = [
        ":stage_format",
        "//tools/common:hashing",
    ],
)

py_library(
    name = "seed_pack",
    srcs = ["seed_pack.py"],
    visibility = ["//tools/gpu/shaders:__pkg__"],
)

# The stage manifest's format. gpu/seed reads its PREFS (pack/ca/deepcolour.py), as the device runs with them.
py_library(
    name = "stage_format",
    srcs = ["stage_format.py"],
    visibility = [
        "//boot:__pkg__",
        "//gpu:__subpackages__",
        "//tools/deploy:__pkg__",
        "//tools/install:__pkg__",
    ],
)

exports_files(["stage_format.py"])

py_binary(
    name = "stage_manifest",
    srcs = ["stage_manifest.py"],
    deps = [
        ":seed_pack",
        ":stage_format",
        "//tools/common:hashing",
    ],
)

py_test(
    name = "stage_manifest_test",
    srcs = [
        "stage_manifest.py",
        "stage_manifest_test.py",
    ],
    data = ["//drivers/TegraGM20BMetal:stage-tegra-gm20b-metal.py"],
    deps = [
        ":seed_pack",
        ":stage_format",
        "//tools/common:hashing",
    ],
)
