# drivers/TegraGM20BMetal/raw/runtime/raw_heap_classes.h from m2v's translator (src/main.rs), and the test that the
# checked-in header is this tree's translator's
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")

lint_files()

rust_binary(
    name = "raw_heap_classes",
    srcs = ["src/main.rs"],
    edition = "2024",
    deps = ["//third_party/m2v/crates/metal2vulkan"],
)

rust_test(
    name = "raw_heap_classes_test",
    crate = ":raw_heap_classes",
    data = ["//drivers/TegraGM20BMetal:raw/runtime/raw_heap_classes.h"],
    edition = "2024",
    env = {"RAW_HEAP_CLASSES_H": "$(rootpath //drivers/TegraGM20BMetal:raw/runtime/raw_heap_classes.h)"},
)
