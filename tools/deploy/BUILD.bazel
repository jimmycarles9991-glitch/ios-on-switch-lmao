load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files([
    "deploy.py",
    "pull_logs.py",
])

py_library(
    name = "lib",
    srcs = [
        "deployed.py",
        "joycon_pairing.py",
        "mkarchive.py",
        "poster_snapshots.py",
        "pull_logs.py",
        "registration.py",
        "system_apps.py",
    ],
    imports = ["../.."],
    deps = [
        "//tools/common:files",
        "//tools/common:macho",
        "//tools/common:paths",
        "//tools/hwtest:lib",
        "//tools/install:lib",
    ],
)

py_library(
    name = "deploy",
    srcs = ["deploy.py"],
    imports = ["../.."],
    deps = [":lib"],
)

py_test(
    name = "deploy_test",
    srcs = ["deploy_test.py"],
    deps = [
        ":deploy",
        ":lib",
    ],
)

py_test(
    name = "deployed_test",
    size = "small",
    srcs = ["deployed_test.py"],
    deps = [":lib"],
)

py_test(
    name = "system_apps_test",
    size = "small",
    srcs = ["system_apps_test.py"],
    deps = [":lib"],
)
