     s->err_status.reg32 = ERR_STATUS_RESET;
     s->emem_arb_cfg0.reg32 = EMEM_ARB_CFG0_RESET;
     s->emem_arb_cfg1.reg32 = EMEM_ARB_CFG1_RESET;
diff --git a/hw/arm/tegra2/include/tegra_smmu.h b/hw/arm/tegra2/include/tegra_smmu.h
new file mode 100644
index 0000000..f9a8419
--- /dev/null
+++ b/hw/arm/tegra2/include/tegra_smmu.h
@@ -0,0 +1,36 @@
+/*
+ * Tegra X1 memory controller SMMU, as its memory clients see it.
+ *
+ *  This program is free software; you can redistribute it and/or modify it
+ *  under the terms of the GNU General Public License as published by the
+ *  Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+#ifndef TEGRA_SMMU_H
+#define TEGRA_SMMU_H
+
+#include "exec/hwaddr.h"
+
+/* A memory client (Linux memory/tegra/tegra210.c): its TRANSLATION_ENABLE_n bit and its swgroup's ASID register. */
+typedef struct TegraSmmuClient {
+    uint16_t enable_reg;
+    uint8_t enable_bit;
+    uint16_t asid_reg;
+} TegraSmmuClient;
+
+enum tegra_smmu_result {
+    TEGRA_SMMU_BYPASS,
+    TEGRA_SMMU_MAPPED,
+    TEGRA_SMMU_FAULT,
+};
+
+/*
+ * The client's access to address. It is translated only while MC_SMMU_CONFIG is on, the client's TRANSLATION_ENABLE
+ * bit is set and its swgroup's ASID register has ENABLE (bit 31); otherwise *pa is address. A translated access walks
+ * the ASID's directory (PTB_DATA) as Linux iommu/tegra-smmu.c lays it out, with no TLB, and faults on a directory or
+ * page entry without READ (bit 31), or an address past 32 bits. *asid is the ASID it went through.
+ */
+enum tegra_smmu_result tegra_smmu_translate(const TegraSmmuClient *client, uint64_t address, hwaddr *pa,
+                                            unsigned *asid);
+
+#endif
