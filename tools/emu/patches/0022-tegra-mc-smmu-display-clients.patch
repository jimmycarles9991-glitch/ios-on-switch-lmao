+enum tegra_smmu_result tegra_smmu_translate(const TegraSmmuClient *client, uint64_t address, hwaddr *pa,
+                                            unsigned *asid)
+{
+    tegra_mc *s = tegra_mc_dev;
+    uint32_t group, ptb, pde, pte;
+    hwaddr table;
+
+    *pa = address;
+    *asid = 0;
+    if (!client->enable_reg || !(tegra_mc_priv_read(s, SMMU_CONFIG_OFFSET, 4) & 1) ||
+        !(tegra_mc_priv_read(s, client->enable_reg, 4) & (1u << client->enable_bit))) {
+        return TEGRA_SMMU_BYPASS;
+    }
+    group = tegra_mc_priv_read(s, client->asid_reg, 4);
+    if (!(group & SMMU_ASID_ENABLE)) {
+        return TEGRA_SMMU_BYPASS;
+    }
+    *asid = group % SMMU_ASIDS;
+    ptb = s->smmu_ptb[*asid];
+    if (address >> 32 || !(ptb & SMMU_READABLE)) {
+        return TEGRA_SMMU_FAULT;
+    }
+    table = (hwaddr)(ptb & SMMU_PFN_MASK) << 12;
+    pde = address_space_ldl_le(&address_space_memory, table + (address >> 22) * 4, MEMTXATTRS_UNSPECIFIED, NULL);
+    if (!(pde & SMMU_READABLE)) {
+        return TEGRA_SMMU_FAULT;
+    }
+    if (!(pde & SMMU_PDE_NEXT)) {
+        *pa = ((hwaddr)(pde & SMMU_PFN_MASK) << 12 & ~(hwaddr)0x3fffff) | (address & 0x3fffff);
+        return TEGRA_SMMU_MAPPED;
+    }
+    table = (hwaddr)(pde & SMMU_PFN_MASK) << 12;
+    pte = address_space_ldl_le(&address_space_memory, table + ((address >> 12) & 0x3ff) * 4, MEMTXATTRS_UNSPECIFIED,
+                               NULL);
+    if (!(pte & SMMU_READABLE)) {
+        return TEGRA_SMMU_FAULT;
+    }
+    *pa = (hwaddr)(pte & SMMU_PFN_MASK) << 12 | (address & 0xfff);
+    return TEGRA_SMMU_MAPPED;
+}
