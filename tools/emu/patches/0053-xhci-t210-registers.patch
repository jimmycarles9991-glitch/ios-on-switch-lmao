+    return ret;
+}
+
+static uint64_t xhci_t210_extcap_read(void *ptr, hwaddr reg, unsigned size)
+{
+    XHCIState *xhci = ptr;
+    uint32_t ret;
+
+    switch (reg) {
+    case 0x00: /* USB Legacy Support: ID 1, next 4 dwords on, no BIOS or OS ownership claimed */
+        ret = 0x00000401;
+        break;
+    case 0x10: /* Supported Protocol, USB 3.0: next 4 dwords on */
+        ret = 0x03000402;
+        break;
+    case 0x14:
+    case 0x24:
+        ret = 0x20425355; /* "USB " */
+        break;
+    case 0x18: /* USB 3 ports first */
+        ret = (xhci->numports_3 << 8) | 1;
+        break;
+    case 0x20: /* Supported Protocol, USB 2.0: the last capability */
+        ret = 0x02000002;
+        break;
+    case 0x28: /* HLC set at reset (TRM p.1607), though the ports have no hardware L1 LPM (22.4, p.1323) */
+        ret = T210_USB2_HLC | (xhci->numports_2 << 8) | (xhci->numports_3 + 1);
+        break;
+    default:
+        ret = 0;
+        break;
+    }
+    trace_usb_xhci_cap_read(T210_OFF_EXTCAP + reg, ret);
     return ret;
 }
 
+static void xhci_t210_extcap_write(void *ptr, hwaddr reg, uint64_t val, unsigned size)
+{
+    trace_usb_xhci_unimplemented("extended capability write", T210_OFF_EXTCAP + reg);
+}
+
+static const MemoryRegionOps xhci_t210_extcap_ops = {
+    .read = xhci_t210_extcap_read,
+    .write = xhci_t210_extcap_write,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
 static uint64_t xhci_port_read(void *ptr, hwaddr reg, unsigned size)
 {
     XHCIPort *port = ptr;
