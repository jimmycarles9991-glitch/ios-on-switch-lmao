 #define OFF_RUNTIME     0x1000
 #define OFF_DOORBELL    0x2000
 
+/*
+ * The T210 XUSB host's layout (Tegra X1 TRM 22.16.11, p.1596-1607): CAPLENGTH 20h, DBOFF 300h dwords, RTSOFF 40h
+ * 32-byte units, xECP 180h dwords (USB Legacy Support, then the USB 3 and USB 2.0 Supported Protocol capabilities),
+ * HCSPARAMS2 ERST Max Fh and IST 8, HCSPARAMS3 U2 latency 40h and U1 latency 2, MaxPSASize Fh. The manual puts the
+ * USB 2.0 capability at 187h, inside a four-dword USB 3 capability at 184h; it follows that one here (188h).
+ */
+#define T210_LEN_CAP        0x20
+#define T210_OFF_RUNTIME    (0x40 << 5)
+#define T210_OFF_DOORBELL   (0x300 << 2)
+#define T210_OFF_EXTCAP     (0x180 << 2)
+#define T210_LEN_EXTCAP     0x30
+#define T210_USB2_HLC       (1 << 19)
+
+#if (T210_LEN_CAP + LEN_OPER) > T210_OFF_EXTCAP
+#error The T210 port registers reach its extended capabilities
+#endif
+#if (T210_OFF_RUNTIME + LEN_RUNTIME) > T210_OFF_DOORBELL
+#error The T210 runtime registers reach its doorbells
+#endif
+
 #if (OFF_OPER + LEN_OPER) > OFF_RUNTIME
 #error Increase OFF_RUNTIME
 #endif
@@ -2790,33 +2810,33 @@
 
     switch (reg) {
     case 0x00: /* HCIVERSION, CAPLENGTH */
-        ret = 0x01000000 | LEN_CAP;
+        ret = 0x01000000 | (xhci->t210_registers ? T210_LEN_CAP : LEN_CAP);
         break;
     case 0x04: /* HCSPARAMS 1 */
         ret = ((xhci->numports_2+xhci->numports_3)<<24)
             | (xhci->numintrs<<8) | xhci->numslots;
