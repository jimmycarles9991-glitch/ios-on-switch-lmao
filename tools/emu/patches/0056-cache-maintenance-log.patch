+/*
+ * The cache-log property's file: every data-cache maintenance instruction the guest runs ('D': its VA, the line it
+ * resolved to through the guest's own translation at that moment, its MAIR attribute and vCPU; 'S' for set/way), every
+ * byte range the xHCI read ('R', as an OUT transfer is set up) or wrote ('W', as an IN transfer completes) through the
+ * SMMU with its IOVA and guest physical address, and the CPU's mappings of those pages ('M'), in the one order TCG ran
+ * them. tools/emu/cachecheck.py judges it.
+ */
+typedef struct QEMU_PACKED {
+    uint8_t type, op, who, attrs;
+    uint32_t len;
+    uint64_t seq, ns, ram, addr, va;
+} CacheRecord;
+
+static FILE *cache_log;
+static uint64_t cache_seq;
+static GHashTable *cache_watched;  /* guest physical pages the controller has read or written */
+static bool cache_probing;         /* a maintenance instruction's own translation, not a CPU access */
+
+/* ns is 0 for maintenance: icount cannot be read inside a translation block, so the sequence number orders them. */
+static void cache_put(uint8_t type, uint8_t op, uint8_t who, uint8_t attrs, uint32_t len, uint64_t ns, uint64_t ram,
+                      uint64_t addr, uint64_t va)
+{
+    CacheRecord r = {
+        type, op, who, attrs, cpu_to_le32(len), cpu_to_le64(cache_seq++), cpu_to_le64(ns), cpu_to_le64(ram),
+        cpu_to_le64(addr), cpu_to_le64(va),
+    };
+    fwrite(&r, sizeof(r), 1, cache_log);
+}
+
+static void xusb_observe_dc(CPUARMState *env, unsigned op, uint64_t value)
+{
+    ARMCPU *cpu = env_archcpu(env);
+    uint64_t line_size = 4 << ((cpu->ctr >> 16) & 0xf);
+    uint64_t line = value & ~(line_size - 1), pa = UINT64_MAX, ram = UINT64_MAX;
+    uint8_t attrs = 0;
+    CPUTLBEntryFull *full;
+    void *host = NULL;
+    int flags;
+
+    if ((op & 0xf) != 1) {
+        cache_put('S', op, env_cpu(env)->cpu_index, 0, 0, 0, UINT64_MAX, value, value);
+        return;
+    }
+    cache_probing = true;
+    flags = probe_access_full(env, line, 1, MMU_DATA_LOAD, cpu_mmu_index(env_cpu(env), false), true, &host, &full, 0);
+    cache_probing = false;
+    if (!(flags & TLB_INVALID_MASK)) {
+        ram_addr_t offset;
+        MemoryRegion *mr = host ? memory_region_from_host(host, &offset) : NULL;
+
+        pa = (full->phys_addr & TARGET_PAGE_MASK) | (line & ~TARGET_PAGE_MASK);
+        attrs = full->extra.arm.pte_attrs;
+        ram = mr ? memory_region_get_ram_addr(mr) + offset : UINT64_MAX;
+    }
+    cache_put('D', op, env_cpu(env)->cpu_index, attrs, line_size, 0, ram, pa, line);
+}
+
+/*
+ * 'M': a translation the CPU installed for a page the controller has touched (its VA, PA, MAIR attribute, vCPU, MMU
+ * index and the PC of the block that touched it). The TLBs are flushed after each transfer, so the CPU's next access to the page refills its entry and
+ * shows the mapping, cacheable or not, through which it read or wrote the transfer's data.
+ */
+static void xusb_observe_tlb_fill(CPUState *cpu, int mmu_idx, vaddr addr, CPUTLBEntryFull *full)
+{
+    uint64_t page = full->phys_addr & TARGET_PAGE_MASK;
+
+    if (!cache_probing && g_hash_table_contains(cache_watched, GUINT_TO_POINTER(page >> TARGET_PAGE_BITS))) {
+        /*
+         * The time field carries the PC (the start of the translation block whose access missed the TLB) and the
+         * RAM field the link register, which names the caller of a leaf such as memmove.
+         */
+        cache_put('M', mmu_idx, cpu->cpu_index, full->extra.arm.pte_attrs, TARGET_PAGE_SIZE, cpu_env(cpu)->pc,
+                  cpu_env(cpu)->xregs[30], page, addr & TARGET_PAGE_MASK);
+    }
+}
+
+static void xusb_observe_dma(QEMUSGList *sgl, bool wrote, uint64_t bytes, unsigned slotid, unsigned epid)
+{
+    CPUState *cs;
+
+    RCU_READ_LOCK_GUARD();
+    for (int i = 0; i < sgl->nsg && bytes; i++) {
+        dma_addr_t iova = sgl->sg[i].base;
+        dma_addr_t left = MIN(sgl->sg[i].len, bytes);
+
+        bytes -= left;
+        while (left) {
+            hwaddr xlat, plen = left;
+            MemoryRegion *mr = address_space_translate(sgl->as, iova, &xlat, &plen, wrote, MEMTXATTRS_UNSPECIFIED);
+            bool ram_backed = memory_region_is_ram(mr);
+            uint64_t ram = ram_backed ? memory_region_get_ram_addr(mr) + xlat : UINT64_MAX;
+            uint64_t gpa = ram_backed ? mr->addr + xlat : UINT64_MAX;
+
+            if (!plen) {
+                break;
+            }
+            cache_put(wrote ? 'W' : 'R', 0, slotid, epid, plen, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), ram, iova, gpa);
+            for (uint64_t page = gpa >> TARGET_PAGE_BITS; ram_backed && page <= (gpa + plen - 1) >> TARGET_PAGE_BITS;
+                 page++) {
+                g_hash_table_add(cache_watched, GUINT_TO_POINTER(page));
+            }
+            iova += plen;
+            left -= plen;
+        }
+    }
+    CPU_FOREACH(cs) {
+        tlb_flush(cs);
+    }
+}
+
+static void xusb_set_cache_log(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    g_autofree char *path = NULL;
+
+    if (!visit_type_str(v, name, &path, errp)) {
+        return;
+    }
+    cache_log = fopen(path, "wb");
+    if (!cache_log) {
+        error_setg_errno(errp, errno, "tegra.xusb: cannot open the cache log %s", path);
+        return;
+    }
+    cache_watched = g_hash_table_new(NULL, NULL);
+    arm_dc_observer = xusb_observe_dc;
+    xhci_dma_observer = xusb_observe_dma;
+    tlb_fill_observer = xusb_observe_tlb_fill;
+}
+
