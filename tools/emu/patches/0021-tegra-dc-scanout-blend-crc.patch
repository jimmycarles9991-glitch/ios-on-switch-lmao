+static void tegra_dc_crc_control(tegra_dc *s, uint32_t old)
+{
+    com_crc_control_t was = { .reg32 = old }, now = s->dc.com_crc_control;
+
+    if (!was.crc_enable && now.crc_enable) {
+        s->dc.com_crc_checksum.reg32 = 0;
+        s->dc.com_crc_checksum_latched.reg32 = 0;
+        s->crc_done = false;
+        s->crc_wait = !now.crc_always && now.crc_wait;
+    }
+}
+
+/*
+ * COM_CRC_CONTROL takes effect at a frame boundary, and both CRC_CHECKSUM and CRC_CHECKSUM_LATCHED take a frame's CRC
+ * at its frame end. After ENABLE the first frame end reads 0 and the second the first frame's CRC, as on the Switch's
+ * DC A (its plane probe's first CRC latches at frame end 2). Without ALWAYS one frame is taken, after CRC_WAIT's extra
+ * frame. FULL_FRAME (blanking and sync included) is taken as ACTIVE_DATA.
+ */
+static void tegra_dc_crc_frame(tegra_dc *s)
+{
+    com_crc_control_t control = s->dc.com_crc_control;
+
+    if (s->crc_running) {
+        tegra_dc_render(s);
+        s->dc.com_crc_checksum.reg32 = dc_scanout_crc(&s->scanout);
+        s->dc.com_crc_checksum_latched.reg32 = s->dc.com_crc_checksum.reg32;
+        s->crc_done = !control.crc_always;
+    }
+    s->crc_running = false;
+    if (!control.crc_enable || s->crc_done) {
+        return;
+    }
+    if (s->crc_wait) {
+        s->crc_wait--;
+        return;
+    }
+    s->crc_running = true;
+}
