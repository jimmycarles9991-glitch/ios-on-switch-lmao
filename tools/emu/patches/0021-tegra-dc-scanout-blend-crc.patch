+/*
+ * Tegra X1 display controller scanout: windows fetched, converted and blended as the panel would get them.
+ *
+ *  This program is free software; you can redistribute it and/or modify it
+ *  under the terms of the GNU General Public License as published by the
+ *  Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+#ifndef TEGRA_DC_SCANOUT_H
+#define TEGRA_DC_SCANOUT_H
+
+#include "window.h"
+
+#define DC_SCANOUT_WINDOWS 5
+
+typedef struct DcPlane {
+    uint8_t *data;
+    size_t size;
+    uint32_t x0, y0;
+    uint32_t bytes, lines;
+} DcPlane;
+
+typedef struct DcScanout {
+    uint32_t width, height;
+    uint32_t *pixels;
+    DcPlane plane[2];
+    uint64_t fault[DC_SCANOUT_WINDOWS];
+    uint32_t unsupported[DC_SCANOUT_WINDOWS];
+} DcScanout;
+
+/* The active state of `windows` over `background` (DISP_BLEND_BACKGROUND_COLOR) into out->pixels, A8R8G8B8. */
+void dc_scanout_render(DcScanout *out, uint32_t width, uint32_t height, uint32_t background,
+                       display_window *windows, int count);
+
+/* CRC-32C of the rendered frame's active pixels as the panel gets them: R, G, B bytes, line by line. */
+uint32_t dc_scanout_crc(const DcScanout *out);
+
+#endif
