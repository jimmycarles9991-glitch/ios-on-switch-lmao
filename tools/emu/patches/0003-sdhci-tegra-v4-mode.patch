@@ -325,6 +325,45 @@ static void sdhci_data_transfer(void *opaque);
 
 #define BLOCK_SIZE_MASK (4 * KiB - 1)
 
+/*
+ * Host Version 4 mode (HOST_CONTROL2 bit 12, SD Host Controller spec 4.10): SDMA takes its 64-bit address from the
+ * ADMA System Address register, and register 0x00 becomes the 32-bit block count / Auto CMD23 argument.
+ */
+static bool sdhci_v4_mode(SDHCIState *s)
+{
+    return s->hostctl2 & (1 << 12);
+}
+
+static bool sdhci_v4_64bit(SDHCIState *s)
+{
+    return sdhci_v4_mode(s) && (s->hostctl2 & (1 << 13));
+}
+
+static hwaddr sdhci_sdma_addr(SDHCIState *s)
+{
+    return sdhci_v4_mode(s) ? (hwaddr)s->admasysaddr : s->sdmasysad;
+}
+
+static void sdhci_sdma_advance(SDHCIState *s, unsigned int bytes)
+{
+    if (sdhci_v4_mode(s)) {
+        s->admasysaddr += bytes;
+    } else {
+        s->sdmasysad += bytes;
+    }
+}
+
+static void sdhci_auto_cmd23(SDHCIState *s)
+{
+    SDRequest request = { .cmd = 23, .arg = s->sdmasysad };
+    uint8_t response[16];
+
+    if (sdbus_do_command(&s->sdbus, &request, response) != 4) {
+        s->acmd12errsts |= R_SDHC_ACMD12ERRSTS_TIMEOUT_ERR_MASK;
+        s->errintsts |= SDHC_EIS_CMD12ERR;
+    }
+}
+
 static void sdhci_send_command(SDHCIState *s)
 {
     SDRequest request;
