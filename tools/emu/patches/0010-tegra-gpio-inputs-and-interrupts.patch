@@ -366,8 +425,12 @@ static void tegra_gpio_priv_reset(DeviceState *dev)
             tegra_gpio_port *p = &s->regs[bank * PORTS_NB + port];
 
             p->gpio_in.reg32 = s->reset_values[bank][port];
+            s->pad[bank * PORTS_NB + port] = tegra_gpio_pad_level(s, bank * PORTS_NB + port);
         }
     }
+    for (i = 0; i < BANKS_NB; i++) {
+        qemu_set_irq(s->irq[i], 0);
+    }
 }
 
 static const MemoryRegionOps tegra_gpio_mem_ops = {
@@ -400,6 +463,13 @@ static void tegra_gpio_priv_realize(DeviceState *dev, Error **errp)
 
     for (i = 0; i < s->num_banks; i++)
         sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq[i]);
+    qdev_init_gpio_in(dev, tegra_gpio_set_input, BANKS_NB * PORTS_NB * 8);
+    /* Pads take their external level once: devices drive theirs from their own resets, in any order. */
+    for (int bank = 0; bank < BANKS_NB; bank++) {
+        for (int port = 0; port < PORTS_NB; port++) {
+            s->external[bank * PORTS_NB + port] = s->reset_values[bank][port];
+        }
+    }
 }
 
