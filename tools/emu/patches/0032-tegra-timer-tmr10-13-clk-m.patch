diff --git a/hw/arm/tegra2/tegrax1.c b/hw/arm/tegra2/tegrax1.c
index bea4634..22bef40 100644
--- a/hw/arm/tegra2/tegrax1.c
+++ b/hw/arm/tegra2/tegrax1.c
@@ -585,9 +585,20 @@ static void* tegra_init_obj_simple(hwaddr base, qemu_irq irq, const char *name,
     return tmpdev;
 }
 
+/*
+ * TMR0-9 count TIMERUS's 1 MHz; TMR10-13, the per-core timers Tegra210 added, count the timer clock itself, clk_m
+ * (Linux timer-tegra.c tegra_rate_for_timer, L4T tegra210_timer.c).
+ */
 static void* tegra_init_timer(hwaddr base, qemu_irq irq, uint32_t id)
 {
-    return tegra_init_obj(base, irq, "tegra.timer", "id", id, false);
+    void* tmpdev = qdev_new("tegra.timer");
+    qdev_prop_set_uint32(tmpdev, "id", id);
+    qdev_prop_set_uint32(tmpdev, "freq", id >= 10 ? SYSTEM_TICK_FREQ : 1000000);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(tmpdev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(tmpdev), 0, base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(tmpdev), 0, irq);
+
+    return tmpdev;
 }
 
