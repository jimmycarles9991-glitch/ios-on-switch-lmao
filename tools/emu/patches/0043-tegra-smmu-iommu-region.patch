@@ -32,5 +33,18 @@ enum tegra_smmu_result {
  */
 enum tegra_smmu_result tegra_smmu_translate(const TegraSmmuClient *client, uint64_t address, hwaddr *pa,
                                             unsigned *asid);
+/* As tegra_smmu_translate, for a read or a write: a write also faults on a page entry without WRITE (bit 30). */
+enum tegra_smmu_result tegra_smmu_translate_access(const TegraSmmuClient *client, uint64_t address, bool write,
+                                                   hwaddr *pa, unsigned *asid);
+
+/* A DMA master's view of memory through the SMMU: its read and write clients, translated per access. */
+#define TYPE_TEGRA_SMMU_IOMMU "tegra.smmu-iommu"
+typedef struct TegraSmmuIommu {
+    IOMMUMemoryRegion parent_obj;
+    TegraSmmuClient read, write;
+} TegraSmmuIommu;
+
+void tegra_smmu_iommu_init(TegraSmmuIommu *iommu, Object *owner, const char *name, TegraSmmuClient read,
+                           TegraSmmuClient write);
 
 #endif
