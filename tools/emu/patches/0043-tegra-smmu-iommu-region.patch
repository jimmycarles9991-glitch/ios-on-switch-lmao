diff --git a/hw/arm/tegra2/axi/mc/smmu_iommu.c b/hw/arm/tegra2/axi/mc/smmu_iommu.c
new file mode 100644
index 0000000..cd98691
--- /dev/null
+++ b/hw/arm/tegra2/axi/mc/smmu_iommu.c
@@ -0,0 +1,69 @@
+/*
+ * Tegra X1 SMMU as an IOMMU memory region for a DMA master.
+ *
+ *  This program is free software; you can redistribute it and/or modify it
+ *  under the terms of the GNU General Public License as published by the
+ *  Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "exec/address-spaces.h"
+
+#include "tegra_smmu.h"
+
+static IOMMUTLBEntry tegra_smmu_iommu_translate(IOMMUMemoryRegion *mr, hwaddr addr, IOMMUAccessFlags flag,
+                                                int iommu_idx)
+{
+    TegraSmmuIommu *iommu = container_of(mr, TegraSmmuIommu, parent_obj);
+    bool write = flag & IOMMU_WO;
+    IOMMUTLBEntry entry = {
+        .target_as = &address_space_memory,
+        .iova = addr & ~(hwaddr)0xfff,
+        .addr_mask = 0xfff,
+        .perm = IOMMU_NONE,
+    };
+    hwaddr pa;
+    unsigned asid;
+
+    if (tegra_smmu_translate_access(write ? &iommu->write : &iommu->read, addr, write, &pa, &asid) ==
+        TEGRA_SMMU_FAULT) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: SMMU fault on a %s at %#" HWADDR_PRIx " (ASID %u)\n",
+                      memory_region_name(MEMORY_REGION(mr)), write ? "write" : "read", addr, asid);
+        return entry;
+    }
+    entry.translated_addr = pa & ~(hwaddr)0xfff;
+    entry.perm = write ? IOMMU_WO : IOMMU_RO;
+    return entry;
+}
+
+void tegra_smmu_iommu_init(TegraSmmuIommu *iommu, Object *owner, const char *name, TegraSmmuClient read,
+                           TegraSmmuClient write)
+{
+    memory_region_init_iommu(iommu, sizeof(*iommu), TYPE_TEGRA_SMMU_IOMMU, owner, name, UINT64_MAX);
+    iommu->read = read;
+    iommu->write = write;
+}
+
+static void tegra_smmu_iommu_class_init(ObjectClass *klass, void *data)
+{
+    IOMMUMemoryRegionClass *imrc = IOMMU_MEMORY_REGION_CLASS(klass);
+
+    imrc->translate = tegra_smmu_iommu_translate;
+}
+
+static const TypeInfo tegra_smmu_iommu_info = {
+    .name          = TYPE_TEGRA_SMMU_IOMMU,
+    .parent        = TYPE_IOMMU_MEMORY_REGION,
+    .instance_size = sizeof(TegraSmmuIommu),
+    .class_init    = tegra_smmu_iommu_class_init,
+};
+
+static void tegra_smmu_iommu_register_types(void)
+{
+    type_register_static(&tegra_smmu_iommu_info);
+}
+
+type_init(tegra_smmu_iommu_register_types)
