+ *  with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/* Register map and behaviour from TDK DS-000451 (ICM-42670-P, which the ICM-42607-P shares) and TDK's
+ * inv_imu_driver: user bank 0 directly, MREG1-3 through BLK_SEL/MADDR/M_W/M_R, a FIFO of 16-byte records, and
+ * data-ready / FIFO-threshold interrupts latched on INT2 until their status register is read. The console lies flat,
+ * screen up and still: the accelerometer reads +1 g on Z, the gyroscope 0. */
+
+#include "qemu/osdep.h"
+#include "hw/ssi/ssi.h"
+#include "hw/irq.h"
+#include "qemu/timer.h"
+#include "qemu/log.h"
+#include "qapi/error.h"
+#include "migration/vmstate.h"
+#include "qom/object.h"
+
+#define TYPE_ICM42607P "icm42607p"
+OBJECT_DECLARE_SIMPLE_TYPE(ICM42607PState, ICM42607P)
+
+#define REG_MCLK_RDY           0x00
+#define REG_DEVICE_CONFIG      0x01
+#define REG_SIGNAL_PATH_RESET  0x02
+#define REG_DRIVE_CONFIG3      0x05
+#define REG_TEMP_DATA1         0x09
+#define REG_ACCEL_DATA_X1      0x0b
+#define REG_PWR_MGMT0          0x1f
+#define REG_GYRO_CONFIG0       0x20
+#define REG_ACCEL_CONFIG0      0x21
+#define REG_TEMP_CONFIG0       0x22
+#define REG_GYRO_CONFIG1       0x23
+#define REG_ACCEL_CONFIG1      0x24
+#define REG_FIFO_CONFIG1       0x28
+#define REG_FIFO_CONFIG2       0x29
+#define REG_FIFO_CONFIG3       0x2a
+#define REG_INT_SOURCE0        0x2b
+#define REG_INT_SOURCE3        0x2d
+#define REG_INTF_CONFIG0       0x35
+#define REG_INTF_CONFIG1       0x36
+#define REG_INT_STATUS_DRDY    0x39
+#define REG_INT_STATUS         0x3a
+#define REG_FIFO_COUNTH        0x3d
+#define REG_FIFO_COUNTL        0x3e
+#define REG_FIFO_DATA          0x3f
+#define REG_WHO_AM_I           0x75
+#define REG_BLK_SEL_W          0x79
+#define REG_MADDR_W            0x7a
+#define REG_M_W                0x7b
+#define REG_BLK_SEL_R          0x7c
+#define REG_MADDR_R            0x7d
+#define REG_M_R                0x7e
+
+#define WHO_AM_I_ICM42607P     0x60
+#define MCLK_RDY               BIT(3)
+#define SOFT_RESET             BIT(4)
+#define FIFO_FLUSH             BIT(2)
+#define FIFO_BYPASS            BIT(0)
+#define FIFO_STOP_ON_FULL      BIT(1)
+#define INT_DRDY               BIT(0)
+#define INT_RESET_DONE         BIT(4)
+#define INT_FIFO_THS           BIT(2)
+#define INT_FIFO_FULL          BIT(1)
+#define SRC_DRDY               BIT(3)
+#define SRC_FIFO_THS           BIT(2)
+#define SRC_FIFO_FULL          BIT(1)
+#define DATA_BIG_ENDIAN        BIT(4)
+#define COUNT_BIG_ENDIAN       BIT(5)
+#define COUNT_RECORDS          BIT(6)
+#define MREG1_FIFO_CONFIG5     0x01
+#define FIFO_WM_GT_TH          BIT(5)
+#define FIFO_GYRO_EN           BIT(1)
+#define FIFO_ACCEL_EN          BIT(0)
+
+#define RECORD_BYTES 16
+#define FIFO_RECORDS 144
+#define MREG_BLOCKS  3
+
+struct ICM42607PState {
+    SSIPeripheral parent_obj;
+    qemu_irq int2;
+    QEMUTimer *timer;
+    uint8_t regs[128];
+    uint8_t mreg[MREG_BLOCKS][256];
+    uint8_t fifo[FIFO_RECORDS][RECORD_BYTES];
+    uint32_t fifo_head, fifo_count, fifo_byte;
+    uint8_t address;
+    bool addressed, reading;
+    uint16_t timestamp;
+};
+
+static const uint8_t icm42607p_resets[][2] = {
+    {REG_DEVICE_CONFIG, 0x04}, {REG_DRIVE_CONFIG3, 0x05}, {REG_GYRO_CONFIG0, 0x69}, {REG_ACCEL_CONFIG0, 0x69},
+    {REG_TEMP_CONFIG0, 0x40}, {REG_GYRO_CONFIG1, 0x31}, {REG_ACCEL_CONFIG1, 0x41}, {REG_FIFO_CONFIG1, FIFO_BYPASS},
+    {REG_INT_SOURCE0, 0x10}, {REG_INTF_CONFIG0, DATA_BIG_ENDIAN | COUNT_BIG_ENDIAN}, {REG_INTF_CONFIG1, 0x01},
+    {REG_WHO_AM_I, WHO_AM_I_ICM42607P},
+};
+
+static int icm42607p_block(uint8_t blk_sel)
+{
+    switch (blk_sel) {
+    case 0x00:
+        return 0;
+    case 0x28:
+        return 1;
+    case 0x50:
+        return 2;
+    default:
+        return -1;
+    }
+}
+
+static void icm42607p_update_int2(ICM42607PState *s)
+{
+    uint8_t source = s->regs[REG_INT_SOURCE3];
+    bool level = ((source & SRC_DRDY) && (s->regs[REG_INT_STATUS_DRDY] & INT_DRDY)) ||
+                 ((source & SRC_FIFO_THS) && (s->regs[REG_INT_STATUS] & INT_FIFO_THS)) ||
+                 ((source & SRC_FIFO_FULL) && (s->regs[REG_INT_STATUS] & INT_FIFO_FULL));
+    qemu_set_irq(s->int2, level);
+}
+
+/* GYRO/ACCEL_CONFIG0 ODR codes 5..15: 1600 Hz halving down to 1.5625 Hz. */
+static int64_t icm42607p_period_ns(uint8_t config0)
+{
+    unsigned code = config0 & 0xf;
+
+    if (code < 5) {
+        code = 5;
+    }
+    return (int64_t)(NANOSECONDS_PER_SECOND / 1600) << (code - 5);
+}
+
+static bool icm42607p_accel_on(ICM42607PState *s)
+{
+    return (s->regs[REG_PWR_MGMT0] & 3) >= 2;
+}
+
+static bool icm42607p_gyro_on(ICM42607PState *s)
+{
+    return ((s->regs[REG_PWR_MGMT0] >> 2) & 3) == 3;
+}
+
+static void icm42607p_schedule(ICM42607PState *s)
+{
+    if (!icm42607p_accel_on(s) && !icm42607p_gyro_on(s)) {
+        timer_del(s->timer);
+        return;
+    }
+    if (!timer_pending(s->timer)) {
+        uint8_t config0 = s->regs[icm42607p_gyro_on(s) ? REG_GYRO_CONFIG0 : REG_ACCEL_CONFIG0];
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + icm42607p_period_ns(config0));
+    }
+}
+
+static void icm42607p_put16(uint8_t *at, int16_t value, bool big_endian)
+{
+    at[big_endian ? 0 : 1] = (uint16_t)value >> 8;
+    at[big_endian ? 1 : 0] = (uint16_t)value & 0xff;
+}
+
+static uint32_t icm42607p_watermark(ICM42607PState *s)
+{
+    return s->regs[REG_FIFO_CONFIG2] | ((s->regs[REG_FIFO_CONFIG3] & 0xf) << 8);
+}
+
+static void icm42607p_push_record(ICM42607PState *s, const int16_t sample[6])
+{
+    uint8_t enables = s->mreg[0][MREG1_FIFO_CONFIG5];
+    uint8_t *record;
+
+    if (s->regs[REG_FIFO_CONFIG1] & FIFO_BYPASS || !(enables & (FIFO_ACCEL_EN | FIFO_GYRO_EN))) {
+        return;
+    }
+    if (s->fifo_count == FIFO_RECORDS) {
+        s->regs[REG_INT_STATUS] |= INT_FIFO_FULL;
+        if (s->regs[REG_FIFO_CONFIG1] & FIFO_STOP_ON_FULL) {
+            return;
+        }
+        s->fifo_head = (s->fifo_head + 1) % FIFO_RECORDS;
+        s->fifo_count--;
+        s->fifo_byte = 0;
+    }
+    record = s->fifo[(s->fifo_head + s->fifo_count) % FIFO_RECORDS];
+    memset(record, 0, RECORD_BYTES);
+    record[0] = ((enables & FIFO_ACCEL_EN) ? 0x40 : 0) | ((enables & FIFO_GYRO_EN) ? 0x20 : 0);
+    for (int i = 0; i < 6; i++) {
+        bool on = i < 3 ? icm42607p_accel_on(s) : icm42607p_gyro_on(s);
+        icm42607p_put16(&record[1 + 2 * i], on ? sample[i] : INT16_MIN, true);
+    }
+    record[13] = 0;
+    icm42607p_put16(&record[14], (int16_t)s->timestamp, true);
+    s->fifo_count++;
+    if (s->fifo_count >= icm42607p_watermark(s) && icm42607p_watermark(s)) {
+        s->regs[REG_INT_STATUS] |= INT_FIFO_THS;
+    }
+}
+
+static void icm42607p_tick(void *opaque)
+{
+    ICM42607PState *s = opaque;
+    bool big = s->regs[REG_INTF_CONFIG0] & DATA_BIG_ENDIAN;
+    int16_t sample[6] = {0};
+
+    /* FS_SEL 6:5: 0 = 16 g (2048 LSB/g), 1 = 8 g, 2 = 4 g, 3 = 2 g. */
+    sample[2] = (int16_t)(2048 << ((s->regs[REG_ACCEL_CONFIG0] >> 5) & 3));
+    for (int i = 0; i < 6; i++) {
+        icm42607p_put16(&s->regs[REG_ACCEL_DATA_X1 + 2 * i], sample[i], big);
+    }
+    s->timestamp += 1;
+    s->regs[REG_INT_STATUS_DRDY] |= INT_DRDY;
+    icm42607p_push_record(s, sample);
+    icm42607p_update_int2(s);
+    icm42607p_schedule(s);
+}
+
+static void icm42607p_reset_registers(ICM42607PState *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->mreg, 0, sizeof(s->mreg));
+    for (size_t i = 0; i < ARRAY_SIZE(icm42607p_resets); i++) {
+        s->regs[icm42607p_resets[i][0]] = icm42607p_resets[i][1];
+    }
+    s->mreg[0][MREG1_FIFO_CONFIG5] = FIFO_WM_GT_TH;
+    s->regs[REG_INT_STATUS] = INT_RESET_DONE;
+    s->fifo_head = s->fifo_count = s->fifo_byte = 0;
+    timer_del(s->timer);
+    icm42607p_update_int2(s);
+}
+
+static uint8_t icm42607p_fifo_byte(ICM42607PState *s)
+{
+    uint8_t value;
+
+    if (!s->fifo_count) {
+        return s->fifo_byte++ ? 0 : 0x80;
+    }
+    value = s->fifo[s->fifo_head][s->fifo_byte];
+    if (++s->fifo_byte == RECORD_BYTES) {
+        s->fifo_byte = 0;
+        s->fifo_head = (s->fifo_head + 1) % FIFO_RECORDS;
+        s->fifo_count--;
+    }
+    return value;
+}
+
+static uint8_t icm42607p_read(ICM42607PState *s, uint8_t reg)
+{
+    uint8_t value = s->regs[reg];
+    uint32_t count;
+    int block;
+
+    switch (reg) {
+    case REG_MCLK_RDY:
+        return (icm42607p_accel_on(s) || icm42607p_gyro_on(s)) ? MCLK_RDY : 0;
+    case REG_INT_STATUS_DRDY:
+    case REG_INT_STATUS:
+        s->regs[reg] = 0;
+        icm42607p_update_int2(s);
+        return value;
+    case REG_FIFO_COUNTH:
+    case REG_FIFO_COUNTL:
+        count = (s->regs[REG_INTF_CONFIG0] & COUNT_RECORDS) ? s->fifo_count
+                                                            : s->fifo_count * RECORD_BYTES - s->fifo_byte;
+        if ((reg == REG_FIFO_COUNTH) == !!(s->regs[REG_INTF_CONFIG0] & COUNT_BIG_ENDIAN)) {
+            return count >> 8;
+        }
+        return count & 0xff;
+    case REG_FIFO_DATA:
+        return icm42607p_fifo_byte(s);
+    case REG_M_R:
+        block = icm42607p_block(s->regs[REG_BLK_SEL_R]);
+        return block < 0 ? 0 : s->mreg[block][s->regs[REG_MADDR_R]];
+    default:
+        return value;
+    }
+}
+
+static void icm42607p_write(ICM42607PState *s, uint8_t reg, uint8_t value)
+{
+    int block;
+
+    switch (reg) {
+    case REG_WHO_AM_I:
+    case REG_MCLK_RDY:
+    case REG_INT_STATUS:
+    case REG_INT_STATUS_DRDY:
+    case REG_FIFO_COUNTH:
+    case REG_FIFO_COUNTL:
+        return;
+    case REG_SIGNAL_PATH_RESET:
+        if (value & SOFT_RESET) {
+            icm42607p_reset_registers(s);
+            return;
+        }
+        if (value & FIFO_FLUSH) {
+            s->fifo_head = s->fifo_count = s->fifo_byte = 0;
+        }
+        return;
+    case REG_M_W:
+        block = icm42607p_block(s->regs[REG_BLK_SEL_W]);
+        if (block >= 0) {
+            s->mreg[block][s->regs[REG_MADDR_W]] = value;
+        }
+        return;
+    case REG_FIFO_CONFIG1:
+        if ((value & FIFO_BYPASS) && !(s->regs[reg] & FIFO_BYPASS)) {
+            s->fifo_head = s->fifo_count = s->fifo_byte = 0;
+        }
+        break;
+    default:
+        break;
+    }
+    s->regs[reg] = value;
+    if (reg == REG_PWR_MGMT0 || reg == REG_GYRO_CONFIG0 || reg == REG_ACCEL_CONFIG0) {
+        timer_del(s->timer);
+        icm42607p_schedule(s);
+    }
+    if (reg == REG_INT_SOURCE3) {
+        icm42607p_update_int2(s);
+    }
+}
+
+/* SPI: the first byte is R/W (bit 7) and the address; the address then increments, except on FIFO_DATA and M_R. */
+static uint32_t icm42607p_transfer(SSIPeripheral *dev, uint32_t value)
+{
+    ICM42607PState *s = ICM42607P(dev);
+    uint8_t reg;
+    uint32_t out = 0;
+
+    if (!s->addressed) {
+        s->addressed = true;
+        s->reading = value & 0x80;
+        s->address = value & 0x7f;
+        return 0;
+    }
+    reg = s->address;
+    if (s->reading) {
+        out = icm42607p_read(s, reg);
+    } else {
+        icm42607p_write(s, reg, value);
+    }
+    if (reg != REG_FIFO_DATA && reg != REG_M_R && reg != REG_M_W) {
+        s->address = (s->address + 1) & 0x7f;
+    }
+    return out;
+}
+
+static int icm42607p_set_cs(SSIPeripheral *dev, bool level)
+{
+    ICM42607PState *s = ICM42607P(dev);
+
+    if (level) {
+        s->addressed = false;
+    }
+    return 0;
+}
+
+static void icm42607p_realize(SSIPeripheral *dev, Error **errp)
+{
+    ICM42607PState *s = ICM42607P(dev);
+
+    qdev_init_gpio_out_named(DEVICE(dev), &s->int2, "int2", 1);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, icm42607p_tick, s);
+}
+
+static void icm42607p_reset(DeviceState *dev)
+{
+    ICM42607PState *s = ICM42607P(dev);
+
+    s->addressed = false;
+    s->timestamp = 0;
+    icm42607p_reset_registers(s);
+}
+
+static const VMStateDescription vmstate_icm42607p = {
+    .name = TYPE_ICM42607P,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, ICM42607PState),
+        VMSTATE_UINT8_ARRAY(regs, ICM42607PState, 128),
+        VMSTATE_UINT8_2DARRAY(mreg, ICM42607PState, MREG_BLOCKS, 256),
+        VMSTATE_UINT8_2DARRAY(fifo, ICM42607PState, FIFO_RECORDS, RECORD_BYTES),
+        VMSTATE_UINT32(fifo_head, ICM42607PState),
+        VMSTATE_UINT32(fifo_count, ICM42607PState),
+        VMSTATE_UINT32(fifo_byte, ICM42607PState),
+        VMSTATE_UINT8(address, ICM42607PState),
+        VMSTATE_BOOL(addressed, ICM42607PState),
+        VMSTATE_BOOL(reading, ICM42607PState),
+        VMSTATE_UINT16(timestamp, ICM42607PState),
+        VMSTATE_TIMER_PTR(timer, ICM42607PState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void icm42607p_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = icm42607p_realize;
+    k->transfer = icm42607p_transfer;
+    k->set_cs = icm42607p_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    dc->vmsd = &vmstate_icm42607p;
+    device_class_set_legacy_reset(dc, icm42607p_reset);
+}
+
+static const TypeInfo icm42607p_info = {
+    .name = TYPE_ICM42607P,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(ICM42607PState),
+    .class_init = icm42607p_class_init,
+};
+
+static void icm42607p_register_types(void)
+{
+    type_register_static(&icm42607p_info);
+}
+
+type_init(icm42607p_register_types)
