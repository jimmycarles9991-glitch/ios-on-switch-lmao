@@ -375,6 +419,11 @@ static void tegra_flow_run_cpu(int cpu_id)
     if (tegra_cpu_is_powergated(cpu_id)) {
         tegra_cpu_unpowergate(cpu_id);
         tegra_pmc_update_crail();
