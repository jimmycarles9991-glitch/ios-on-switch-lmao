 } tegra_flow_timer_arg;
 
+/*
+ * Whether the GIC distributor has an enabled, pending SGI or SPI for a CCPLEX core, whatever its CPU interface says: the
+ * GIC-400's per-core outputs reach the flow controller even with the interface off or the core power-gated (C7).
+ */
+static int tegra_flow_gic_pending(int cpu_id)
+{
+    GICState *s = gic_dev;
+
+    for (int i = 0; i < INT_GIC_NR; i++) {
+        if (i == GIC_NR_SGIS) {
+            i = GIC_INTERNAL;  /* the core's own PPIs (its timers) are off with it */
+        }
+        if (GIC_DIST_TEST_ENABLED(i, 1 << cpu_id) && gic_test_pending(s, i, 1 << cpu_id)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/*
+ * Tegra X1 halt events: bit 8 GIC FIQ, bit 9 GIC IRQ, bit 10 LIC FIQ, bit 11 LIC IRQ, each for the core itself (the
+ * Tegra 2 layout this model was written for had per-processor IRQ/FIQ bits there instead).
+ */
+static int tegra_flow_x1_irq_events(tegra_flow *s, int cpu_id)
+{
+    return tegra_board >= TEGRAX1_BOARD && cpu_id != TEGRA_BPMP &&
+           (s->halt_events[cpu_id].reg32 & (0xF << 8));
+}
+
+static int tegra_flow_x1_wake(tegra_flow *s, int cpu_id)
+{
+    halt_events_t ev = s->halt_events[cpu_id];
+
+    if ((ev.fiq_0 || ev.fiq_1) && tegra_flow_gic_pending(cpu_id)) {
+        return 1;
+    }
+    return (ev.irq_0 || ev.irq_1) && tegra_ictlr_is_irq_pending_on_cpu(cpu_id);
+}
+
