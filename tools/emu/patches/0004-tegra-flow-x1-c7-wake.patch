+/*
+ * The distributor's wake request for a core whose CPU interface is off, as the GIC-400's power-management outputs give
+ * it to a power controller: SGIs and SPIs only, since a core's own PPIs (its timers) stop when it powers down.
+ */
+static bool gic_wake_pending(GICState *s, int cpu)
+{
+    int cm = 1 << cpu;
+
+    for (int irq = 0; irq < s->num_irq; irq++) {
+        if (irq == GIC_NR_SGIS) {
+            irq = GIC_INTERNAL;
+        }
+        if (irq < s->num_irq && GIC_DIST_TEST_ENABLED(irq, cm) && gic_test_pending(s, irq, cm) &&
+            (irq < GIC_INTERNAL ? true : (GIC_DIST_TARGET(irq) & cm) != 0)) {
+            return true;
+        }
+    }
+    return false;
+}
