+/* SuperSpeed port 0 (USB-C) has its lane only while the pad controller gives UPHY lane 5 to XUSB, out of IDDQ and its
+ * clamps, mapped to USB2 port 0 with the UPHY PLL locked; without it a device falls back to USB 2.0. */
+static void tegra_xusb_follow_ss_lane(tegra_xusb *s)
+{
+    uint32_t mux = s->regs_padctl[PADCTL_USB3_PAD_MUX >> 2];
+    bool up = (mux & PAD_MUX_LANE_MASK(SS_LANE)) == PAD_MUX_LANE_XUSB(SS_LANE) &&
+              (mux & PAD_MUX_IDDQ_DISABLE(SS_LANE)) &&
+              !(s->regs_padctl[PADCTL_ELPG_PROGRAM_1 >> 2] & ELPG_SSP0_CLAMPS) &&
+              !(s->regs_padctl[PADCTL_SS_PORT_MAP >> 2] & SS_PORT_MAP_PORT0) &&
+              (s->regs_padctl[PADCTL_UPHY_PLL_P0_CTL1 >> 2] & UPHY_PLL_LOCKDET);
+    USBPort *port = &s->parent_obj.xhci.uports[0];
+    int speedmask = USB_SPEED_MASK_LOW | USB_SPEED_MASK_FULL | USB_SPEED_MASK_HIGH | (up ? USB_SPEED_MASK_SUPER : 0);
+    Error *err = NULL;
+
+    if (port->speedmask == speedmask) {
+        return;
+    }
+    port->speedmask = speedmask;
+    if (port->dev && port->dev->attached) {
+        usb_device_detach(port->dev);
+        usb_device_attach(port->dev, &err);
+        if (err) {
+            error_report_err(err);
