# Host tests of tools/package's Python packaging steps, each over only the module it tests.
#
#   bazel test //tools/package/test:all
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

lint_files()

# native_xnu_layout.py (the kernel window's Mach-O segment layout) against independently encoded binary fixtures.
py_test(
    name = "native_xnu_layout_test",
    size = "small",
    srcs = ["native_xnu_layout_test.py"],
    deps = ["//tools/package:native_xnu_layout"],
)

# bl33.bin as composed (build_native_loader.py's stage_into_bl33, bl33.py's bl33_patch, boot_script.py): the script,
# loader, exporter and DTB where the environment and the script read them, every memory check of the script holds, and
# U-Boot's bytes are untouched apart from its default environment. The loader's decoder reading the window back is
# //boot/loader/test:bl33_window_test.
py_test(
    name = "bl33_stage_test",
    size = "small",
    srcs = ["bl33_stage_test.py"],
    data = [
        "//bazel/pinned:firmware/bl33.bin",
        "//bazel/pinned:firmware/exporter.uimg",
        "//bazel/pinned:firmware/oled-sku3.dtb",
        "//boot:u-boot-script.txt",
        "//tools:lz4",
    ],
    # compress_window runs lz4 from PATH: //tools:lz4, by its runfiles path (relative to the test's working directory).
    env = {"PATH": "tools:/usr/bin:/bin"},
    deps = [
        "//tools/package:bl33",
        "//tools/package:boot_script",
        "//tools/package:kernel_window",
    ],
)

# adt_edit.py over a minimal Switch tree: the selected IPSW kind's iPad's answers on /arm-io, the root and /product
# (from Apple's tree of it, //ipsw:device_tree), which VideoToolbox and MobileGestalt read before iOS uses a feature.
py_test(
    name = "adt_media_test",
    size = "small",
    srcs = ["adt_media_test.py"],
    data = [
        "//drivers/TegraVIC:TegraVICUserClient.cpp",
        "//ipsw:device_tree",
        "//tools/package:adt_edit.py",
    ],
    deps = [
        "//tools/package:boot_config",
        "//tools/package:loader_abi",
        "//tools/package:native_oled_adt",
        "//tools/package:native_xnu_layout",
        "//tools/trustcache",
        "@rules_python//python/runfiles",
    ],
)

# overlay.py's plan of overlay/manifest.json for each IPSW kind: a "kind" entry (the wallpapers' Wallpaper.plist, whose
# bundle directories only that kind's System volume has) is staged and unioned for that kind alone.
py_test(
    name = "overlay_plan_test",
    size = "small",
    srcs = ["overlay_plan_test.py"],
    data = [
        "//overlay:manifest.json",
        "//tools/package:overlay.py",
    ],
    deps = [
        "//tools/common:macho",
        "//tools/package:boot_config",
        "//tools/trustcache",
        "@rules_python//python/runfiles",
    ],
)
