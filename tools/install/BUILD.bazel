# The SD installer's and deploy's Python: partition table, APFS, card guards, the install itself.
# Entry points are in //install and //deploy; this package holds the code and its unit tests.
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(["to_card.py"])

py_library(
    name = "lib",
    srcs = [
        "apfs.py",
        "apfs_tree.py",
        "card.py",
        "compose.py",
        "cryptex.py",
        "delta.py",
        "direct.py",
        "direct_stream.py",
        "disks.py",
        "extents.py",
        "fill.py",
        "folder.py",
        "gpt.py",
        "host.py",
        "keys.py",
        "manifest.py",
        "overlay_index.py",
        "owners.py",
        "pack.py",
        "populate.py",
        "pretranslate.py",
        "progress.py",
        "renamed.py",
        "room.py",
        "space.py",
        "stages.py",
        "target.py",
        "to_card.py",
    ],
    imports = ["../.."],
    deps = [
        "//tools/common:files",
        "//tools/common:hashing",
        "//tools/common:paths",
        "//tools/common:sudo",
    ],
)

py_binary(
    name = "manifest_vectors",
    srcs = ["manifest_vectors.py"],
    deps = [":lib"],
)

py_binary(
    name = "image",
    srcs = ["image.py"],
    deps = [
        ":lib",
        "@rules_python//python/runfiles",
    ],
)

# Bazel runs it for iOS 27's deltas and translated cryptexes (install/translated.bzl).
py_binary(
    name = "translate",
    srcs = ["translate.py"],
    deps = [":lib"],
)

py_binary(
    name = "sd",
    srcs = ["sd.py"],
    deps = [
        ":lib",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "spec",
    srcs = ["spec.py"],
)

py_binary(
    name = "artifacts",
    srcs = ["artifacts.py"],
    deps = ["//tools/common:hashing"],
)

py_binary(
    name = "fake_boot_package",
    srcs = ["fake_boot_package.py"],
)

py_binary(
    name = "test_member",
    srcs = ["test_member.py"],
)

# `bazel run //tools/install:testcard -- create <image>`: a sparse stand-in for the card (the real partition table).
py_binary(
    name = "testcard",
    srcs = ["testcard.py"],
    data = ["//install:testdata/switch-card-1tb.json"],
    deps = [
        ":lib",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "gpt_test",
    srcs = ["gpt_test.py"],
    data = ["//install:testdata/switch-card-1tb.json"],
    deps = [
        ":lib",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "apfs_test",
    srcs = ["apfs_test.py"],
    deps = [
        ":lib",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "spec_test",
    srcs = ["spec_test.py"],
    data = [
        "//diagnostics/switch:SwitchRawMount.h",
        "//drivers/NativeSwitchBlock:SwitchCryptex.cpp",
        "//drivers/NativeSwitchBlock:SwitchCryptex.h",
        "//drivers/NativeSwitchBlock:NativeSwitchBlock.cpp",
        "//install:ipsw",
        "//kernel:ipsw_volumes_header",
    ],
    deps = [
        ":spec_lib",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "spec_lib",
    srcs = ["spec.py"],
    imports = ["../.."],
)

# Unit tests: Python on files in the test's own temporary directory, inside the sandbox.
[py_test(
    name = name + "_test",
    size = "small",
    srcs = [name + "_test.py"],
    deps = [":lib"],
) for name in [
    "compose",
    "delta",
    "direct",
    "extents",
    "host",
    "keys",
    "manifest",
    "overlay_index",
    "owners",
    "pretranslate",
    "progress",
    "space",
    "to_card",
]]

py_test(
    name = "card_test",
    srcs = ["card_test.py"],
    data = ["//install:testdata/switch-card-1tb.json"],
    deps = [
        ":lib",
        "@rules_python//python/runfiles",
    ],
)

# hdiutil and fsck_apfs on a real 128 MB container: macOS, outside the sandbox.
py_test(
    name = "pack_apfs_test",
    srcs = ["pack_apfs_test.py"],
    tags = [
        "local",
        "manual",
    ],
    deps = [":lib"],
)

# cryptex.rebuild on a sealed stand-in: hdiutil and diskutil, macOS, outside the sandbox.
py_test(
    name = "cryptex_test",
    srcs = ["cryptex_test.py"],
    args = ["$(rootpath //boot/installer:apfs_tool)"],
    data = ["//boot/installer:apfs_tool"],
    tags = [
        "local",
        "manual",
    ],
    deps = [":lib"],
)

# room.fit and apfs_tool on containers newfs_apfs made (a cryptex's kind), checked by macOS: hdiutil, diskutil and
# fsck_apfs work inside darwin-sandbox, so it runs with every test; it skips itself where there is no diskutil.
py_test(
    name = "room_apfs_test",
    srcs = ["room_apfs_test.py"],
    args = ["$(rootpath //boot/installer:apfs_tool)"],
    data = ["//boot/installer:apfs_tool"],
    deps = [":lib"],
)

# Populate as the user on a small composed container: hdiutil and diskutil, macOS, outside the sandbox.
py_test(
    name = "fill_apfs_test",
    srcs = ["fill_apfs_test.py"],
    tags = [
        "local",
        "manual",
    ],
    deps = [":lib"],
)

# Owners given offline on real APFS images, sealed after: hdiutil and diskutil, macOS, outside the sandbox.
py_test(
    name = "owners_apfs_test",
    srcs = ["owners_apfs_test.py"],
    tags = [
        "local",
        "manual",
    ],
    deps = [":lib"],
)

# The direct install onto a disk image built like the card: hdiutil, diskutil, fsck_apfs and apfs_tool, so macOS,
# outside the sandbox.
py_test(
    name = "direct_card_test",
    size = "large",
    srcs = [
        "direct_card_test.py",
        "testcard.py",
    ],
    data = [
        "//boot/installer:apfs_tool",
        "//install:testdata/switch-card-1tb.json",
    ],
    tags = [
        "local",
        "manual",
    ],
    deps = [
        ":lib",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "sii_fixture",
    testonly = True,
    srcs = ["sii_fixture.py"],
    imports = ["../.."],
    deps = [":lib"],
)

py_test(
    name = "folder_test",
    size = "small",
    srcs = ["folder_test.py"],
    deps = [
        ":lib",
        ":sii_fixture",
    ],
)

py_test(
    name = "stages_test",
    size = "small",
    srcs = ["stages_test.py"],
    deps = [
        ":lib",
        ":sii_fixture",
    ],
)
