load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

# The native prelinker's Mach-O reader and plan (SwitchUSB's abi_check reads Mach-O through it too).
py_library(
    name = "native_prelink",
    srcs = ["native_prelink.py"],
    imports = ["."],
    deps = ["//tools/common:macho"],
)

# Prelinks Apple's original kexts into the linked kernel (kernel/rules/kernel.bzl kernel_prelink runs it).
py_binary(
    name = "emit_prelink",
    srcs = ["emit_prelink.py"],
    deps = [
        ":native_prelink",
        "//tools/common:macho",
    ],
)

py_test(
    name = "emit_prelink_options_test",
    size = "small",
    srcs = [
        "emit_prelink.py",
        "emit_prelink_options_test.py",
    ],
    deps = [
        ":native_prelink",
        "//tools/common:macho",
    ],
)
