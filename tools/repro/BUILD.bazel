load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(["*.py"]))

# bazel run //tools/repro:check [-- TARGET...]: two from-scratch builds, every output compared bit for bit.
py_binary(
    name = "check",
    srcs = ["check.py"],
)

# bazel run //tools/repro:cache_check [-- TARGET...]: a second worktree of this commit, built in a fresh output base,
# must execute nothing (every action a disk-cache hit): action keys do not depend on the checkout's or output base's path.
py_binary(
    name = "cache_check",
    srcs = ["cache_check.py"],
)

# bazel run //tools/repro:linkedit -- OLD NEW: two kernel.macho files that may differ only in __LINKEDIT (renamed
# symbols, the UUID the linker derives from them); everything else byte for byte, every symbol at the same place.
py_library(
    name = "linkedit_lib",
    srcs = ["linkedit.py"],
    deps = ["//tools/common:macho"],
)

py_binary(
    name = "linkedit",
    srcs = ["linkedit.py"],
    deps = ["//tools/common:macho"],
)

py_test(
    name = "linkedit_test",
    srcs = ["linkedit_test.py"],
    deps = [":linkedit_lib"],
)
