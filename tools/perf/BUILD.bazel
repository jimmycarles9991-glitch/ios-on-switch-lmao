load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

lint_files()

py_library(
    name = "lib",
    srcs = [
        "cpu.py",
        "dumps.py",
        "gpu.py",
        "host1x.py",
        "ips.py",
        "kprof.py",
        "kprof_fmt.py",
        "ktrace.py",
        "pacing.py",
        "perf.py",
        "recfile.py",
        "report.py",
        "session.py",
        "source.py",
        "symbols.py",
        "vm.py",
        "windows.py",
        "work.py",
    ],
    deps = [
        "//tools/devicerun:lib",
        "//tools/frames:lib",
    ],
)

# bazel run //tools/perf -- pull <absolute folder> | report <absolute .logarchive> --crashes <dir>: one session's report.
# kcdata.py (XNU's stackshot decoder) reads the flight recorder's stackshots; bazel run starts in the runfiles tree.
py_binary(
    name = "perf",
    srcs = ["perf.py"],
    args = ["--kcdata=$(rootpath @xnu_base//:tools/lldbmacros/kcdata.py)"],
    data = ["@xnu_base//:tools/lldbmacros/kcdata.py"],
    deps = [":lib"],
)

py_test(
    name = "perf_test",
    size = "small",
    srcs = ["perf_test.py"],
    data = glob(["testdata/*"]),
    deps = [":lib"],
)

py_test(
    name = "host1x_test",
    size = "small",
    srcs = ["host1x_test.py"],
    deps = [":lib"],
)

py_test(
    name = "cpu_test",
    size = "small",
    srcs = ["cpu_test.py"],
    deps = [":lib"],
)

py_test(
    name = "pacing_test",
    size = "small",
    srcs = ["pacing_test.py"],
    deps = [":lib"],
)

py_test(
    name = "vm_test",
    size = "small",
    srcs = ["vm_test.py"],
    deps = [":lib"],
)

# testdata/Switch-recorder-3.*: one task and one thread's samples cut from a real iOS 27 dump pair.
py_test(
    name = "dumps_test",
    size = "small",
    srcs = ["dumps_test.py"],
    data = glob(["testdata/*"]) + ["@xnu_base//:tools/lldbmacros/kcdata.py"],
    env = {"KCDATA": "$(rootpath @xnu_base//:tools/lldbmacros/kcdata.py)"},
    deps = [":lib"],
)
