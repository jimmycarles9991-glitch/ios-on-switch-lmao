# Inputs the build cannot regenerate, checked in with their sha256 (SHA256SUMS: `shasum -a 256` lines). @pinned
# (bazel/host/files.bzl pinned_files) copies each in through Bazel's own sha256 check and fails on a mismatch or on a
# file SHA256SUMS does not list; `bazel test //bazel/pinned:sha256` builds it.
#
#   kernel/*/original-bindings.S, kernel/*/*ABI.h
#       Absolute-address tables into the 21H461 kernelcache and ABI headers, written by the kernel tree's audit scripts
#       (build-switch-root-block.py, build-native-hid-input.py, all retired) from QEMU-boot interface audits that cannot
#       run in a sandbox.
#   kernel/verified-root-switch/trusted-key.S
#       The owner verification key (openssl, never regenerated).
#   data-seed/data-v10.dbr
#       NativeRamBlock's packed 1 GiB Data seed (DBRDISK1). Contains Apple-derived /private/var content from the
#       21H461 OS volume: check the licence before publishing the repository.
#   prelink/dma-kernel.json.xz, prelink/dma-prelink.json
#       The V20 prelink report the SMP prelink inherits (its parent pass no longer exists) and its roots.
#   firmware/bl31.bin, bl33.bin, oled-sku3.dtb
#       switchroot's ATF and U-Boot (Ubuntu Noble 5.1.2 entry; U-Boot 2024.NX02 @ 722e2b86) and the OLED device tree
#       (nx-plat.dtimg entry 3), as the boot entry chains them.
#   firmware/exporter.uimg
#       The RAM metadata exporter (bazel run //boot:firmware_export rebuilds it).
#   firmware/BCM4356A3.hcd
#       The Bluetooth controller's patch RAM (gitlab.com/switchroot/android/nx-firmware).
#   hw_test_app/media/*
#       The hardware test app's clips and images (debug images only), from `bazel run //hw_test_app:media_tool`: the
#       Mac's hardware encoder spreads 4K frames over however many engines are free, so they cannot be remade
#       byte for byte, and pinning them keeps every build off the encoders.
#   overlay/wallpaper-1x/<kind>/*.plist
#       Each IPSW kind's own iPad's iPadOS 17 and Lake bundles' Wallpaper.plist at the 'any' screen class, so
#       WallpaperKit loads them (bazel run //tools/package:wallpaper_1x remakes them from the OS volume; metadata only,
#       no artwork).

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

# Everything below this package is a pinned input, checked against SHA256SUMS byte for byte: never reformatted.
lint_files(exclude = ["*/**/*"])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

build_test(
    name = "sha256",
    targets = ["@pinned//:all"],
)
