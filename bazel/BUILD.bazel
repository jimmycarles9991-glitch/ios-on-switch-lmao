load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("//bazel/lint:defs.bzl", "lint_files")
load(":profile_test.bzl", "profile_tests")

package(default_visibility = ["//visibility:public"])

lint_files()

# The build profile, one setting for the whole graph (--config=debug / --config=release in .bazelrc set it):
#   debug    (default) the fastest incremental builds: no LTO, asserts on, symbols, XNU DEVELOPMENT
#   release  full optimisation: fat LTO everywhere, NDEBUG, XNU RELEASE, stripped
# Every stream maps it onto its own flags with select() on :debug / :release (never by reading .bazelrc).
string_flag(
    name = "profile",
    build_setting_default = "debug",
    # Target configuration only: exec tools (compilers, generators, test runners) never differ by profile, so switching
    # profiles reuses every exec action.
    scope = "target",
    values = [
        "debug",
        "release",
    ],
)

config_setting(
    name = "debug",
    flag_values = {":profile": "debug"},
)

config_setting(
    name = "release",
    flag_values = {":profile": "release"},
)

# --//bazel:diagnostics=false compiles our debug-only code out (SWITCH_DEBUG=0 in user space, no DEVELOPMENT in kernel
# drivers) and changes nothing else: the profile's optimisation and XNU's DEVELOPMENT recipes and SDK stay. A compile
# check of the release shape of our code, not a build to run: no kernel archive takes such drivers (kernel/rules).
bool_flag(
    name = "diagnostics",
    build_setting_default = True,
    scope = "target",
)

config_setting(
    name = "diagnostics_off",
    flag_values = {":diagnostics": "false"},
)

# Whether SwitchHWTest (apps/hwtest) and its texture peer are staged into //boot:package:
#   auto   (default) included in debug builds, omitted in release builds
#   true   included in either profile (--config=hwtest in .bazelrc)
#   false  omitted in either profile
string_flag(
    name = "hwtest",
    build_setting_default = "auto",
    scope = "target",
    values = [
        "auto",
        "true",
        "false",
    ],
)

config_setting(
    name = "hwtest_force_on",
    flag_values = {":hwtest": "true"},
)

config_setting(
    name = "hwtest_auto_debug",
    flag_values = {
        ":hwtest": "auto",
        ":profile": "debug",
    },
)

selects.config_setting_group(
    name = "hwtest_on",
    match_any = [
        ":hwtest_force_on",
        ":hwtest_auto_debug",
    ],
)

# Opt-in periodic telemetry and profiling categories: OFF by default in both debug and release so default debug builds
# match release performance. All require debug profile + diagnostics=true (forced off in release).
[
    (
        bool_flag(
            name = flag,
            build_setting_default = False,
            scope = "target",
        ),
        config_setting(
            name = flag + "_on",
            flag_values = {
                ":profile": "debug",
                ":diagnostics": "true",
                ":" + flag: "true",
            },
        ),
    )
    for flag in [
        "stats_sched",
        "stats_power",
        "stats_frame",
        "stats_gpu",
        "prof_gpu",
        "stats_io",
    ]
]

profile_tests(
    name = "profile_test",
    objcxx_source = "//drivers/TegraGM20BMetal:TegraGM20BMetalPlugin.mm",
    source = "//drivers/SwitchBluetooth:BlueTool/BlueTool.c",
)
