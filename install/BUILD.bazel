# Installing iPadOS onto the Switch SD card (README.md "Install").
#
#   bazel run //:image                                  out/sd's IOS17.SII.* (--config=ios27: IOS27.SII.*), image.py
#   bazel run //:image_dry_run                          the plan, without the IPSW's large members
#   bazel run //:image_to_card -- disk4 [--yes]         out/sd's images onto the card (tools/install/to_card.py)
#   bazel build //install:artifacts                     what the install writes, described (no device)
#   bazel run //install:sd -- disk4 [--yes]             write a card in the Mac directly (tools/install/sd.py)
#
# The boot package comes from --//deploy:boot_package (default //:boot); the IPSW members from @ipsw (fetched by
# range request into the repository cache; on APFS the copies Bazel makes from the cache are clones, so a member's
# bytes are stored once).
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("//bazel/lint:defs.bzl", "lint_files")
load("//boot:overlay.bzl", "OVERLAY_BINARIES")
load(":defs.bzl", "fake_boot_package", "image_inputs", "install_artifacts", "install_spec", "ipsw_pins", "prelink_options", "release_prelink", "release_tree", "test_member")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(["testdata/**"]))

install_spec(
    name = "spec",
    block_cpp = "//drivers/NativeSwitchBlock:NativeSwitchBlock.cpp",
    cryptex_cpp = "//drivers/NativeSwitchBlock:SwitchCryptex.cpp",
    cryptex_h = "//drivers/NativeSwitchBlock:SwitchCryptex.h",
    raw_mount = "//diagnostics/switch:SwitchRawMount.h",
)

ipsw_pins(name = "ipsw")

install_artifacts(
    name = "artifacts",
    boot_package = "//deploy:boot_package",
    ipsw = ":ipsw",
    spec = ":spec",
)

# What the installer stages into Preboot and checks it against. Only tests change these (a small stand-in for the
# 3.3 GB system cryptex: --//install:system_cryptex=//install:test_system_cryptex
# --//install:ipsw_pins=//install:test_ipsw_pins).
label_flag(
    name = "system_cryptex",
    build_setting_default = "@ipsw//:system_cryptex",
    tags = ["manual"],
)

label_flag(
    name = "ipsw_pins",
    build_setting_default = ":ipsw",
)

py_binary(
    name = "sd",
    srcs = ["//tools/install:sd.py"],
    args = [
        "--spec=$(rlocationpath :spec)",
        "--ipsw=$(rlocationpath :ipsw_pins)",
        "--os-dmg=$(rlocationpath @ipsw//:os)",
        "--system-cryptex=$(rlocationpath :system_cryptex)",
        "--app-cryptex=$(rlocationpath @ipsw//:app_cryptex)",
        "--boot-package=$(rlocationpath //deploy:boot_package)",
    ],
    data = [
        ":ipsw_pins",
        ":spec",
        ":system_cryptex",
        "//deploy:boot_package",
        "@ipsw//:app_cryptex",
        "@ipsw//:os",
    ],
    main = "//tools/install:sd.py",
    # Not part of `bazel build //...`: building it fetches the 5.2 GB OS image and inflates the 3.3 GB system cryptex.
    # `bazel run //install:sd` builds it on demand.
    tags = ["manual"],
    deps = [
        "//tools/install:lib",
        "@rules_python//python/runfiles",
    ],
)

# A boot package with dummy contents and the real layout (--//deploy:boot_package=//install:fake_boot_package), and a
# second generation of it (two files differ) for the rerun test.
fake_boot_package(name = "fake_boot_package")

fake_boot_package(
    name = "fake_boot_package_gen1",
    generation = 1,
)

fake_boot_package(
    name = "fake_gpu_bundle",
    gpu = True,
)

test_member(
    name = "test_system_cryptex",
    mib = 4,
    pins = ":ipsw",
    role = "system_cryptex",
)

filegroup(
    name = "test_ipsw_pins",
    srcs = [":test_system_cryptex"],
    output_group = "pins",
)

# Where //:image takes this project's own prebuilt parts from: this checkout's build (local, which needs Xcode), or
# the GitHub release of MODULE.bazel's version (release, @switch_release: install/release.bzl).
string_flag(
    name = "prebuilt",
    build_setting_default = "local",
    # Tools too: under release, nothing resolves a C/C++ toolchain (bazel/toolchains/none).
    scope = "universal",
    values = [
        "local",
        "release",
    ],
)

config_setting(
    name = "from_release",
    flag_values = {":prebuilt": "release"},
)

config_setting(
    name = "from_local",
    flag_values = {":prebuilt": "local"},
)

# The kernel //boot:package takes from the release: its linked kernel, with Apple's kexts prelinked here from this Mac's
# kernelcache by the options it carries (prelink.json), as //kernel:kernel prelinks them. The release's is iOS 17's.
release_prelink(
    name = "release_kernel_10063",
    inherit_report = "//kernel:dma_prelink_report",
    kernel = "@switch_release//:kernel",
    options = "@switch_release//:prelink_options",
    previous = "//bazel/pinned:prelink/dma-prelink.json",
    tags = ["manual"],
)

alias(
    name = "release_kernel",
    actual = select(
        {"//kernel:xnu_10063_141_1": ":release_kernel_10063"},
        no_match_error = "the release carries iOS 17's kernel only: build this iOS's with --//install:prebuilt=local",
    ),
    tags = ["manual"],
)

alias(
    name = "image_gpu_base",
    actual = select({
        ":from_release": "@switch_release//:gpu_base",
        "//conditions:default": "//gpu:base",
    }),
)

alias(
    name = "image_apfs_tool",
    actual = select({
        ":from_release": "@switch_release//:apfs_tool",
        "//conditions:default": "//boot/installer:apfs_tool",
    }),
)

alias(
    name = "image_install_payload",
    actual = select({
        ":from_release": "@switch_release//:install_payload",
        "//conditions:default": "//boot/installer:install-ios.bin",
    }),
)

# iOS 27: {file name: sha256} of the pretranslate run the boot package carries (trust modules, the cache list); the
# composer refuses a run that differs. The selected kind's pins (ipsw/pins.bzl derived), none for a kind without.
label_flag(
    name = "pretranslated_pins",
    build_setting_default = "//ipsw:pretranslated_pins",
)

label_flag(
    name = "shader_seed",
    build_setting_default = "//gpu/seed:tree",
    tags = ["manual"],
)

label_flag(
    name = "shader_seed_size",
    build_setting_default = "//gpu/seed:tree_size",
    tags = ["manual"],
)

label_flag(
    name = "shader_tools",
    build_setting_default = "//gpu/seed:local_tools",
)

filegroup(
    name = "none",
    srcs = [],
)

image_inputs(
    name = "image_inputs",
    inputs = {
        "apfs_tool": ":image_apfs_tool",
        "boot_package": "//deploy:boot_package",
        "gpu_base": ":image_gpu_base",
        "gpu_stager": "//drivers/TegraGM20BMetal:stage-tegra-gm20b-metal.py",
        "install_payload": ":image_install_payload",
        "ipsw": ":ipsw_pins",
        "spec": ":spec",
    },
)

# The IPSW's large members, and the shader seed made from them: building these fetches the 5.2 GB OS image and
# inflates the 3.3 GB system cryptex.
image_inputs(
    name = "image_ipsw",
    inputs = {
        "app_cryptex": "@ipsw//:app_cryptex",
        "os_dmg": "@ipsw//:os",
        "pretranslated_pins": ":pretranslated_pins",
        "shader_seed": ":shader_seed",
        "shader_seed_size": ":shader_seed_size",
        "system_cryptex": ":system_cryptex",
    },
    pretranslated = select({
        "//ipsw:ios27": [
            "//translate/arm64e/pretranslate:os",
            "//translate/arm64e/pretranslate:app_cryptex",
            "//translate/arm64e/pretranslate:system_cryptex",
        ],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

py_binary(
    name = "image",
    srcs = ["//tools/install:image.py"],
    args = [
        "--inputs=$(rlocationpath :image_inputs)",
        "--inputs=$(rlocationpath :image_ipsw)",
    ],
    data = [
        ":image_inputs",
        ":image_ipsw",
    ],
    main = "//tools/install:image.py",
    tags = ["manual"],
    deps = [
        "//tools/install:lib",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "image_dry_run",
    srcs = ["//tools/install:image.py"],
    args = [
        "--inputs=$(rlocationpath :image_inputs)",
        "--dry-run",
    ],
    data = [":image_inputs"],
    main = "//tools/install:image.py",
    deps = [
        "//tools/install:lib",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "image_boot",
    srcs = ["//tools/install:image.py"],
    args = [
        "--inputs=$(rlocationpath :image_inputs)",
        "--boot-only",
    ],
    data = [":image_inputs"],
    main = "//tools/install:image.py",
    deps = [
        "//tools/install:lib",
        "@rules_python//python/runfiles",
    ],
)

# `bazel run //:image_to_card -- diskN [--yes]`: out/sd's images onto the card (tools/install/to_card.py).
py_binary(
    name = "image_to_card",
    srcs = ["//tools/install:to_card.py"],
    main = "//tools/install:to_card.py",
    deps = ["//tools/install:lib"],
)

# The release's image-builder inputs (ios-on-switch-lmao-<version>-image-inputs.tar, r22-ci): this project's built
# parts the Mac composes with the IPSW, none of them made from it but the loader and its window constants (no Apple
# bytes; release/ipsw_free.bzl DECLASSIFIED).
prelink_options(
    name = "kernel_inputs",
    kernel = "//kernel:kernel_unprelinked",
    tags = ["manual"],
)

release_tree(
    name = "release_inputs",
    files = {
        ":kernel_inputs": "kernel",
        "//gpu:base": "gpu",
        "//boot:loader": "loader/loader.uboot.bin",
        "//boot:loader_constants": "loader/constants.json",
    } | {target: "overlay/" + source for target, source in OVERLAY_BINARIES.items()},
    tags = ["manual"],
)

# The release's host tools (ios-on-switch-lmao-<version>-host-tools-darwin-arm64.tar): lz4 for the kernel window and
# the shader compiler (shader/).
release_tree(
    name = "host_tools",
    files = {
        ":shader_tools": "shader",
        "//boot/installer:apfs_tool": "apfs_tool",
        "//tools:lz4": "lz4",
    },
    tags = ["manual"],
)
