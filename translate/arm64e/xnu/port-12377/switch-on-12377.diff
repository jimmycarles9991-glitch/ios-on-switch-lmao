+	0x91010129, /* add  x9, x9, #0x40 */
+	0xf1000442, /* subs x2, x2, #1 */
+	0x54000081, /* b.ne +0x10 */
+	0xb4000103, /* cbz  x3, +0x20 */
+	0xd5033b9f, /* dsb  ish */
+	0xd2800282, /* mov  x2, #0x14 */
+	0xb100054a, /* adds x10, x10, #1 */
+	0x54ffff01, /* b.ne -0x20 (the ic ivau) */
