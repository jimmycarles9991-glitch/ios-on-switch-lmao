+static bool
+switch_idle_board(void)
+{
+	DTEntry entry;
+	const void *property = NULL;
+	unsigned int size = 0;
+	static const char model[] = "NintendoSwitchOLED";
+	static const char compatible[] = "nintendo,aula";
+	if (SecureDTLookupEntry(NULL, "/", &entry) != kSuccess) {
+		return false;
