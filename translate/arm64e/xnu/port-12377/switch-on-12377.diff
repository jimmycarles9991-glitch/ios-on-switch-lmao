+		/* Leave the faulting line to the single-instruction path, which reports it where the loop stands. */
+		return false;
+	}
+	switch_ucm_note(&switch_ucm_noted_loop, "sys_icache_invalidate completed with DC CVAU (lines)", state, lines);
