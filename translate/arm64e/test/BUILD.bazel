# translate/arm64e on this Mac. The semantic tests run each replaced instruction natively next to its stub, so they
# need Apple silicon (LSE, FP16, FCMA, JSCVT, RDM).
#
#   classify_test    the classifier, the one-word rewrites and the fast-reject table on known encodings
#   semantics_test   LSE, LDRA and FP stubs against the instructions, from the same random states
#   macho_test       the loader's translation of small synthetic Mach-Os, verification, chained fixups
#   pretranslate_test   offline translation of small signed Mach-Os: stub placement, marker, re-signing, fallbacks
#   run_translated_test an A12-built program translated offline and run next to the original (needs Apple silicon)
#   kernel_kind_test the kernel header's loader decision against the host mirror (a64x_image_kind vs a64x_kind_of)
#   vlive_test       (manual) V-register liveness claims re-run against this Mac's own dyld cache
#   fma16_test       (manual) every half-precision FMA product, scalar and vector, against the hardware
#
#   bazel test //translate/arm64e/test:all
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

host_library(
    name = "a64x",
    srcs = [
        "//translate/arm64e:a64x/a64x_classify.c",
        "//translate/arm64e:a64x/a64x_fp16.h",
        "//translate/arm64e:a64x/a64x_image.c",
        "//translate/arm64e:a64x/a64x_refs.c",
        "//translate/arm64e:a64x/a64x_rewrite.c",
        "//translate/arm64e:a64x/a64x_vlive.h",
    ],
    hdrs = ["//translate/arm64e:a64x/a64x.h"],
)

host_library(
    name = "macho",
    srcs = [
        "//translate/arm64e:macho/codesign.c",
        "//translate/arm64e:macho/dsc.c",
        "//translate/arm64e:macho/dsc_verify.c",
        "//translate/arm64e:macho/fips.c",
        "//translate/arm64e:macho/macho.c",
        "//translate/arm64e:macho/pretranslate.c",
        "//translate/arm64e:macho/pt_entries.c",
        "//translate/arm64e:macho/pt_verify.c",
        "//translate/arm64e:macho/sha256.c",
        "//translate/arm64e:macho/stub_split.c",
    ],
    hdrs = [
        "//translate/arm64e:macho/codesign.h",
        "//translate/arm64e:macho/dsc.h",
        "//translate/arm64e:macho/fips.h",
        "//translate/arm64e:macho/macho.h",
        "//translate/arm64e:macho/pretranslate.h",
        "//translate/arm64e:macho/sha256.h",
        "//translate/arm64e:macho/stub_split.h",
    ],
    deps = [":a64x"],
)

host_test(
    name = "classify_test",
    srcs = ["classify_test.cpp"],
    deps = [":a64x"],
)

# The harnesses jump into generated code: UBSan's function-type check cannot see a prototype there.
host_test(
    name = "semantics_test",
    srcs = [
        "fp_semantics.c",
        "lse_semantics.c",
        "semantics_test.cpp",
    ],
    copts = ["-fno-sanitize=function"],
    deps = [":a64x"],
)

host_test(
    name = "macho_test",
    srcs = ["macho_test.cpp"],
    deps = [":macho"],
)

host_test(
    name = "fips_test",
    srcs = ["fips_test.cpp"],
    deps = [":macho"],
)

host_test(
    name = "pretranslate_test",
    srcs = ["pretranslate_test.cpp"],
    deps = [":macho"],
)

# Built for an A12 (LSE, LDAPR, FP16) as plain arm64, so this Mac runs it before and after translation.
cc_binary(
    name = "translated_target",
    srcs = ["translated_target.c"],
    copts = [
        "-O2",
        "-mcpu=apple-a12",
    ],
)

host_test(
    name = "run_translated_test",
    srcs = ["run_translated_test.cpp"],
    data = [":translated_target"],
    deps = [":macho"],
)

host_test(
    name = "vlive_test",
    srcs = ["vlive.c"],
    args = ["/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e"],
    copts = ["-fno-sanitize=function"],
    gtest_main = False,
    tags = ["manual"],
    deps = [":a64x"],
)

host_test(
    name = "fma16_test",
    size = "enormous",
    srcs = ["fma16.c"],
    gtest_main = False,
    sanitize = False,
    tags = ["manual"],
)

host_test(
    name = "kernel_kind_test",
    srcs = [
        "kernel_kind_test.c",
        "kernel_kind_test.cpp",
        "//translate/arm64e:xnu/bsd/sys/a64x_xnu.h",
    ],
    deps = [
        ":macho",
        "//bazel/testing:c_check",
    ],
)
