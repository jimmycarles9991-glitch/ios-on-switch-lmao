# Cache maintenance by VA, physically contiguous buffers, and scattered buffers with their page lists (for masters
# behind an SMMU), for DMA masters that do not snoop the CPU caches.
#
#   bazel test //kits/SwitchDMA/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

kernel_headers()

kernel_driver(
    name = "SwitchDMA",
    srcs = [
        "SwitchDMABuffer.cpp",
        "SwitchDMAPages.cpp",
    ],
    hdr_deps = [],
)
