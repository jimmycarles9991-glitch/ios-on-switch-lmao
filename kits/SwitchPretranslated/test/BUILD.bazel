# iOS 27: the same check over the real translated files the pins name (//install:pretranslated_updates, built from the
# os delta), as capture runs it on the card; and the boot package's own /chosen update list through the kernel's parser.
host_test(
    name = "switch_pretranslated_real_updates_test",
    size = "medium",
    srcs = [
        "switch_pretranslated_real_updates_test.cpp",
        "//kits/SwitchPretranslated:switch_pretranslated.h",
        "//kits/SwitchPretranslated:switch_pretranslated_updates.h",
    ],
    data = [
        "//boot:package_adt",
        "//install:pretranslated_updates",
        "//ipsw:pretranslated_os_updates",
    ],
    env = {
        "SWITCH_ADT": "$(rootpath //boot:package_adt)",
        "SWITCH_UPDATES_PINS": "$(rootpath //ipsw:pretranslated_os_updates)",
        "SWITCH_UPDATES_TREE": "$(rootpath //install:pretranslated_updates)",
    },
    target_compatible_with = select({
        "//ipsw:ios27": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
