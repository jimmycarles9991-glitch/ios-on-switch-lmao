# Recycled wired scratch memory for staging a surface's bytes between an engine and the CPU.
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

kernel_headers()

kernel_driver(
    name = "SwitchScratch",
    srcs = ["SwitchScratch.cpp"],
    hdr_deps = [],
)
